local function getCamera()

    Camera =
        Workspace.CurrentCamera

    return Camera
end

startPlayerView = function(player)

    if not player then
        return false
    end

    local character =
        player.Character

    if not character then
        return false
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return false
    end

    local camera =
        getCamera()

    if not camera then
        return false
    end

    if not CameraState.active then

        CameraState.previousCameraType =
            camera.CameraType

        CameraState.previousCameraSubject =
            camera.CameraSubject
    end

    CameraState.active = true

    CameraState.targetPlayer =
        player

    CameraState.targetCharacter =
        character

    CameraState.targetHumanoid =
        humanoid

    CameraState.targetHRP =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    camera.CameraType =
        Enum.CameraType.Custom

    camera.CameraSubject =
        humanoid

    return true
end

stopPlayerView = function()

    local camera =
        getCamera()

    if camera then

        camera.CameraType =
            CameraState.previousCameraType
            or Enum.CameraType.Custom

        if CameraState.previousCameraSubject
            and CameraState.previousCameraSubject.Parent then

            camera.CameraSubject =
                CameraState.previousCameraSubject

        elseif Humanoid
            and Humanoid.Parent then

            camera.CameraSubject =
                Humanoid
        end
    end

    CameraState.active = false

    CameraState.targetPlayer = nil
    CameraState.targetCharacter = nil
    CameraState.targetHumanoid = nil
    CameraState.targetHRP = nil

    CameraState.previousCameraType = nil
    CameraState.previousCameraSubject = nil
end

