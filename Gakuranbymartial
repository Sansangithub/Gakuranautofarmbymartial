local function instantTeleportToPlayer(player)
    if not State.farming
        or not HRP
        or not HRP.Parent then
        return false
    end

    local targetHRP =
        getTargetRoot(player)

    if not targetHRP then
        return false
    end

    setCollision(false)

    for attempt = 1, S.FastTeleportAttempts do

        if not State.farming then
            setCollision(true)
            return false
        end

        targetHRP =
            getTargetRoot(player)

        if not targetHRP then
            setCollision(true)
            return false
        end

        local photoPosition
        local targetPosition

        photoPosition, targetPosition =
            calculatePhotoPosition(
                targetHRP
            )

        if not photoPosition then
            continue
        end

        local destination =
            CFrame.lookAt(
                photoPosition,
                targetPosition
            )

        State.teleportAttempts += 1

        -- DIRECT PIVOT
        pcall(function()
            Character:PivotTo(destination)
        end)

        -- HARD ROOT FALLBACK
        if HRP and HRP.Parent then

            pcall(function()
                HRP.CFrame = destination
            end)

            HRP.AssemblyLinearVelocity =
                Vector3.zero

            HRP.AssemblyAngularVelocity =
                Vector3.zero
        end

        -- NO WAIT
        local actualDistance =
            (
                HRP.Position
                - targetPosition
            ).Magnitude

        if actualDistance <=
            S.PhotoPositionTolerance then

            -- target mungkin bergerak SEJAK posisi
            -- tadi dihitung. Ambil posisi terbaru.
            local newestRoot =
                getTargetRoot(player)

            if newestRoot then

                local newestPosition =
                    newestRoot.Position

                local newestDistance =
                    (
                        HRP.Position
                        - newestPosition
                    ).Magnitude

                if newestDistance >
                    S.PhotoPositionTolerance then

                    -- LANGSUNG REPOSITION
                    local newPhotoPosition =
                        calculatePhotoPosition(
                            newestRoot
                        )

                    if newPhotoPosition then
                        local newCF =
                            CFrame.lookAt(
                                newPhotoPosition,
                                newestPosition
                            )

                        pcall(function()
                            Character:PivotTo(newCF)
                        end)

                        pcall(function()
                            HRP.CFrame = newCF
                        end)

                        HRP.AssemblyLinearVelocity =
                            Vector3.zero

                        HRP.AssemblyAngularVelocity =
                            Vector3.zero
                    end
                end
            end

            setCollision(true)
            return true
        end
    end

    setCollision(true)
    return false
end

--==================================================
-- PHOTO RESULT
--==================================================

local function waitForPhotoResult(previousTask)
    local timeout =
        tonumber(
            S.PhotoConfirmTimeout
        ) or 0.20

    local deadline =
        os.clock() + timeout

    while State.farming
        and os.clock() < deadline do

        local currentTask =
            getTaskText()

        if currentTask
            and currentTask ~= ""
            and currentTask ~= previousTask then

            return true
        end

        task.wait()
    end

    return false
end

--==================================================
-- INSTANT PHOTO
--==================================================

local function takePhotoInstant(
    player,
    previousTask
)
    if not State.farming
        or not player
        or not phoneScreenPush
        or not photoJobSubmit
        or not HRP
        or not HRP.Parent then

        return false
    end

    if not PhotoBuffer then
        PhotoBuffer = createPhotoBuffer()

        if not PhotoBuffer then
            return false
        end
    end

    -- SELALU ambil target TERBARU
    local targetHRP =
        getTargetRoot(player)

    if not targetHRP then
        return false
    end

    local targetPosition =
        targetHRP.Position

    local distance =
        (
            HRP.Position
            - targetPosition
        ).Magnitude

    -- Jika target bergerak sebelum submit,
    -- langsung teleport ulang.
    if distance >
        S.PhotoTargetMaxDistance then

        if not instantTeleportToPlayer(player) then
            return false
        end

        targetHRP =
            getTargetRoot(player)

        if not targetHRP then
            return false
        end

        targetPosition =
            targetHRP.Position
    end

    -- Update arah TERAKHIR
    pcall(function()
        HRP.CFrame =
            CFrame.lookAt(
                HRP.Position,
                targetPosition
            )
    end)

    -- Submit langsung
    State.photoAttempts += 1

    local pushOK =
        pcall(
            phoneScreenPush.FireServer,
            phoneScreenPush,
            PhotoBuffer
        )

    if not pushOK then
        return false
    end

    local submitOK, result =
        pcall(
            photoJobSubmit.InvokeServer,
            photoJobSubmit,
            "Submit",
            HRP.CFrame
        )

    if not submitOK then
        return false
    end

    if result == true then
        return true
    end

    if result ~= false then
        if waitForPhotoResult(
            previousTask
        ) then
            return true
        end
    end

    return waitForPhotoResult(
        previousTask
    )
end

--==================================================
-- PLAYER TASK
--==================================================

local function processPlayerTask(taskText)
    local target =
        findPlayerTarget(taskText)

    if not target then
        return false
    end

    local player =
        target.player

    State.targetUsername =
        player.Name

    -- AUTO ;VIEW hanya command chat.
    if S.AutoViewCommandEnabled then
        sendViewCommand(player.Name)
    end

    if not State.farming then
        return false
    end

    --================================================
    -- FIRST DIRECT TELEPORT
    --================================================

    if not instantTeleportToPlayer(player) then
        return false
    end

    if not State.farming then
        return false
    end

    --================================================
    -- IMMEDIATE PHOTO
    --================================================

    local success =
        takePhotoInstant(
            player,
            taskText
        )

    setCollision(true)
    stopPlayerView()

    if success then

        State.lastTask = ""
        State.processing = false
        State.targetPlayer = ""
        State.targetUsername = ""

        if S.SuccessDelay > 0 then
            task.wait(S.SuccessDelay)
        end

        return true
    end

    return false
end

--==================================================
-- AREA TASK
--==================================================

local function processAreaTask(taskText)
    stopPlayerView()

    local position =
        findLocation(taskText)

    if not position then
        return false
    end

    if not smoothTween(position) then
        return false
    end

    if not State.farming then
        return false
    end

    -- Area photo menggunakan posisi area
    local targetPosition = position

    local distance =
        (HRP.Position - targetPosition).Magnitude

    if distance > S.PhotoTargetMaxDistance then
        return false
    end

    pcall(function()
        HRP.CFrame =
            CFrame.lookAt(
                HRP.Position,
                targetPosition
            )
    end)

    if not PhotoBuffer then
        PhotoBuffer = createPhotoBuffer()
    end

    if not PhotoBuffer then
        return false
    end

    local pushOK =
        pcall(
            phoneScreenPush.FireServer,
            phoneScreenPush,
            PhotoBuffer
        )

    if not pushOK then
        return false
    end

    local submitOK, result =
        pcall(
            photoJobSubmit.InvokeServer,
            photoJobSubmit,
            "Submit",
            HRP.CFrame
        )

    if not submitOK then
        return false
    end

    local success =
        result == true
        or result ~= false
        and waitForPhotoResult(taskText)

    setCollision(true)

    if success then
        State.lastTask = ""

        if S.SuccessDelay > 0 then
            task.wait(S.SuccessDelay)
        end

        return true
    end

    return false
end

--==================================================
-- TASK TYPE
--==================================================

local function isPlayerPhotoTask(taskText)
    local target =
        getPhotoTargetText(taskText)

    if not target then
        return false
    end

    if resolveArea(taskText) then
        return false
    end

    return
        getPlayerByText(target) ~= nil
        or findPlayerByInfo(target) ~= nil
end

--==================================================
-- RESTART
--==================================================

local function restartUntilValidTask()
    if not State.farming
        or State.restarting then
        return false
    end

    State.restarting = true

    stopPlayerView()
    cancelTween()
    setCollision(true)

    for _ = 1, 20 do

        if not State.farming then
            break
        end

        stopCurrentJob()

        task.wait(S.RestartDelay)

        if not State.farming then
            break
        end

        startNewJob()

        local taskText =
            waitForNewAssignment()

        if taskText then

            if isRejectedTask(taskText) then
                State.restartCount += 1
                continue
            end

            if isPlayerPhotoTask(taskText)
                or resolveArea(taskText) then

                State.lastTask = ""
                State.restarting = false

                return true
            end
        end

        State.restartCount += 1
    end

    State.restarting = false

    return false
end

--==================================================
-- PROCESS TASK
--==================================================

local function processTask()
    if not State.farming
        or State.processing
        or State.restarting then
        return
    end

    local taskText =
        getTaskText()

    if not taskText
        or taskText == "" then

        startNewJob()
        return
    end

    local lower =
        taskText:lower()

    if lower:find(
        "waiting for assignment",
        1,
        true
    ) then

        startNewJob()
        return
    end

    if isRejectedTask(taskText) then
        State.stopReason =
            "Music Room -> reroll"

        restartUntilValidTask()
        return
    end

    -- AREA
    if resolveArea(taskText) then

        if State.lastTask == taskText then
            return
        end

        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        local success =
            processAreaTask(taskText)

        State.processing = false

        if not success then

            State.stopReason =
                "Area photo failed"

            State.lastTask = ""

            restartUntilValidTask()
        end

        return
    end

    -- PLAYER
    if isPlayerPhotoTask(taskText) then

        if State.lastTask == taskText then
            return
        end

        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        local success =
            processPlayerTask(taskText)

        State.processing = false

        if not success then

            State.stopReason =
                "Player photo failed"

            State.lastTask = ""

            restartUntilValidTask()
        end

        return
    end

    -- INVALID
    State.stopReason =
        "Invalid task: "
        .. tostring(taskText)

    restartUntilValidTask()
end

--==================================================
-- FARM LOOP
--==================================================

local function farmLoop()
    if farmLoopRunning then
        return
    end

    farmLoopRunning = true

    while State.farming do

        pcall(processTask)

        task.wait(S.RefreshRate)
    end

    setCollision(true)
    stopPlayerView()

    farmLoopRunning = false
end

