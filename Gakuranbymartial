local function getTargetRoot(player)
    if not player
        or not player.Parent then
        return nil
    end

    local character = player.Character

    if not character
        or not character.Parent then
        return nil
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not humanoid
        or humanoid.Health <= 0
        or not root then
        return nil
    end

    return root
end

--==================================================
-- DIRECT PLAYER POSITION
--==================================================

local function calculatePhotoPosition(targetHRP)
    if not targetHRP then
        return nil
    end

    local targetPosition =
        targetHRP.Position

    local look =
        targetHRP.CFrame.LookVector

    local position =
        targetPosition
        - look * S.PlayerPhotoDistance
        + Vector3.new(
            0,
            S.PlayerPhotoHeight,
            0
        )

    return position, targetPosition
end

