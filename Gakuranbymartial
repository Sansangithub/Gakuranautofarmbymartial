local function normalizePlayerName(text)
    if not text then return "" end
    text = tostring(text):match("^%s*(.-)%s*$")
    text = text:gsub("[%,!?:;]+$", "")
    return text
end

local PHOTO_PREFIXES = {
    "get a photo of ",
    "take a photo of ",
    "take photo of ",
    "a photo of ",
    "photo of ",
    "photograph of ",
    "photograph ",
    "get a picture of ",
    "take a picture of ",
    "take picture of ",
    "picture of "
}

local function normalizeText(text)
    if not text then return "" end
    text = tostring(text):lower()

    for _, prefix in ipairs(PHOTO_PREFIXES) do
        if text:sub(1, #prefix) == prefix then
            text = text:sub(#prefix + 1)
            break
        end
    end

    if text:sub(1, 4) == "the " then
        text = text:sub(5)
    end

    return text:match("^%s*(.-)%s*$")
end

