_G.SendViewCommand = function(
    playerName
)
    playerName =
        normalizePlayerName(
            playerName
        )

    if playerName == "" then
        return false
    end

    local command =
        ";view " .. playerName

    local success =
        sendChatMessage(
            command
        )

    if success then
        State.lastViewTarget =
            playerName:lower()

        State.lastViewCommand =
            command
    end

    return success
end

