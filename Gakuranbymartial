local function getTaskText()
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not PlayerGui then return nil end

    local gui = PlayerGui:FindFirstChild("PhotoJobGui")
    if not gui then return nil end

    local card = gui:FindFirstChild("Card")
    if not card then return nil end

    local taskLabel = card:FindFirstChild("Task")
    if not taskLabel then return nil end

    if not taskLabel:IsA("TextLabel") and not taskLabel:IsA("TextButton") then
        return nil
    end

    return taskLabel.Text
end

local function getPhotoTargetText(taskText)
    if not taskText then return nil end
    local original = tostring(taskText)
    local lower = original:lower()

    for _, prefix in ipairs(PHOTO_PREFIXES) do
        if lower:sub(1, #prefix) == prefix then
            local target = normalizePlayerName(original:sub(#prefix + 1))
            if target ~= "" then
                return target
            end
        end
    end

    return nil
end

local function getPlayerByText(targetText)
    if not targetText then return nil end
    local target = normalizePlayerName(targetText)
    local lower = target:lower()
    if lower == "" then return nil end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Name:lower() == lower then
            return player
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.DisplayName:lower() == lower then
            return player
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if player.Name:lower():find(lower, 1, true)
                or player.DisplayName:lower():find(lower, 1, true) then
                return player
            end
        end
    end

    return nil
end

local function findPlayerByInfo(targetText)
    if not targetText then return nil end
    local target = normalizePlayerName(targetText):lower()
    if target == "" then return nil end

    local direct = getPlayerByText(target)
    if direct then return direct end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character then
                for _, desc in ipairs(character:GetDescendants()) do
                    if desc:IsA("TextLabel") and (desc.Name == "Info" or desc.Name:lower():find("name")) then
                        local infoText = tostring(desc.Text or ""):lower()
                        if infoText:find(target, 1, true) then
                            local targetHRP = character:FindFirstChild("HumanoidRootPart")
                            if targetHRP then
                                return player
                            end
                        end
                    end
                end
            end
        end
    end

    return nil
end

local function findPlayerTarget(taskText)
    local requested = getPhotoTargetText(taskText)
    if not requested then return nil end

    State.targetPlayer = requested

    for _ = 1, S.PlayerSearchAttempts do
        if not State.farming then return nil end

        local player = findPlayerByInfo(requested)
        if player then
            local character = player.Character
            if character then
                local targetHRP = character:FindFirstChild("HumanoidRootPart")
                if targetHRP then
                    State.targetUsername = player.Name
                    return {
                        player = player,
                        character = character,
                        hrp = targetHRP
                    }
                end
            end
        end

        task.wait(S.PlayerSearchDelay)
    end

    return nil
end

--==================================================
-- AREA RESOLUTION & LOCATION SEARCH (CACHED)
--==================================================

local function resolveArea(taskText)
    local normalized = normalizeText(taskText)
    if normalized == "" then return nil end

    for _, entry in ipairs(AREA_TASKS) do
        local canonical = entry.canonical:lower()
        if normalized == canonical or normalized:find(canonical, 1, true) then
            return entry.canonical
        end

        for _, alias in ipairs(entry.aliases) do
            alias = alias:lower()
            if normalized == alias or normalized:find(alias, 1, true) then
                return entry.canonical
            end
        end
    end

    return nil
end

local function getObjectPosition(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object.Position
    end

    if object:IsA("Attachment") then
        return object.WorldPosition
    end

    if object:IsA("Model") then
        local primary = object.PrimaryPart
        if primary and primary:IsA("BasePart") then
            return primary.Position
        end

        local okPivot, pivot = pcall(function()
            return object:GetPivot()
        end)

        if okPivot and pivot then
            return pivot.Position
        end
    end

    return nil
end

local function getLandmarkValue(object)
    if not object then return nil end
    local landmark = object:FindFirstChild("PhotoJobLandmark", true)
    if landmark and landmark:IsA("StringValue") then
        return tostring(landmark.Value or ""):lower()
    end
    return nil
end

local function findRooftopExactLocation()
    local exact = nil
    local bestScore = -math.huge

    for _, object in ipairs(Workspace:GetDescendants()) do
        local objectName = tostring(object.Name):lower()
        local landmark = getLandmarkValue(object)
        local position = getObjectPosition(object)

        if position then
            local score = -math.huge

            if objectName == "rooftop" then
                score = 100000
            elseif objectName == "roof" then
                score = 90000
            elseif objectName:find("rooftop", 1, true) then
                score = 80000 + #objectName
            elseif objectName:find("roof", 1, true) then
                score = 70000 + #objectName
            end

            if landmark then
                if landmark == "rooftop" then
                    score = math.max(score, 120000)
                elseif landmark == "roof" then
                    score = math.max(score, 110000)
                elseif landmark:find("rooftop", 1, true) then
                    score = math.max(score, 100000 + #landmark)
                end
            end

            if object:IsA("BasePart") or object:IsA("Attachment") then
                score += 5000
            elseif object:IsA("Model") then
                score += 1000
            end

            if score > bestScore then
                bestScore = score
                exact = position
            end
        end
    end

    return exact
end

local function findLocation(taskText, forceRefresh)
    local area = resolveArea(taskText)
    if not area then return nil end

    if not forceRefresh and LocationCache[area] then
        return LocationCache[area]
    end

    if area == "Rooftop" then
        local rooftopPosition = findRooftopExactLocation()
        if rooftopPosition then
            LocationCache[area] = rooftopPosition
            return rooftopPosition
        end
    end

    local terms = { area:lower() }

    for _, entry in ipairs(AREA_TASKS) do
        if entry.canonical == area then
            for _, alias in ipairs(entry.aliases) do
                table.insert(terms, tostring(alias):lower())
            end
        end
    end

    if area == "Music Room" then
        terms = { "music room", "musicroom", "music_room" }
    end

    local uniqueTerms = {}
    local seenTerms = {}

    for _, term in ipairs(terms) do
        term = tostring(term):lower()
        if term ~= "" and not seenTerms[term] then
            seenTerms[term] = true
            table.insert(uniqueTerms, term)
        end
    end

    terms = uniqueTerms

    local exactCandidate = nil
    local exactScore = -math.huge
    local bestPosition = nil
    local bestScore = -math.huge

    for _, object in ipairs(Workspace:GetDescendants()) do
        local objectName = tostring(object.Name):lower()
        local position = getObjectPosition(object)

        if position then
            local landmarkValue = getLandmarkValue(object)

            for _, term in ipairs(terms) do
                if objectName == term then
                    local score = 10000 + #term
                    if area == "Music Room" then score += 5000 end
                    if score > exactScore then
                        exactScore = score
                        exactCandidate = position
                    end
                elseif objectName:find(term, 1, true) then
                    local score = #term
                    if area == "Music Room" and objectName:find("music room", 1, true) then
                        score += 5000
                    end
                    if score > bestScore then
                        bestScore = score
                        bestPosition = position
                    end
                end

                if landmarkValue then
                    if landmarkValue == term then
                        local score = 20000 + #term
                        if area == "Music Room" then score += 5000 end
                        if score > exactScore then
                            exactScore = score
                            exactCandidate = position
                        end
                    elseif landmarkValue:find(term, 1, true) then
                        local score = 1000 + #term
                        if area == "Music Room" and landmarkValue:find("music room", 1, true) then
                            score += 5000
                        end
                        if score > bestScore then
                            bestScore = score
                            bestPosition = position
                        end
                    end
                end
            end
        end
    end

    local finalPos = exactCandidate or bestPosition
    if finalPos then
        LocationCache[area] = finalPos
    end

    return finalPos
end

--==================================================
-- JOB & SESSION CONTROL
--==================================================

local function stopCurrentJob()
    if not photoJobSubmit then return false end
    return pcall(function()
        photoJobSubmit:InvokeServer("Stop")
    end)
end

local function startNewJob(ignoreCooldown)
    if not State.farming or not photoJobSubmit then return false end

    local now = os.clock()
    if not ignoreCooldown and (now - State.lastStartRequest < S.StartCooldown) then
        return false
    end

    State.lastStartRequest = now
    return pcall(function()
        photoJobSubmit:InvokeServer("Start")
    end)
end

local function isCurrentSession(sessionId)
    return State.farming and State.sessionId == sessionId
end

local function forceStartNewJob(sessionId)
    if not isCurrentSession(sessionId) then return false end

    State.lastStartRequest = 0
    stopCurrentJob()

    if not isCurrentSession(sessionId) then return false end
    task.wait(0.02)
    if not isCurrentSession(sessionId) then return false end

    return startNewJob(true)
end

local function waitForNewAssignment(previousTask)
    local deadline = os.clock() + 1.5
    while State.farming and os.clock() < deadline do
        local text = getTaskText()
        if text and text ~= "" then
            local lower = text:lower()
            if not lower:find("waiting for assignment", 1, true) then
                if not previousTask or text ~= previousTask then
                    return text
                end
            end
        end
        task.wait(S.AssignmentWait)
    end
    return getTaskText()
end

local function restartJob(sessionId, failedTask)
    if not isCurrentSession(sessionId) or State.restarting then
        return false
    end

    State.restarting = true
    State.processing = false
    State.lastTask = ""
    setAnchored(false)
    stopPlayerView()
    zeroVelocity()

    stopCurrentJob()
    task.wait(S.RestartDelay)

    if not isCurrentSession(sessionId) then
        State.restarting = false
        return false
    end

    local started = startNewJob(true)
    if not started then
        State.restarting = false
        return false
    end

    waitForNewAssignment(failedTask)
    State.currentPhotoFailure = 0
    State.restarting = false
    return true
end

local function waitForPhotoResult(previousTask)
    local timeout = math.max(0.05, tonumber(S.PhotoConfirmTimeout) or 0.18)
    local deadline = os.clock() + timeout

    while State.farming and os.clock() < deadline do
        local currentTask = getTaskText()
        if not currentTask or currentTask == "" or currentTask ~= previousTask then
            return true
        end
        if currentTask:lower():find("waiting for assignment", 1, true) then
            return true
        end
        task.wait(0.01)
    end

    return false
end

