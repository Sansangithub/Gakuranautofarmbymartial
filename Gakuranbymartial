        "photograph of ",
        "photograph ",
        "get a picture of ",
        "take a picture of ",
        "take picture of ",
        "picture of ",
    }

    for _, prefix in ipairs(prefixes) do

        if text:sub(
            1,
            #prefix
        ) == prefix then

            text =
                text:sub(
                    #prefix + 1
                )

            break
        end
    end

    if text:sub(
        1,
        4
    ) == "the " then

        text =
            text:sub(5)
    end

    text =
        text:match(
            "^%s*(.-)%s*$"
        )

    return text
end

--==================================================
-- NORMALIZE PLAYER NAME
--==================================================

local function normalizePlayerName(text)

    if not text then
        return ""
    end

    text = tostring(text)

    text =
        text:match(
            "^%s*(.-)%s*$"
        )

    text =
        text:gsub(
            "[%.,!?:;]+$",
            ""
        )

    return text
end

