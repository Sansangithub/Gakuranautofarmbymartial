--==================================================
-- PHOTO TARGET
--==================================================

local PHOTO_PREFIXES = {

    "get a photo of ",
    "take a photo of ",
    "take photo of ",
    "a photo of ",
    "photo of ",
    "photograph of ",
    "photograph ",
    "get a picture of ",
    "take a picture of ",
    "take picture of ",
    "picture of "
}

local function getPhotoTargetText(taskText)

    if not taskText then
        return nil
    end

    local original =
        tostring(taskText)

    local lower =
        original:lower()

    for _, prefix in ipairs(
        PHOTO_PREFIXES
    ) do

        if lower:sub(
            1,
            #prefix
        ) == prefix then

            local target =
                original:sub(
                    #prefix + 1
                )

            target =
                normalizePlayerName(
                    target
                )

            if target ~= "" then
                return target
            end
        end
    end

    return nil
end

--==================================================
-- PLAYER LOOKUP
--==================================================

local function getPlayerByText(targetText)

    if not targetText then
        return nil
    end

    local target =
        normalizePlayerName(
            targetText
        )

    local lower =
        target:lower()

    if lower == "" then
        return nil
    end

    -- EXACT USERNAME
    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
            and player.Name:lower() ==
                lower then

            return player
        end
    end

    -- EXACT DISPLAY NAME
    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
            and player.DisplayName:lower() ==
                lower then

            return player
        end
    end

    -- PARTIAL
    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            if player.Name:lower():find(
                lower,
                1,
                true
            )
            or player.DisplayName:lower():find(
                lower,
                1,
                true
            ) then

                return player
            end
        end
    end

    return nil
end

--==================================================
-- PLAYER INFO
--==================================================

local function findPlayerByInfo(targetText)

    if not targetText then
        return nil
    end

    local target =
        normalizePlayerName(
            targetText
        ):lower()

    if target == "" then
        return nil
    end

    local direct =
        getPlayerByText(target)

    if direct then
        return direct
    end

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            local character =
                player.Character

            if character then

                local info =
                    character:FindFirstChild(
                        "Info",
                        true
                    )

                if info
                    and info:IsA("TextLabel") then

                    local infoText =
                        tostring(
                            info.Text or ""
                        ):lower()

                    if infoText:find(
                        target,
                        1,
                        true
                    ) then

                        local targetHRP =
                            character:FindFirstChild(
                                "HumanoidRootPart"
                            )

                        if targetHRP then
                            return player
                        end
                    end
                end
            end
        end
    end

    return nil
end

--==================================================
-- FIND PLAYER TARGET
--==================================================

local function findPlayerTarget(taskText)

    local requested =
        getPhotoTargetText(
            taskText
        )

    if not requested then
        return nil
    end

    State.targetPlayer =
        requested

    for _ = 1,
        S.PlayerSearchAttempts do

        if not State.farming then
            return nil
        end

        local player =
            findPlayerByInfo(
                requested
            )

        if player then

            local character =
                player.Character

            if character then

                local targetHRP =
                    character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if targetHRP then

                    State.targetUsername =
                        player.Name

                    return {
                        player = player,
                        character = character,
                        hrp = targetHRP
                    }
                end
            end
        end

        task.wait(
            S.PlayerSearchDelay
        )
    end

    return nil
end

--==================================================
-- AREA RESOLVE
--==================================================

local function resolveArea(taskText)

    local normalized =
        normalizeText(
            taskText
        )

    if normalized == "" then
        return nil
    end

    for _, entry in ipairs(
        AREA_TASKS
    ) do

        local canonical =
            entry.canonical:lower()

        if normalized == canonical
            or normalized:find(
                canonical,
                1,
                true
            ) then

            return entry.canonical
        end

        for _, alias in ipairs(
            entry.aliases
        ) do

            alias =
                alias:lower()

            if normalized == alias
                or normalized:find(
                    alias,
                    1,
                    true
                ) then

                return entry.canonical
            end
        end
    end

    return nil
end

