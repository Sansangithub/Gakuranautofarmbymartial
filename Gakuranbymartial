--==================================================
-- SET FLY
--==================================================

_G.SetFly = function(enabled)

    S.FlyEnabled =
        enabled == true

    if S.FlyEnabled
        and State.farming then

        startFly()

    else

        stopFly()
    end

    updateGUI()
end

--==================================================
-- GET FLY
--==================================================

_G.GetFly = function()

    return State.flyEnabled
end

--==================================================
-- SET SPECTATE
--==================================================

_G.SetSpectate = function(enabled)

    S.SpectateEnabled =
        enabled == true

    if not S.SpectateEnabled then

        stopSpectate()

    elseif State.farming
        and State.targetUsername ~= "" then

        local player =
            getPlayerByText(
                State.targetUsername
            )

        if player then
            startSpectate(player)
        end
    end

    updateGUI()
end

--==================================================
-- START SPECTATE MANUAL
--==================================================

_G.StartSpectate = function(player)

    if typeof(player) == "string" then

        player =
            getPlayerByText(player)
    end

    if player then
        return startSpectate(player)
    end

    return false
end

