local PhotoBuffer

local function createPhotoBuffer()
    local ok, result = pcall(function()
        local data = buffer.create(7)
        buffer.writeu8(data, 0, 1)
        buffer.writeu8(data, 1, 4)
        buffer.writeu8(data, 2, 0)
        buffer.writeu8(data, 3, 1)
        buffer.writeu8(data, 4, 1)
        buffer.writeu8(data, 5, 42)
        buffer.writeu8(data, 6, 24)
        return data
    end)

    if ok then return result end
    return nil
end

PhotoBuffer = createPhotoBuffer()

-- Variasi offset sudut kamera agar raycast / validasi server selalu tembus
local CAMERA_OFFSETS = {
    Vector3.new(0, 1.5, 0),
    Vector3.new(0, 2.5, -2.5),
    Vector3.new(0, 2.5, 2.5),
    Vector3.new(-2.5, 2.0, 0),
    Vector3.new(2.5, 2.0, 0),
    Vector3.new(0, 4.0, -3.5),
    Vector3.new(0, 0.5, -1.5),
    Vector3.new(0, 3.0, 0),
}

local function takePhoto(targetObjectOrPos, previousTask, isPlayerTarget)
    if not State.farming or not phoneScreenPush or not photoJobSubmit then
        return false
    end

    if not HRP or not HRP.Parent then
        return false
    end

    if not PhotoBuffer then
        PhotoBuffer = createPhotoBuffer()
        if not PhotoBuffer then return false end
    end

    -- Kunci posisi karakter sementara agar tidak jatuh saat submit
    zeroVelocity()
    setAnchored(true)

    local captured = false

    for attempt = 1, S.PhotoRetryCount do
        if not State.farming or not HRP or not HRP.Parent then
            break
        end

        State.photoAttempts += 1

        -- Dapatkan posisi terbaru jika target adalah player yang bergerak
        local targetPos
        if isPlayerTarget and typeof(targetObjectOrPos) == "Instance" then
            if targetObjectOrPos.Parent then
                targetPos = targetObjectOrPos.Position
            else
                break
            end
        elseif typeof(targetObjectOrPos) == "Vector3" then
            targetPos = targetObjectOrPos
        else
            targetPos = HRP.Position + HRP.CFrame.LookVector * 8
        end

        local offset = CAMERA_OFFSETS[((attempt - 1) % #CAMERA_OFFSETS) + 1]
        local camOrigin = HRP.Position + offset

        -- Jika jarak camOrigin dan targetPos terlalu dekat (seperti pada Area Task), mundurkan origin sedikit
        local dir = targetPos - camOrigin
        if dir.Magnitude < 0.5 then
            camOrigin = targetPos + Vector3.new(0, 2.0, -3.0)
            dir = targetPos - camOrigin
        end

        local photoCFrame = CFrame.lookAt(camOrigin, targetPos)

        -- Sinkronisasi rotasi karakter dan kamera lokal untuk memastikan validasi client/server lolos
        pcall(function()
            local flatTarget = Vector3.new(targetPos.X, HRP.Position.Y, targetPos.Z)
            if (flatTarget - HRP.Position).Magnitude > 0.1 then
                HRP.CFrame = CFrame.lookAt(HRP.Position, flatTarget)
            end
            if Camera then
                Camera.CFrame = photoCFrame
            end
        end)

        pcall(phoneScreenPush.FireServer, phoneScreenPush, PhotoBuffer)

        local invokeOK, serverResult = pcall(
            photoJobSubmit.InvokeServer,
            photoJobSubmit,
            "Submit",
            photoCFrame
        )

        if invokeOK then
            if serverResult == true then
                captured = true
                break
            elseif serverResult ~= false then
                if waitForPhotoResult(previousTask) then
                    captured = true
                    break
                end
            else
                -- Bahkan jika serverResult == false, cek apakah task di GUI sudah berganti
                local currentTask = getTaskText()
                if currentTask and currentTask ~= previousTask then
                    captured = true
                    break
                end
            end
        end

        if attempt < S.PhotoRetryCount then
            -- Jika target player bergerak menjauh saat retry, kejar posisinya
            if isPlayerTarget and typeof(targetObjectOrPos) == "Instance" and targetObjectOrPos.Parent then
                local dist = (HRP.Position - targetObjectOrPos.Position).Magnitude
                if dist > 8 then
                    setAnchored(false)
                    local backVec = -targetObjectOrPos.CFrame.LookVector * S.PlayerSafeDistance
                    placeCharacterAt(CFrame.lookAt(targetObjectOrPos.Position + backVec + Vector3.new(0, 0.5, 0), targetObjectOrPos.Position))
                    setAnchored(true)
                end
            end
            task.wait(S.PhotoRetryDelay)
        end
    end

    setAnchored(false)
    zeroVelocity()

    return captured
end

--==================================================
-- TELEPORT TO PLAYER & AREA
--==================================================

local function teleportToPlayer(targetPlayer)
    if not State.farming or not HRP or not HRP.Parent then
        return false
    end
    if not targetPlayer or not targetPlayer.Parent then
        return false
    end

    zeroVelocity()

    local safeDistance = math.max(3.0, tonumber(S.PlayerSafeDistance) or 4.0)

    for _ = 1, S.TeleportRetryCount do
        if not State.farming then
            return false
        end

        State.teleportAttempts += 1

        local character = targetPlayer.Character
        local targetHRP = character and character:FindFirstChild("HumanoidRootPart")

        if targetHRP then
            local targetPosition = targetHRP.Position
            local flatLook = Vector3.new(targetHRP.CFrame.LookVector.X, 0, targetHRP.CFrame.LookVector.Z)
            if flatLook.Magnitude < 0.05 then
                flatLook = Vector3.new(0, 0, -1)
            else
                flatLook = flatLook.Unit
            end

            local destination = targetPosition - (flatLook * safeDistance) + Vector3.new(0, 0.5, 0)
            local destinationCFrame = CFrame.lookAt(destination, targetPosition)

            placeCharacterAt(destinationCFrame)

            if HRP and HRP.Parent then
                local destinationDistance = (HRP.Position - destination).Magnitude
                local actualDistance = (HRP.Position - targetPosition).Magnitude

                if destinationDistance <= S.TeleportDistanceTolerance and actualDistance >= 1.5 then
                    placeCharacterAt(CFrame.lookAt(HRP.Position, Vector3.new(targetPosition.X, HRP.Position.Y, targetPosition.Z)))
                    return true
                end
            end
        end

        task.wait(S.TeleportRetryDelay)
    end

    zeroVelocity()
    return false
end

local function teleportToAreaExact(position, customTolerance, customRetries)
    if not State.farming or not position or not Character or not Character.Parent or not HRP or not HRP.Parent then
        return false
    end

    zeroVelocity()

    local attempts = math.max(1, tonumber(customRetries or S.AreaTeleportRetryCount) or 10)
    local tolerance = math.max(0.2, tonumber(customTolerance or S.AreaTeleportTolerance) or 1.5)

    -- Offset Y +1.5 agar karakter berdiri di atas lantai, bukan nyangkut di dalam part
    local safeTargetPosition = position + Vector3.new(0, 1.5, 0)

    for attempt = 1, attempts do
        if not State.farming then
            return false
        end

        State.teleportAttempts += 1

        local targetCFrame = CFrame.new(safeTargetPosition)
        local moved = placeCharacterAt(targetCFrame)

        if moved and HRP and HRP.Parent then
            local distance = (HRP.Position - safeTargetPosition).Magnitude
            local rawDistance = (HRP.Position - position).Magnitude

            if distance <= tolerance or rawDistance <= (tolerance + 1.5) then
                return true
            end
        end

        if attempt < attempts then
            task.wait(S.AreaTeleportDelay)
        end
    end

    zeroVelocity()
    return false
end

--==================================================
-- TASK EXECUTION
--==================================================

local function processPlayerTask(taskText)
    local target = findPlayerTarget(taskText)
    if not target then
        stopPlayerView()
        return false
    end

    local player = target.player
    State.targetUsername = player.Name

    if S.AutoViewCommandEnabled then
        sendViewCommand(player.Name)
        if S.AutoViewCommandDelay > 0 then
            task.wait(S.AutoViewCommandDelay)
        end
    end

    if not State.farming then return false end

    local teleported = teleportToPlayer(player)
    if not teleported or not State.farming then
        return false
    end

    local character = player.Character
    local targetHRP = character and character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then
        return false
    end

    local success = takePhoto(targetHRP, taskText, true)
    zeroVelocity()
    stopPlayerView()

    if success then
        State.lastTask = ""
        State.processing = false
        State.targetPlayer = ""
        State.targetUsername = ""
        State.currentPhotoFailure = 0
        task.wait(S.SuccessDelay)
        return true
    end

    State.currentPhotoFailure += 1
    return false
end

local function processAreaTask(taskText)
    stopPlayerView()

    local area = resolveArea(taskText)
    local position = findLocation(taskText, false)

    if not area or not position then
        position = findLocation(taskText, true)
        if not area or not position then
            return false
        end
    end

    local isRooftop = area == "Rooftop"
    local tolerance = isRooftop
        and math.max(0.2, tonumber(S.RooftopTeleportTolerance) or 1.2)
        or math.max(0.2, tonumber(S.AreaTeleportTolerance) or 1.5)
    local retries = isRooftop
        and S.RooftopTeleportRetryCount
        or S.AreaTeleportRetryCount

    local teleportOK = teleportToAreaExact(position, tolerance, retries)
    if not teleportOK or not State.farming or not HRP or not HRP.Parent then
        return false
    end

    local success = takePhoto(position, taskText, false)
    zeroVelocity()

    if success then
        State.lastTask = ""
        State.processing = false
        State.currentPhotoFailure = 0
        task.wait(S.SuccessDelay)
        return true
    end

    -- Jika gagal, refresh cache lokasi untuk jaga-jaga part berpindah
    findLocation(taskText, true)
    State.currentPhotoFailure += 1
    return false
end

local function isPlayerPhotoTask(taskText)
    local target = getPhotoTargetText(taskText)
    if not target then return false end
    if resolveArea(taskText) then return false end

    return getPlayerByText(target) ~= nil or findPlayerByInfo(target) ~= nil
end

local function restartUntilValidTask(sessionId)
    if not isCurrentSession(sessionId) or State.restarting then
        return false
    end

    State.restarting = true
    setAnchored(false)
    stopPlayerView()

    for _ = 1, 20 do
        if not isCurrentSession(sessionId) then break end

        stopCurrentJob()
        task.wait(S.RestartDelay)

        if not isCurrentSession(sessionId) then break end

        startNewJob(true)
        local taskText = waitForNewAssignment()

        if taskText then
            if isPlayerPhotoTask(taskText) then
                local target = findPlayerTarget(taskText)
                if target then
                    State.lastTask = ""
                    State.restarting = false
                    return true
                end
            elseif resolveArea(taskText) then
                State.lastTask = ""
                State.restarting = false
                return true
            end
        end

        State.restartCount += 1
    end

    State.restarting = false
    return false
end

processTask = function()
    if not State.farming or State.processing or State.restarting then
        return
    end

    local taskText = getTaskText()

    if not taskText or taskText == "" then
        startNewJob()
        return
    end

    local lower = taskText:lower()
    if lower:find("waiting for assignment", 1, true) then
        startNewJob()
        return
    end

    if resolveArea(taskText) then
        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        local success = processAreaTask(taskText)
        State.processing = false

        if success then return end

        State.lastTask = ""
        restartJob(State.sessionId, taskText)
        return
    end

    if isPlayerPhotoTask(taskText) then
        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        local success = processPlayerTask(taskText)
        State.processing = false

        if success then return end

        State.lastTask = ""
        -- Jika gagal memotret pemain 2x berturut-turut, ganti task baru agar tidak nyangkut
        if State.currentPhotoFailure >= 2 then
            restartJob(State.sessionId, taskText)
        else
            task.wait(S.PhotoRetryDelay)
        end
        return
    end

    State.stopReason = "Skipping invalid task: " .. tostring(taskText)
    restartUntilValidTask(State.sessionId)
end

--==================================================
-- FARM LOOP & START/STOP
--==================================================

local function farmLoop(sessionId)
    if not isCurrentSession(sessionId) then return end

    State.farmLoopRunning = true

    while isCurrentSession(sessionId) do
        local ok, err = pcall(processTask)
        if not ok then
            State.processing = false
            State.restarting = false
            setAnchored(false)
            warn("[PhotoFarm Error]:", err)
        end
        task.wait(S.RefreshRate)
    end

    if State.sessionId == sessionId then
        State.farmLoopRunning = false
    end
end

startFarming = function()
    if State.farming then return end

    if not findRemotes() then
        State.stopReason = "PhotoJob remotes not found"
        updateGUI()
        return
    end

    State.sessionId += 1
    local sessionId = State.sessionId

    State.farming = true
    State.processing = false
    State.restarting = false
    State.lastTask = ""
    State.taskCount = 0
    State.restartCount = 0
    State.stopReason = ""
    State.targetPlayer = ""
    State.targetUsername = ""
    State.lastStartRequest = 0
    State.photoAttempts = 0
    State.teleportAttempts = 0
    State.currentPhotoFailure = 0
    State.currentTeleportFailure = 0
    State.lastViewTarget = ""
    State.lastViewCommand = ""

    setAnchored(false)
    stopPlayerView()
    zeroVelocity()
    updateGUI()

    task.spawn(function()
        forceStartNewJob(sessionId)
        farmLoop(sessionId)
    end)
end

stopFarmingFromGUI = function()
    State.sessionId += 1
    State.farming = false
    State.processing = false
    State.restarting = false

    setAnchored(false)
    stopPlayerView()
    zeroVelocity()

    State.targetPlayer = ""
    State.targetUsername = ""
    State.lastTask = ""
    State.lastViewTarget = ""
    State.lastViewCommand = ""
    State.stopReason = "Disabled from GUI"

    stopCurrentJob()
    updateGUI()
end

