--==================================================
-- FIND LOCATION
--==================================================

local function findLocation(taskText)

    local area =
        resolveArea(
            taskText
        )

    if not area then
        return nil
    end

    local terms = {}

    table.insert(
        terms,
        area:lower()
    )

    for _, entry in ipairs(
        AREA_TASKS
    ) do

        if entry.canonical == area then

            for _, alias in ipairs(
                entry.aliases
            ) do

                table.insert(
                    terms,
                    tostring(alias):lower()
                )
            end
        end
    end

    -- MUSIC ROOM:
    -- "music" sengaja tidak digunakan
    -- sebagai pencarian utama.
    if area == "Music Room" then

        terms = {
            "music room",
            "musicroom",
            "music_room"
        }
    end

    local uniqueTerms = {}
    local seenTerms = {}

    for _, term in ipairs(
        terms
    ) do

        term =
            tostring(term):lower()

        if term ~= ""
            and not seenTerms[term] then

            seenTerms[term] = true

            table.insert(
                uniqueTerms,
                term
            )
        end
    end

    terms = uniqueTerms

    --==================================================
    -- EXACT SEARCH
    --==================================================

    local exactCandidate = nil
    local exactScore = -math.huge

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do

        local objectName =
            tostring(
                object.Name
            ):lower()

        local position =
            getObjectPosition(
                object
            )

        if position then

            for _, term in ipairs(
                terms
            ) do

                if objectName == term then

                    local score =
                        10000 + #term

                    if area == "Music Room" then
                        score += 5000
                    end

                    if score > exactScore then

                        exactScore =
                            score

                        exactCandidate =
                            position
                    end
                end
            end

            local landmarkValue =
                getLandmarkValue(
                    object
                )

            if landmarkValue then

                for _, term in ipairs(
                    terms
                ) do

                    if landmarkValue == term then

                        local score =
                            20000 + #term

                        if area == "Music Room" then
                            score += 5000
                        end

                        if score > exactScore then

                            exactScore =
                                score

                            exactCandidate =
                                position
                        end
                    end
                end
            end
        end
    end

    if exactCandidate then
        return exactCandidate
    end

    --==================================================
    -- PARTIAL SEARCH
    --==================================================

    local bestPosition = nil
    local bestScore = -math.huge

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do

        local objectName =
            tostring(
                object.Name
            ):lower()

        local position =
            getObjectPosition(
                object
            )

        if position then

            for _, term in ipairs(
                terms
            ) do

                if objectName:find(
                    term,
                    1,
                    true
                ) then

                    local score =
                        #term

                    if objectName == term then
                        score += 10000
                    end

                    if area == "Music Room"
                        and objectName:find(
                            "music room",
                            1,
                            true
                        ) then

                        score += 5000
                    end

                    if score > bestScore then

                        bestScore = score

                        bestPosition =
                            position
                    end
                end
            end

            local landmarkValue =
                getLandmarkValue(
                    object
                )

            if landmarkValue then

                for _, term in ipairs(
                    terms
                ) do

                    if landmarkValue:find(
                        term,
                        1,
                        true
                    ) then

                        local score =
                            1000 + #term

                        if landmarkValue == term then
                            score += 10000
                        end

                        if area == "Music Room"
                            and landmarkValue:find(
                                "music room",
                                1,
                                true
                            ) then

                            score += 5000
                        end

                        if score > bestScore then

                            bestScore =
                                score

                            bestPosition =
                                position
                        end
                    end
                end
            end
        end
    end

    return bestPosition
end

