--==================================================
-- PHOTO BUFFER
--==================================================

local PhotoBuffer

local function createPhotoBuffer()

    local ok, result =
        pcall(
            function()

                local data =
                    buffer.create(7)

                buffer.writeu8(
                    data,
                    0,
                    1
                )

                buffer.writeu8(
                    data,
                    1,
                    4
                )

                buffer.writeu8(
                    data,
                    2,
                    0
                )

                buffer.writeu8(
                    data,
                    3,
                    1
                )

                buffer.writeu8(
                    data,
                    4,
                    1
                )

                buffer.writeu8(
                    data,
                    5,
                    42
                )

                buffer.writeu8(
                    data,
                    6,
                    24
                )

                return data
            end
        )

    if ok then
        return result
    end

    return nil
end

PhotoBuffer =
    createPhotoBuffer()

--==================================================
-- TAKE PHOTO
--==================================================

local function takePhoto(
    targetPosition,
    previousTask
)

    if not State.farming then
        return false
    end

    if not phoneScreenPush
        or not photoJobSubmit then

        return false
    end

    if not HRP
        or not HRP.Parent then

        return false
    end

    if not PhotoBuffer then

        PhotoBuffer =
            createPhotoBuffer()

        if not PhotoBuffer then
            return false
        end
    end

    local lookAt =
        targetPosition

    if not lookAt then

        lookAt =
            HRP.Position +
            HRP.CFrame.LookVector *
            10
    end

    for attempt = 1,
        S.PhotoRetryCount do

        if not State.farming then
            return false
        end

        State.photoAttempts += 1

        local pushOK =
            pcall(
                phoneScreenPush.FireServer,
                phoneScreenPush,
                PhotoBuffer
            )

        if pushOK then

            if not HRP
                or not HRP.Parent then

                return false
            end

            local photoPosition =
                HRP.Position

            local photoCFrame =
                CFrame.lookAt(
                    photoPosition,
                    lookAt
                )

            local invokeOK,
                serverResult =
                pcall(
                    photoJobSubmit.InvokeServer,
                    photoJobSubmit,
                    "Submit",
                    photoCFrame
                )

            if invokeOK then

                if serverResult == true then
                    return true
                end

                if serverResult ~= false then

                    if waitForPhotoResult(
                        previousTask
                    ) then

                        return true
                    end
                end
            end
        end

        if attempt <
            S.PhotoRetryCount then

            task.wait(
                S.PhotoRetryDelay
            )
        end
    end

    return false
end

--==================================================
-- SAFE PLAYER TELEPORT
--==================================================

local function teleportToPlayer(
    targetPlayer
)

    if not State.farming then
        return false
    end

    if not HRP
        or not HRP.Parent then

        return false
    end

    if not targetPlayer
        or not targetPlayer.Parent then

        return false
    end

    local character =
        targetPlayer.Character

    if not character then
        return false
    end

    local targetHRP =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not targetHRP then
        return false
    end

    setCollision(false)
    zeroVelocity()

    for attempt = 1,
        S.TeleportRetryCount do

        if not State.farming then

            setCollision(true)

            return false
        end

        State.teleportAttempts += 1

        character =
            targetPlayer.Character

        if not character then

            task.wait(
                S.TeleportRetryDelay
            )

            continue
        end

        targetHRP =
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not targetHRP then

            task.wait(
                S.TeleportRetryDelay
            )

            continue
        end

        local targetPosition =
            targetHRP.Position

        local targetLook =
            targetHRP.CFrame.LookVector

        local safeDistance =
            math.max(
                3.0,
                tonumber(
                    S.PlayerSafeDistance
                ) or 3.5
            )

        local destination =
            targetPosition -
            targetLook *
            safeDistance +
            Vector3.new(
                0,
                0.15,
                0
            )

        local destinationCFrame =
            CFrame.lookAt(
                destination,
                targetPosition
            )

        if Character
            and Character.Parent then

            pcall(
                function()

                    Character:PivotTo(
                        destinationCFrame
                    )

                end
            )
        end

        if HRP
            and HRP.Parent then

            pcall(
                function()

                    HRP.CFrame =
                        destinationCFrame

                end
            )

            zeroVelocity()
        end

        if HRP
            and HRP.Parent then

            local actualDistance =
                (
                    HRP.Position -
                    targetPosition
                ).Magnitude

            local destinationDistance =
                (
                    HRP.Position -
                    destination
                ).Magnitude

            if destinationDistance <=
                S.TeleportDistanceTolerance
                and actualDistance >= 2.5 then

                pcall(
                    function()

                        HRP.CFrame =
                            CFrame.lookAt(
                                HRP.Position,
                                targetPosition
                            )

                    end
                )

                zeroVelocity()

                setCollision(true)

                return true
            end
        end

        task.wait(
            S.TeleportRetryDelay
        )
    end

    setCollision(true)
    zeroVelocity()

    return false
end

--==================================================
-- PLAYER PHOTO
--==================================================

local function processPlayerTask(
    taskText
)

    local target =
        findPlayerTarget(
            taskText
        )

    if not target then

        stopPlayerView()

        return false
    end

    local player =
        target.player

    State.targetUsername =
        player.Name

    if S.AutoViewCommandEnabled then

        sendViewCommand(
            player.Name
        )

        if S.AutoViewCommandDelay > 0 then

            task.wait(
                S.AutoViewCommandDelay
            )
        end
    end

    if not State.farming then
        return false
    end

    local teleported =
        teleportToPlayer(
            player
        )

    if not teleported then

        setCollision(true)

        return false
    end

    if not State.farming then

        setCollision(true)

        return false
    end

    local character =
        player.Character

    if not character then

        setCollision(true)

        return false
    end

    local targetHRP =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not targetHRP then

        setCollision(true)

        return false
    end

    local success =
        takePhoto(
            targetHRP.Position,
            taskText
        )

    setCollision(true)
    zeroVelocity()
    stopPlayerView()

    if success then

        State.lastTask = ""

        State.processing = false

        State.targetPlayer = ""
        State.targetUsername = ""

        State.currentPhotoFailure = 0

        task.wait(
            S.SuccessDelay
        )

        return true
    end

    State.currentPhotoFailure += 1

    return false
end

--==================================================
-- AREA PHOTO
--==================================================

local function processAreaTask(
    taskText
)

    stopPlayerView()

    local position =
        findLocation(
            taskText
        )

    if not position then
        return false
    end

    if not smoothTween(
        position
    ) then

        return false
    end

    if not State.farming then
        return false
    end

    -- FINAL POSITION VERIFY
    if HRP
        and HRP.Parent then

        local distance =
            (
                HRP.Position -
                position
            ).Magnitude

        if distance >
            S.TeleportDistanceTolerance then

            pcall(
                function()

                    Character:PivotTo(
                        CFrame.new(
                            position
                        )
                    )

                end
            )

            zeroVelocity()
        end
    end

    if not State.farming then
        return false
    end

    local success =
        takePhoto(
            position,
            taskText
        )

    setCollision(true)
    zeroVelocity()

    if success then

        State.lastTask = ""
        State.processing = false

        State.currentPhotoFailure = 0

        task.wait(
            S.SuccessDelay
        )

        return true
    end

    State.currentPhotoFailure += 1

    return false
end

--==================================================
-- PLAYER TASK CHECK
--==================================================

local function isPlayerPhotoTask(
    taskText
)

    local target =
        getPhotoTargetText(
            taskText
        )

    if not target then
        return false
    end

    if resolveArea(
        taskText
    ) then

        return false
    end

    return
        getPlayerByText(
            target
        ) ~= nil
        or
        findPlayerByInfo(
            target
        ) ~= nil
end

--==================================================
-- RESTART INVALID ONLY
--==================================================

local function restartUntilValidTask()

    if not State.farming
        or State.restarting then

        return false
    end

    State.restarting = true

    stopPlayerView()
    cancelTween()
    setCollision(true)

    for _ = 1, 20 do

        if not State.farming then
            break
        end

        stopCurrentJob()

        task.wait(
            S.RestartDelay
        )

        if not State.farming then
            break
        end

        startNewJob()

        local taskText =
            waitForNewAssignment()

        if taskText then

            if isPlayerPhotoTask(
                taskText
            ) then

                local target =
                    findPlayerTarget(
                        taskText
                    )

                if target then

                    State.lastTask = ""

                    State.restarting =
                        false

                    return true
                end

            elseif resolveArea(
                taskText
            ) then

                State.lastTask = ""

                State.restarting =
                    false

                return true
            end
        end

        State.restartCount += 1
    end

    State.restarting = false

    return false
end

--==================================================
-- PROCESS TASK
--==================================================

local function processTask()

    if not State.farming
        or State.processing
        or State.restarting then

        return
    end

    local taskText =
        getTaskText()

    -- NO TASK
    if not taskText
        or taskText == "" then

        startNewJob()

        return
    end

    local lower =
        taskText:lower()

    -- WAITING
    if lower:find(
        "waiting for assignment",
        1,
        true
    ) then

        startNewJob()

        return
    end

    -- AREA
    if resolveArea(
        taskText
    ) then

        if State.lastTask ==
            taskText then

            return
        end

        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        local success =
            processAreaTask(
                taskText
            )

        State.processing = false

        if success then
            return
        end

        -- PHOTO FAIL:
        -- SAME JOB / NO REROLL
        State.lastTask = ""

        task.wait(
            S.PhotoRetryDelay
        )

        return
    end

    -- PLAYER
    if isPlayerPhotoTask(
        taskText
    ) then

        if State.lastTask ==
            taskText then

            return
        end

        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        local success =
            processPlayerTask(
                taskText
            )

        State.processing = false

        if success then
            return
        end

        State.lastTask = ""

        task.wait(
            S.PhotoRetryDelay
        )

        return
    end

    -- INVALID
    State.stopReason =
        "Invalid task: " ..
        tostring(taskText)

    restartUntilValidTask()
end

--==================================================
-- FARM LOOP
--==================================================

local function farmLoop()

    if farmLoopRunning then
        return
    end

    farmLoopRunning = true

    while State.farming do

        pcall(
            processTask
        )

        task.wait(
            S.RefreshRate
        )
    end

    setCollision(true)
    stopPlayerView()

    farmLoopRunning = false
end

--==================================================
-- START FARMING
--==================================================

startFarming = function()

    if State.farming then
        return
    end

    if not findRemotes() then

        State.stopReason =
            "PhotoJob remotes not found"

        updateGUI()

        return
    end

    State.farming = true

    State.processing = false
    State.tweening = false
    State.restarting = false

    State.lastTask = ""

    State.taskCount = 0
    State.restartCount = 0

    State.stopReason = ""

    State.targetPlayer = ""
    State.targetUsername = ""

    State.lastStartRequest = 0

    State.photoAttempts = 0
    State.teleportAttempts = 0

    State.currentPhotoFailure = 0
    State.currentTeleportFailure = 0

    -- NEW SESSION
    State.lastViewTarget = ""
    State.lastViewCommand = ""

    -- NO AUTO SPECTATE
    stopPlayerView()

    cancelTween()

    setCollision(true)
    zeroVelocity()

    if S.FlyEnabled then
        startFly()
    end

    updateGUI()

    --==================================================
    -- LANGSUNG START JOB BARU
    --==================================================

    task.spawn(
        function()

            if not State.farming then
                return
            end

            startImmediateNewJob()

        end
    )

    -- START FARM LOOP
    task.spawn(
        farmLoop
    )
end

