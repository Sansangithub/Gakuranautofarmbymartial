-- START
--==================================================

startFarming = function()

    if State.farming then
        return
    end

    if not findRemotes() then

        State.stopReason =
            "PhotoJob remotes not found"

        updateGUI()

        return
    end

    State.farming =
        true

    State.processing =
        false

    State.tweening =
        false

    State.restarting =
        false

    State.lastTask =
        ""

    State.taskCount =
        0

    State.restartCount =
        0

    State.stopReason =
        ""

    State.targetPlayer =
        ""

    State.targetUsername =
        ""

    State.lastStartRequest =
        0

    State.photoAttempts =
        0

    State.teleportAttempts =
        0

    stopPlayerView()

    setCollision(true)

    if S.FlyEnabled then
        startFly()
    end

    updateGUI()

    task.spawn(
        farmLoop
    )
end

