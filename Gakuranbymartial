local function destroyFlyObjects()
    if State.flyVelocity then
        pcall(function()
            State.flyVelocity:Destroy()
        end)

        State.flyVelocity = nil
    end

    if State.flyOrientation then
        pcall(function()
            State.flyOrientation:Destroy()
        end)

        State.flyOrientation = nil
    end

    if State.flyAttachment then
        pcall(function()
            State.flyAttachment:Destroy()
        end)

        State.flyAttachment = nil
    end
end

stopFly = function()
    State.flyEnabled = false

    if State.flyConnection then
        State.flyConnection:Disconnect()
        State.flyConnection = nil
    end

    destroyFlyObjects()

    if Humanoid then
        Humanoid.PlatformStand = false
        Humanoid.AutoRotate = true
    end

    if HRP then
        HRP.AssemblyLinearVelocity =
            Vector3.zero

        HRP.AssemblyAngularVelocity =
            Vector3.zero
    end

    updateGUI()
end

startFly = function()
    if not S.FlyEnabled
        or not HRP
        or not Humanoid
        or not HRP.Parent then

        return
    end

    stopFly()

    State.flyEnabled = true

    local attachment =
        Instance.new("Attachment")

    attachment.Name =
        "PhotoFarmFlyAttachment"

    attachment.Parent = HRP
    State.flyAttachment = attachment

    local velocity =
        Instance.new("LinearVelocity")

    velocity.Name =
        "PhotoFarmFlyVelocity"

    velocity.Attachment0 =
        attachment

    velocity.RelativeTo =
        Enum.ActuatorRelativeTo.World

    velocity.VelocityConstraintMode =
        Enum.VelocityConstraintMode.Vector

    velocity.VectorVelocity =
        Vector3.zero

    velocity.ForceLimitsEnabled = false
    velocity.MaxForce = math.huge
    velocity.Parent = HRP

    State.flyVelocity = velocity

    local orientation =
        Instance.new("AlignOrientation")

    orientation.Name =
        "PhotoFarmFlyOrientation"

    orientation.Attachment0 =
        attachment

    orientation.Mode =
        Enum.OrientationAlignmentMode.OneAttachment

    orientation.RigidityEnabled = true
    orientation.MaxTorque = math.huge
    orientation.Responsiveness = 200
    orientation.CFrame = HRP.CFrame
    orientation.Parent = HRP

    State.flyOrientation = orientation

    Humanoid.PlatformStand = true
    Humanoid.AutoRotate = false

    State.flyConnection =
        RunService.Heartbeat:Connect(function()
            if not State.farming then
                return
            end

            if not State.flyEnabled
                or not HRP
                or not HRP.Parent then

                return
            end

            if State.flyVelocity
                and State.flyVelocity.Parent then

                State.flyVelocity.VectorVelocity =
                    Vector3.zero
            end

            HRP.AssemblyAngularVelocity =
                Vector3.zero
        end)

    updateGUI()
end

--==================================================
-- TWEEN
--==================================================

local function cancelTween()
    if currentTween then
        pcall(function()
            currentTween:Cancel()
        end)

        currentTween = nil
    end

    State.tweening = false
end

local function smoothTween(position)
    if not HRP
        or not HRP.Parent
        or not State.farming then

        return false
    end

    local distance =
        (position - HRP.Position).Magnitude

    if distance <= S.MaxDistance then
        HRP.CFrame =
            CFrame.new(position)

        return true
    end

    cancelTween()

    local duration =
        math.clamp(
            distance / S.TweenSpeed,
            S.MinDuration,
            S.MaxDuration
        )

    State.tweening = true

    currentTween =
        TweenService:Create(
            HRP,
            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear
            ),
            {
                CFrame =
                    CFrame.new(position)
            }
        )

    currentTween:Play()

    local finished = false

    local connection =
        currentTween.Completed:Connect(
            function()
                finished = true
            end
        )

    while State.farming
        and not finished do

        RunService.Heartbeat:Wait()
    end

    connection:Disconnect()

    currentTween = nil
    State.tweening = false

    return State.farming
end

