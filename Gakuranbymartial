--// ULTRA-FAST PHOTO FARM
--// Direct teleport + target validation + photo validation
--// No auto spectate while farming
--// Same player = ;view once
--// Different player = new ;view
--// Area whitelist
--// Music Room = reroll
--// Invalid task = restart
--// Target moved = reposition
--// No photo before valid position

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TextChatService = game:GetService("TextChatService")

local LP = Players.LocalPlayer

local CFG = {
    -- PLAYER PHOTO
    PHOTO_DISTANCE = 2.35,
    PHOTO_HEIGHT = 0.12,

    -- AGGRESSIVE TELEPORT
    TELEPORT_RETRIES = 2,
    TELEPORT_TOLERANCE = 3.0,

    -- TARGET VALIDATION
    MAX_PHOTO_DISTANCE = 5.5,
    TARGET_MOVE_TOLERANCE = 1.75,

    -- VERY SHORT DELAYS
    POSITION_SETTLE = 0,
    PHOTO_RETRY_DELAY = 0.008,
    LOOP_DELAY = 0.008,
    SEARCH_DELAY = 0.008,

    -- PHOTO
    PHOTO_RETRIES = 2,

    -- AREA
    AREA_SPEED = 500,

    -- AUTO VIEW
    AUTO_VIEW = false,

    -- FLY
    FLY = true
}

local Character
local Humanoid
local Root

local Farming = false
local Processing = false
local LastTask = ""

local LastViewTarget = ""

local PhotoAttempts = 0
local TeleportAttempts = 0

local PhoneRemote
local JobRemote

--==================================================
-- CHARACTER
--==================================================

local function bindCharacter(char)

    Character = char

    Humanoid =
        char:WaitForChild(
            "Humanoid",
            10
        )

    Root =
        char:WaitForChild(
            "HumanoidRootPart",
            10
        )
end

if LP.Character then
    bindCharacter(LP.Character)
end

LP.CharacterAdded:Connect(function(char)

    bindCharacter(char)

end)

--==================================================
-- REMOTES
--==================================================

local function findRemotes()

    local folder =
        ReplicatedStorage:FindFirstChild(
            "Remotes"
        )

    if not folder then
        return false
    end

    PhoneRemote =
        folder:FindFirstChild(
            "PhoneScreenPush"
        )

    JobRemote =
        folder:FindFirstChild(
            "PhotoJobSubmit"
        )

    return
        PhoneRemote ~= nil
        and JobRemote ~= nil
end

