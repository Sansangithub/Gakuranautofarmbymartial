task.spawn(function()

    local attempts = 0

    while not findRemotes()
        and attempts < 30 do

        attempts += 1

        task.wait(1)
    end

    if not phoneScreenPush
        or not photoJobSubmit then

        State.stopReason =
            "PhotoJob remotes not found"

        State.farming = false

        stopFly()

        updateGUI()

        return
    end

    --==================================================
