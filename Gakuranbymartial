local function isPlayerPhotoTask(
    taskText
)

    local target =
        getPhotoTargetText(
            taskText
        )

    if not target then
        return false
    end

    if resolveArea(
        taskText
    ) then

        return false
    end

    return
        getPlayerByText(
            target
        ) ~= nil
        or
        findPlayerByInfo(
            target
        ) ~= nil
end

--==================================================
-- RESTART
--==================================================

local function restartUntilValidTask()

    if not State.farming
        or State.restarting then

        return false
    end

    State.restarting =
        true

    stopPlayerView()
    cancelTween()
    setCollision(true)

    for _ = 1, 20 do

        if not State.farming then
            break
        end

        stopCurrentJob()

        if S.RestartDelay > 0 then
            task.wait(
                S.RestartDelay
            )
        end

        if not State.farming then
            break
        end

        startNewJob()

        local taskText =
            waitForNewAssignment()

        if taskText then

            if isRejectedTask(
                taskText
            ) then

                State.restartCount += 1
                continue
            end

            if isPlayerPhotoTask(
                taskText
            ) then

                local target =
                    findPlayerTarget(
                        taskText
                    )

                if target then

                    State.lastTask =
                        ""

                    State.restarting =
                        false

                    return true
                end

            elseif resolveArea(
                taskText
            ) then

                State.lastTask =
                    ""

                State.restarting =
                    false

                return true
            end
        end

        State.restartCount += 1
    end

    State.restarting =
        false

    return false
end

--==================================================
-- PROCESS TASK
--==================================================

local function processTask()

    if not State.farming
        or State.processing
        or State.restarting then

        return
    end

    local taskText =
        getTaskText()

    if not taskText
        or taskText == "" then

        startNewJob()
        return
    end

    local lower =
        taskText:lower()

    if lower:find(
        "waiting for assignment",
        1,
        true
    ) then

        startNewJob()
        return
    end

    if isRejectedTask(
        taskText
    ) then

        State.stopReason =
            "Music Room -> reroll"

        restartUntilValidTask()

        return
    end

    -- AREA
    if resolveArea(
        taskText
    ) then

        if State.lastTask ==
            taskText then

            return
        end

        State.processing =
            true

        State.lastTask =
            taskText

        State.taskCount += 1

        local success =
            processAreaTask(
                taskText
            )

        State.processing =
            false

        if not success then

            State.stopReason =
                "Area photo failed"

            State.lastTask =
                ""

            restartUntilValidTask()
        end

        return
    end

    -- PLAYER
    if isPlayerPhotoTask(
        taskText
    ) then

        if State.lastTask ==
            taskText then

            return
        end

        State.processing =
            true

        State.lastTask =
            taskText

        State.taskCount += 1

        local success =
            processPlayerTask(
                taskText
            )

        State.processing =
            false

        if not success then

            State.stopReason =
                "Player photo failed"

            State.lastTask =
                ""

            restartUntilValidTask()
        end

        return
    end

    -- INVALID
    State.stopReason =
        "Invalid task: "
        .. tostring(
            taskText
        )

    restartUntilValidTask()
end

--==================================================
-- FARM LOOP
--==================================================

local function farmLoop()

    if farmLoopRunning then
        return
    end

    farmLoopRunning =
        true

    while State.farming do

        pcall(
            processTask
        )

        if S.RefreshRate > 0 then

            task.wait(
                S.RefreshRate
            )

        else

            RunService.Heartbeat:Wait()

        end
    end

    setCollision(true)

    stopPlayerView()

    farmLoopRunning =
        false
end

