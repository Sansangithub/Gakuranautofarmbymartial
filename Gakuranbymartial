--==================================================
-- TWEEN
--==================================================

local function cancelTween()

    if currentTween then

        pcall(
            function()
                currentTween:Cancel()
            end
        )

        currentTween = nil
    end

    State.tweening = false
end

local function smoothTween(position)

    if not HRP
        or not HRP.Parent
        or not State.farming then

        return false
    end

    local distance =
        (
            position -
            HRP.Position
        ).Magnitude

    if distance <= S.MaxDistance then

        HRP.CFrame =
            CFrame.new(position)

        zeroVelocity()

        return true
    end

    cancelTween()

    setCollision(false)

    State.tweening = true

    local duration =
        math.clamp(
            distance / S.TweenSpeed,
            S.MinDuration,
            S.MaxDuration
        )

    currentTween =
        TweenService:Create(
            HRP,

            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear
            ),

            {
                CFrame =
                    CFrame.new(position)
            }
        )

    currentTween:Play()

    local finished = false

    local connection =
        currentTween.Completed:Connect(
            function()
                finished = true
            end
        )

    while State.farming
        and not finished do

        task.wait()
    end

    connection:Disconnect()

    currentTween = nil

    State.tweening = false

    zeroVelocity()
    setCollision(true)

    return State.farming
end

