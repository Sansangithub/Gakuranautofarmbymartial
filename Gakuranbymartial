--==================================================

startPlayerView = function(player)

    if not S.PlayerViewEnabled then
        return false
    end

    if not player then
        return false
    end

    local character =
        player.Character

    if not character then
        return false
    end

    local targetHumanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not targetHumanoid then
        return false
    end

    local targetHRP =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    local camera =
        getCamera()

    if not camera then
        return false
    end

    --==================================================
    -- SAME TARGET
    --==================================================

    if CameraState.active
        and CameraState.targetPlayer == player then

        CameraState.targetCharacter =
            character

        CameraState.targetHumanoid =
            targetHumanoid

        CameraState.targetHRP =
            targetHRP

        camera.CameraType =
            Enum.CameraType.Custom

        camera.CameraSubject =
            targetHumanoid

        return true
    end

    --==================================================
    -- SAVE CAMERA
    --==================================================

    stopPlayerView()

    CameraState.previousCameraType =
        camera.CameraType

    CameraState.previousCameraSubject =
        camera.CameraSubject

    CameraState.active = true

    CameraState.targetPlayer =
        player

    CameraState.targetCharacter =
        character

    CameraState.targetHumanoid =
        targetHumanoid

    CameraState.targetHRP =
        targetHRP

    --==================================================
    -- INFINITE YIELD STYLE
    --==================================================

    camera.CameraType =
        Enum.CameraType.Custom

    camera.CameraSubject =
        targetHumanoid

    return true
end

--==================================================
-- STOP PLAYER VIEW
--==================================================

stopPlayerView = function()

    local camera =
        getCamera()

    if camera then

        camera.CameraType =
            CameraState.previousCameraType
            or Enum.CameraType.Custom

        if CameraState.previousCameraSubject
            and CameraState.previousCameraSubject.Parent then

            camera.CameraSubject =
                CameraState.previousCameraSubject

        elseif Humanoid
            and Humanoid.Parent then

            camera.CameraSubject =
                Humanoid
        end
    end

    CameraState.active = false

    CameraState.targetPlayer = nil
    CameraState.targetCharacter = nil
    CameraState.targetHumanoid = nil
    CameraState.targetHRP = nil

    CameraState.previousCameraType = nil
    CameraState.previousCameraSubject = nil
end

--==================================================
-- WAIT PLAYER VIEW
--==================================================

local function waitPlayerView()

    if not S.PlayerViewEnabled then
        return true
    end

    local duration =
        tonumber(
            S.PlayerViewDuration
        ) or 1.5

    duration =
        math.max(
            0,
            duration
        )

    if duration <= 0 then
        return true
    end

    local started =
        os.clock()

    while State.farming do

        if not CameraState.active then
            break
        end

        if os.clock()
            - started >= duration then

            break
        end

        local player =
            CameraState.targetPlayer

        if not player then
            break
        end

        local character =
            player.Character

        if not character then
            break
        end

        local targetHumanoid =
            character:FindFirstChildOfClass(
                "Humanoid"
            )

        if not targetHumanoid then
            break
        end

        local camera =
            getCamera()

        if camera then

            camera.CameraType =
                Enum.CameraType.Custom

            camera.CameraSubject =
                targetHumanoid
        end

        CameraState.targetCharacter =
            character

        CameraState.targetHumanoid =
            targetHumanoid

        CameraState.targetHRP =
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        task.wait()
    end

    return true
end

--==================================================
-- CHARACTER
--==================================================

local function bindCharacter(character)

    Character = character

    HRP =
        character:WaitForChild(
            "HumanoidRootPart",
            10
        )

    Humanoid =
        character:WaitForChild(
            "Humanoid",
            10
        )

    Camera =
        Workspace.CurrentCamera

    if not HRP then
        return
    end

    for _, object in ipairs(
        character:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            object.CanCollide = true
        end
    end

    if State.farming
        and S.FlyEnabled then

        task.wait(0.2)

        if State.farming then
            startFly()
        end
    end
end

