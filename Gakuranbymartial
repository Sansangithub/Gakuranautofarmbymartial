-- STOP
--==================================================

stopFarmingFromGUI = function()

    if not State.farming then

        stopPlayerView()
        stopFly()

        updateGUI()

        return
    end

    State.farming =
        false

    cancelTween()
    stopPlayerView()
    stopFly()
    stopCurrentJob()

    State.processing =
        false

    State.tweening =
        false

    State.restarting =
        false

    State.targetPlayer =
        ""

    State.targetUsername =
        ""

    State.lastViewCommand =
        ""

    State.stopReason =
        "Disabled from GUI"

    setCollision(true)

    updateGUI()
end

