--==================================================
-- RESTART UNTIL VALID
--==================================================

local function restartUntilValidTask()

    if not State.farming then
        return false
    end

    if State.restarting then
        return false
    end

    State.restarting = true
    State.processing = false
    State.tweening = false

    State.targetPlayer = ""
    State.targetUsername = ""

    cancelTween()
    setCollision(true)

    while State.farming do

        local taskText =
            getTaskText()

        if taskText
            and taskText ~= "" then

            local lower =
                taskText:lower()

            if not lower:find(
                "waiting for assignment",
                1,
                true
            ) then

                if isPlayerPhotoTask(
                    taskText
                ) then

                    local target =
                        findPlayerTarget(
                            taskText
                        )

                    if target then

                        State.lastTask = ""
                        State.restarting = false

                        return true
                    end

                elseif isWhitelistedTask(
                    taskText
                )
                and not isRejectedTask(
                    taskText
                ) then

                    State.lastTask = ""
                    State.restarting = false

                    return true
                end
            end
        end

        if not State.farming then
            break
        end

        stopCurrentJob()

        State.restartCount += 1

        task.wait(
            S.RestartDelay
        )

        if not State.farming then
            break
        end

        startNewJob()

        task.wait(
            S.StartDelay
        )

        for i = 1,
            S.MaxAttempts do

            if not State.farming then
                break
            end

            local newTask =
                getTaskText()

            if newTask
                and newTask ~= "" then

                local newLower =
                    newTask:lower()

                if not newLower:find(
                    "waiting for assignment",
                    1,
                    true
                ) then

                    if isPlayerPhotoTask(
                        newTask
                    ) then

                        local target =
                            findPlayerTarget(
                                newTask
                            )

                        if target then

                            State.lastTask = ""
                            State.restarting = false

                            return true
                        end

                        break
                    end

                    if isWhitelistedTask(
                        newTask
                    )
                    and not isRejectedTask(
                        newTask
                    ) then

                        State.lastTask = ""
                        State.restarting = false

                        return true
                    end

                    break
                end
            end

            task.wait(
                S.AssignmentWait
            )
        end
    end

    State.restarting = false

    return false
end

--==================================================
-- FIND AREA LOCATION
--==================================================

local function findLocation(taskText)

    local area =
        resolveArea(
            taskText
        )

    if not area then
        return nil
    end

    local searchTerms = {}

    table.insert(
        searchTerms,
        area:lower()
    )

    local normalized =
        normalizeText(
            taskText
        )

    table.insert(
        searchTerms,
        normalized
    )

    if area == "GAKUMART" then

        table.insert(
            searchTerms,
            "gakumart"
        )

        table.insert(
            searchTerms,
            "gaku mart"
        )
    end

    if area == "Rooftop" then

        table.insert(
            searchTerms,
            "rooftop"
        )

        table.insert(
            searchTerms,
            "roof"
        )
    end

    local bestPart = nil
    local bestScore = 0

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            local objectName =
                object.Name:lower()

            for _, term in ipairs(
                searchTerms
            ) do

                if term ~= ""
                    and objectName:find(
                        term,
                        1,
                        true
                    ) then

                    local score =
                        #term

                    if score > bestScore then

                        bestScore =
                            score

                        bestPart =
                            object
                    end
                end
            end

            local landmark =
                object:FindFirstChild(
                    "PhotoJobLandmark"
                )

            if landmark
                and landmark:IsA(
                    "StringValue"
                ) then

                local value =
                    landmark.Value:lower()

                for _, term in ipairs(
                    searchTerms
                ) do

                    if term ~= ""
                        and value:find(
                            term,
                            1,
                            true
                        ) then

                        local score =
                            #term + 100

                        if score > bestScore then

                            bestScore =
                                score

                            bestPart =
                                object
                        end
                    end
                end
            end
        end
    end

    if bestPart then
        return bestPart.Position
    end

    return nil
end

--==================================================
-- FAST MOVE
--==================================================

local function smoothTween(
    targetPosition
)

    if not HRP then
        return false
    end

    if not State.farming then
        return false
    end

    cancelTween()

    local startPosition =
        HRP.Position

    local distance =
        (
            targetPosition
            - startPosition
        ).Magnitude

    if distance <= S.MaxDistance then

        HRP.CFrame =
            CFrame.new(
                targetPosition
            )

        setCollision(true)

        return true
    end

    setCollision(false)

    State.tweening = true

    local duration =
        math.clamp(
            distance / S.TweenSpeed,
            S.MinDuration,
            S.MaxDuration
        )

    currentTween =
        TweenService:Create(
            HRP,

            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),

            {
                CFrame =
                    CFrame.new(
                        targetPosition
                    )
            }
        )

    currentTween:Play()

    local completed = false

    local connection

    connection =
        currentTween.Completed:Connect(
            function()
                completed = true
            end
        )

    while not completed do

        if not State.farming then

            connection:Disconnect()

            cancelTween()
            setCollision(true)

            return false
        end

        task.wait()
    end

    connection:Disconnect()

    currentTween = nil
    State.tweening = false

    setCollision(true)

    return true
end

--==================================================
-- MOVE TO PLAYER
--==================================================

local function moveToPlayerTarget(
    target
)

    if not target then
        return false
    end

    if not target.player then
        return false
    end

    local player =
        target.player

    local character =
        player.Character

    if not character then
        return false
    end

    local targetHRP =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not targetHRP then
        return false
    end

    State.targetUsername =
        player.Name

    local targetPosition =
        targetHRP.Position

    local moved =
        smoothTween(
            targetPosition
        )

    if not moved then
        return false
    end

    task.wait(0.05)

    if character.Parent then

        targetHRP =
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        if targetHRP then

            local distance =
                (
                    HRP.Position
                    - targetHRP.Position
                ).Magnitude

            if distance > S.PhotoRange then

                smoothTween(
                    targetHRP.Position
                )
            end
        end
    end

    return true
end

--==================================================
-- TAKE PHOTO
--==================================================

local function takePhoto(
    targetPosition
)

    if not State.farming then
        return false
    end

    if not phoneScreenPush
        or not photoJobSubmit
        or not HRP then

        return false
    end

    local bufferData =
        buffer.create(7)

    buffer.writeu8(
        bufferData,
        0,
        1
    )

    buffer.writeu8(
        bufferData,
        1,
        4
    )

    buffer.writeu8(
        bufferData,
        2,
        0
    )

    buffer.writeu8(
        bufferData,
        3,
        1
    )

    buffer.writeu8(
        bufferData,
        4,
        1
    )

    buffer.writeu8(
        bufferData,
        5,
        42
    )

    buffer.writeu8(
        bufferData,
        6,
        24
    )

    local pushSuccess =
        pcall(
            phoneScreenPush.FireServer,
            phoneScreenPush,
            bufferData
        )

    if not pushSuccess then
        return false
    end

    task.wait(0.15)

    if not State.farming then
        return false
    end

    local lookAt =
        targetPosition
        or (
            HRP.Position
            + HRP.CFrame.LookVector
            * 10
        )

    local submitSuccess =
        pcall(
            photoJobSubmit.InvokeServer,
            photoJobSubmit,
            "Submit",
            CFrame.new(
                HRP.Position,
                lookAt
            )
        )

    task.wait(0.15)

    return submitSuccess
end

--==================================================
-- PROCESS PLAYER TASK
--==================================================

local function processPlayerTask(
    taskText
)

    if not State.farming then
        return false
    end

    local target =
        findPlayerTarget(
            taskText
        )

    if not target then

        State.stopReason =
            "Player not found: "
            .. tostring(
                getTargetPlayerText(
                    taskText
                ) or "Unknown"
            )

        State.lastTask = ""

        restartUntilValidTask()

        return false
    end

    local realPlayer =
        target.player

    State.targetUsername =
        realPlayer.Name

    local moved =
        moveToPlayerTarget(
            target
        )

    if not moved then

        State.lastTask = ""

        return false
    end

    if not State.farming then
        return false
    end

    local character =
        realPlayer.Character

    local targetHRP

    if character then

        targetHRP =
            character:FindFirstChild(
                "HumanoidRootPart"
            )
    end

    local photoPosition

    if targetHRP then

        photoPosition =
            targetHRP.Position

    else

        photoPosition =
            target.position
    end

    takePhoto(
        photoPosition
    )

    setCollision(true)

    State.tweening = false
    State.processing = false

    task.wait(0.5)

    State.lastTask = ""
    State.targetPlayer = ""
    State.targetUsername = ""

    return true
end

--==================================================
-- PROCESS AREA TASK
--==================================================

local function processAreaTask(
    taskText
)

    local area =
        resolveArea(
            taskText
        )

    if not area then
        return false
    end

    local position =
        findLocation(
            taskText
        )

    if not position then

        State.stopReason =
            "Location not found: "
            .. tostring(area)

        State.processing = false
        State.lastTask = ""

        return false
    end

    local moved =
        smoothTween(
            position
        )

    if not moved then

        State.processing = false

        return false
    end

    if not State.farming then

        State.processing = false

        return false
    end

    task.wait(0.2)

    takePhoto(
        position
    )

    setCollision(true)

    State.tweening = false
    State.processing = false

    task.wait(0.5)

    State.lastTask = ""

    return true
end

--==================================================
-- PROCESS ONE TASK
--==================================================

local function processTask()

    if not State.farming then
        return
    end

    if State.processing
        or State.restarting then

        return
    end

    local taskText =
        getTaskText()

    if not taskText
        or taskText == "" then

        return
    end

    local lower =
        taskText:lower()

    if lower:find(
        "waiting for assignment",
        1,
        true
    ) then

        return
    end

    --==================================================
    -- MUSIC ROOM
    --==================================================

    if isRejectedTask(
        taskText
    ) then

        State.stopReason =
            "Music Room rejected: "
            .. tostring(taskText)

        restartUntilValidTask()

        return
    end

    --==================================================
    -- AREA HAS PRIORITY
    --==================================================

    local area =
        resolveArea(
            taskText
        )

    if area then

        if taskText ==
            State.lastTask then

            return
        end

        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        processAreaTask(
            taskText
        )

        return
    end

    --==================================================
    -- PLAYER PHOTO
    --==================================================

    if isPlayerPhotoTask(
        taskText
    ) then

        if taskText ==
            State.lastTask then

            return
        end

        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        processPlayerTask(
            taskText
        )

        State.processing = false

        return
    end

    --==================================================
    -- INVALID TASK
    --==================================================

    State.stopReason =
        "Invalid task: "
        .. tostring(taskText)

    restartUntilValidTask()
end

--==================================================
-- FARM LOOP
--==================================================

local farmLoopRunning = false

local function farmLoop()

    -- Prevent duplicate loops
    if farmLoopRunning then
        return
    end

    farmLoopRunning = true

    while State.farming do

        pcall(function()
            processTask()
        end)

        task.wait(
            S.RefreshRate
        )
    end

    setCollision(true)

    farmLoopRunning = false
end

--==================================================
-- START FARMING
--==================================================

local function startFarming()

    if State.farming then
        return
    end

    if not findRemotes() then

        State.stopReason =
            "PhotoJob remotes not found"

        updateGUI()

        return
    end

    State.farming = true
    State.processing = false
    State.tweening = false
    State.restarting = false

    State.lastTask = ""
    State.taskCount = 0
    State.restartCount = 0
    State.stopReason = ""

    State.targetPlayer = ""
    State.targetUsername = ""

    setCollision(true)

    updateGUI()

    -- Start job hanya saat ON
    startNewJob()

    task.wait(
        S.StartDelay
    )

    if not State.farming then
        return
    end

    task.spawn(
        farmLoop
    )
end

--==================================================
-- STOP FARMING
--==================================================

local function stopFarmingFromGUI()

    if not State.farming then
        updateGUI()
        return
    end

    -- Cancel movement
    cancelTween()

    -- Stop job
    stopCurrentJob()

    State.farming = false
    State.processing = false
    State.tweening = false
    State.restarting = false

    State.targetPlayer = ""
    State.targetUsername = ""

    State.stopReason =
        "Disabled from GUI"

    setCollision(true)

    updateGUI()
end

