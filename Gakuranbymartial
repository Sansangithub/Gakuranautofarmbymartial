local function stopCurrentJob()
    if not photoJobSubmit then
        return false
    end

    return pcall(function()
        photoJobSubmit:InvokeServer("Stop")
    end)
end

local function startNewJob()
    if not photoJobSubmit
        or not State.farming then
        return false
    end

    local now = os.clock()

    if now - State.lastStartRequest <
        S.StartCooldown then
        return false
    end

    State.lastStartRequest = now

    return pcall(function()
        photoJobSubmit:InvokeServer("Start")
    end)
end

local function waitForNewAssignment()
    local deadline = os.clock() + 3

    while State.farming
        and os.clock() < deadline do

        local text = getTaskText()

        if text
            and text ~= ""
            and not text:lower():find(
                "waiting for assignment",
                1,
                true
            ) then

            return text
        end

        task.wait(S.AssignmentWait)
    end

    return nil
end

