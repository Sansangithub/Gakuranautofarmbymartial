--==================================================
-- PHOTO PREFIX DETECTION
--==================================================

local PHOTO_PREFIXES = {
    "get a photo of ",
    "take a photo of ",
    "take photo of ",
    "a photo of ",
    "photo of ",
    "photograph of ",
    "photograph ",
    "get a picture of ",
    "take a picture of ",
    "take picture of ",
    "picture of ",
}

local function getPhotoTargetText(taskText)

    if not taskText then
        return nil
    end

    local text = tostring(taskText)
    local lower = text:lower()

    for _, prefix in ipairs(PHOTO_PREFIXES) do

        if lower:sub(
            1,
            #prefix
        ) == prefix then

            local target =
                text:sub(
                    #prefix + 1
                )

            target =
                normalizePlayerName(
                    target
                )

            if target ~= "" then
                return target
            end
        end
    end

    return nil
end

--==================================================
-- FIND MODEL FROM INFO LABEL
--==================================================

local function findModelFromInfo(info)

    if not info then
        return nil
    end

    local current =
        info.Parent

    while current do

        if current:IsA("Model") then
            return current
        end

        current =
            current.Parent
    end

    return nil
end

--==================================================
-- MATCH INFO TEXT
--==================================================

local function infoMatchesTarget(
    infoText,
    targetText,
    player
)

    if not infoText
        or not targetText then

        return false
    end

    local info =
        tostring(infoText):lower()

    local target =
        tostring(targetText):lower()

    if info == target then
        return true
    end

    if info:find(
        target,
        1,
        true
    ) then

        return true
    end

    if player then

        local username =
            player.Name:lower()

        local displayName =
            player.DisplayName:lower()

        if info:find(
            username,
            1,
            true
        ) then

            return true
        end

        if info:find(
            displayName,
            1,
            true
        ) then

            return true
        end
    end

    return false
end

--==================================================
-- FIND REAL PLAYER FROM MODEL
--==================================================

local function getRealPlayerFromModel(model)

    if not model then
        return nil
    end

    local player =
        Players:GetPlayerFromCharacter(
            model
        )

    if player then
        return player
    end

    local modelName =
        tostring(model.Name):lower()

    for _, candidate in ipairs(
        Players:GetPlayers()
    ) do

        if candidate.Name:lower()
            == modelName then

            return candidate
        end
    end

    return nil
end

--==================================================
-- FIND PLAYER USING INFO
--==================================================

local function findPlayerByInfo(
    targetText
)

    if not targetText then
        return nil, nil, nil
    end

    local target =
        normalizePlayerName(
            targetText
        )

    if target == "" then
        return nil, nil, nil
    end

    local targetLower =
        target:lower()

    --==================================================
    -- PASS 1
    -- CURRENT PLAYER CHARACTERS
    --==================================================

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            local character =
                player.Character

            if character then

                local info =
                    character:FindFirstChild(
                        "Info",
                        true
                    )

                if info
                    and info:IsA(
                        "TextLabel"
                    ) then

                    if infoMatchesTarget(
                        info.Text,
                        target,
                        player
                    ) then

                        local playerHRP =
                            character:FindFirstChild(
                                "HumanoidRootPart"
                            )

                        if playerHRP then

                            return player,
                                character,
                                playerHRP.Position
                        end
                    end
                end
            end
        end
    end

    --==================================================
    -- PASS 2
    -- WORKSPACE INFO SCAN
    --==================================================

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do

        if object:IsA("TextLabel")
            and object.Name == "Info" then

            local infoText =
                tostring(
                    object.Text or ""
                )

            if infoText ~= "" then

                local model =
                    findModelFromInfo(
                        object
                    )

                if model then

                    local player =
                        getRealPlayerFromModel(
                            model
                        )

                    if player
                        and player ~= LocalPlayer then

                        if infoMatchesTarget(
                            infoText,
                            target,
                            player
                        ) then

                            local playerHRP =
                                model:FindFirstChild(
                                    "HumanoidRootPart"
                                )

                            if playerHRP then

                                return player,
                                    model,
                                    playerHRP.Position
                            end
                        end
                    end
                end
            end
        end
    end

    --==================================================
    -- PASS 3
    -- REAL USERNAME / DISPLAY NAME
    --==================================================

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            if player.Name:lower()
                == targetLower

                or player.DisplayName:lower()
                == targetLower then

                local character =
                    player.Character

                if character then

                    local playerHRP =
                        character:FindFirstChild(
                            "HumanoidRootPart"
                        )

                    if playerHRP then

                        return player,
                            character,
                            playerHRP.Position
                    end
                end
            end
        end
    end

    return nil, nil, nil
end

--==================================================
-- RESOLVE AREA
--==================================================

local function resolveArea(taskText)

    local normalized =
        normalizeText(taskText)

    if normalized == "" then
        return nil
    end

    for _, entry in ipairs(
        AREA_TASKS
    ) do

        local canonical =
            entry.canonical:lower()

        if normalized == canonical then
            return entry.canonical
        end

        if normalized:find(
            canonical,
            1,
            true
        ) then

            return entry.canonical
        end

        for _, alias in ipairs(
            entry.aliases
        ) do

            alias =
                alias:lower()

            if normalized == alias then
                return entry.canonical
            end

            if normalized:find(
                alias,
                1,
                true
            ) then

                return entry.canonical
            end
        end
    end

    return nil
end

--==================================================
-- DETERMINE PLAYER PHOTO TASK
--==================================================

local function isRealPlayerPhotoTask(taskText)

    local targetText =
        getPhotoTargetText(
            taskText
        )

    if not targetText then
        return false
    end

    local area =
        resolveArea(taskText)

    if area then
        return false
    end

    local player =
        findPlayerByInfo(
            targetText
        )

    if player then
        return true
    end

    return false
end

