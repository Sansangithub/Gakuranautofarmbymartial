local function fetchServersPage(placeId, cursor)
	local url = string.format(
		"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
		placeId,
		cursor and cursor ~= "" and ("&cursor=" .. HttpService:UrlEncode(cursor)) or ""
	)

	local rawBody = nil
	local reqFunc = (typeof(request) == "function" and request)
		or (typeof(http_request) == "function" and http_request)
		or (typeof(syn) == "table" and typeof(syn.request) == "function" and syn.request)

	if reqFunc then
		local ok, res = pcall(reqFunc, { Url = url, Method = "GET" })
		if ok and type(res) == "table" and type(res.Body) == "string" then
			rawBody = res.Body
		end
	end

	if not rawBody then
		local ok, body = pcall(function()
			return game:HttpGet(url)
		end)
		if ok and type(body) == "string" then
			rawBody = body
		end
	end

	if not rawBody then
		return nil
	end

	local okDecode, decoded = pcall(function()
		return HttpService:JSONDecode(rawBody)
	end)
	if okDecode and type(decoded) == "table" then
		return decoded
	end
	return nil
end

