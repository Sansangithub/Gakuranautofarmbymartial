--==================================================
-- PHOTO PREFIX
--==================================================

local PHOTO_PREFIXES = {
    "get a photo of ",
    "take a photo of ",
    "take photo of ",
    "a photo of ",
    "photo of ",
    "photograph of ",
    "photograph ",
    "get a picture of ",
    "take a picture of ",
    "take picture of ",
    "picture of ",
}

local function getPhotoTargetText(taskText)

    if not taskText then
        return nil
    end

    local text =
        tostring(taskText)

    local lower =
        text:lower()

    for _, prefix in ipairs(
        PHOTO_PREFIXES
    ) do

        if lower:sub(
            1,
            #prefix
        ) == prefix then

            local target =
                text:sub(
                    #prefix + 1
                )

            target =
                normalizePlayerName(
                    target
                )

            if target ~= "" then
                return target
            end
        end
    end

    return nil
end

