-- START FARMING
--==================================================

startFarming = function()

    if State.farming then
        return
    end

    if not findRemotes() then

        State.stopReason =
            "PhotoJob remotes not found"

        updateGUI()

        return
    end

    State.farming = true

    State.processing = false
    State.tweening = false
    State.restarting = false

    State.lastTask = ""

    State.taskCount = 0
    State.restartCount = 0

    State.stopReason = ""

    State.targetPlayer = ""
    State.targetUsername = ""

    setCollision(true)

    --==================================================
    -- FLY
    --==================================================

    if S.FlyEnabled then
        startFly()
    end

    updateGUI()

    --==================================================
    -- START JOB
    --==================================================

    startNewJob()

    task.wait(
        S.StartDelay
    )

    if not State.farming then
        return
    end

    task.spawn(
        farmLoop
    )
end

--==================================================
-- STOP FARMING
--==================================================

stopFarmingFromGUI = function()

    if not State.farming then

        stopFly()

        updateGUI()

        return
    end

    cancelTween()

    stopFly()

    stopCurrentJob()

    State.farming = false

    State.processing = false
    State.tweening = false
    State.restarting = false

    State.targetPlayer = ""
    State.targetUsername = ""

    State.stopReason =
        "Disabled from GUI"

    setCollision(true)

    updateGUI()
end

