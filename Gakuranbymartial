--==================================================
-- CHARACTER
--==================================================

local function bindCharacter(character)

    Character = character

    HRP =
        character:WaitForChild(
            "HumanoidRootPart",
            10
        )

    Humanoid =
        character:WaitForChild(
            "Humanoid",
            10
        )

    if not HRP then
        return
    end

    for _, object in ipairs(
        character:GetDescendants()
    ) do

        if object:IsA("BasePart") then
            object.CanCollide = true
        end

    end

    if State.farming
        and S.FlyEnabled then

        task.wait(0.2)

        if State.farming then
            startFly()
        end
    end
end

