local PhotoBuffer

local function createPhotoBuffer()
    local ok, result =
        pcall(function()
            local data =
                buffer.create(7)

            buffer.writeu8(
                data, 0, 1
            )

            buffer.writeu8(
                data, 1, 4
            )

            buffer.writeu8(
                data, 2, 0
            )

            buffer.writeu8(
                data, 3, 1
            )

            buffer.writeu8(
                data, 4, 1
            )

            buffer.writeu8(
                data, 5, 42
            )

            buffer.writeu8(
                data, 6, 24
            )

            return data
        end)

    if ok then
        return result
    end

    return nil
end

PhotoBuffer =
    createPhotoBuffer()

--==================================================
-- TARGET ROOT
--==================================================

local function getTargetRoot(player)
    if not player
        or not player.Parent then

        return nil
    end

    local character =
        player.Character

    if not character
        or not character.Parent then

        return nil
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not humanoid
        or humanoid.Health <= 0
        or not root then

        return nil
    end

    return root
end

--==================================================
-- BEST PHOTO POSITION
--==================================================

local function getBestPhotoPosition(player)
    local targetHRP =
        getTargetRoot(player)

    if not targetHRP then
        return nil
    end

    local targetPosition =
        targetHRP.Position

    local targetLook =
        targetHRP.CFrame.LookVector

    local targetRight =
        targetHRP.CFrame.RightVector

    local distance =
        S.PlayerPhotoDistance

    local height =
        S.PlayerPhotoHeight

    local candidates = {
        targetPosition
            - targetLook * distance
            + Vector3.new(0, height, 0),

        targetPosition
            + targetLook * distance
            + Vector3.new(0, height, 0),

        targetPosition
            - targetRight * distance
            + Vector3.new(0, height, 0),

        targetPosition
            + targetRight * distance
            + Vector3.new(0, height, 0)
    }

    local bestPosition
    local bestScore =
        math.huge

    for index, position in ipairs(
        candidates
    ) do
        local distanceFromTarget =
            (position - targetPosition).Magnitude

        if distanceFromTarget <=
            S.PhotoTargetMaxDistance then

            local direction =
                position - targetPosition

            local facingScore = 0

            if direction.Magnitude > 0 then
                facingScore =
                    math.abs(
                        direction.Unit:Dot(
                            targetLook
                        )
                    )
            end

            local score =
                distanceFromTarget
                - facingScore * 0.35

            score += index * 0.001

            if score < bestScore then
                bestScore = score
                bestPosition = position
            end
        end
    end

    if not bestPosition then
        return nil
    end

    return {
        position = bestPosition,
        target = targetPosition
    }
end

--==================================================
-- FAST TELEPORT
--==================================================

local function fastTeleportToPosition(
    position,
    targetPosition
)
    if not HRP
        or not HRP.Parent
        or not State.farming then

        return false
    end

    local destination =
        CFrame.lookAt(
            position,
            targetPosition
        )

    setCollision(false)

    HRP.AssemblyLinearVelocity =
        Vector3.zero

    HRP.AssemblyAngularVelocity =
        Vector3.zero

    for attempt = 1,
        S.FastTeleportAttempts do

        if not State.farming then
            setCollision(true)
            return false
        end

        State.teleportAttempts += 1

        pcall(function()
            if Character
                and Character.Parent then

                Character:PivotTo(
                    destination
                )
            end
        end)

        if HRP
            and HRP.Parent then

            pcall(function()
                HRP.CFrame =
                    destination
            end)

            HRP.AssemblyLinearVelocity =
                Vector3.zero

            HRP.AssemblyAngularVelocity =
                Vector3.zero
        end

        if S.FastTeleportDelay > 0 then
            task.wait(
                S.FastTeleportDelay
            )
        else
            RunService.Heartbeat:Wait()
        end

        if HRP
            and HRP.Parent then

            local distance =
                (
                    HRP.Position
                    - position
                ).Magnitude

            if distance <=
                S.PhotoPositionTolerance then

                pcall(function()
                    HRP.CFrame =
                        CFrame.lookAt(
                            HRP.Position,
                            targetPosition
                        )
                end)

                setCollision(true)

                return true
            end
        end
    end

    setCollision(true)

    return false
end

--==================================================
-- TELEPORT PLAYER
--==================================================

local function teleportToPlayer(
    targetPlayer
)
    if not targetPlayer
        or not targetPlayer.Parent
        or not HRP
        or not HRP.Parent then

        return false
    end

    local photoSpot =
        getBestPhotoPosition(
            targetPlayer
        )

    if not photoSpot then
        return false
    end

    for _ = 1,
        S.TeleportRetryCount do

        if not State.farming then
            return false
        end

        local success =
            fastTeleportToPosition(
                photoSpot.position,
                photoSpot.target
            )

        if success then
            local targetHRP =
                getTargetRoot(
                    targetPlayer
                )

            if targetHRP then
                local targetDistance =
                    (
                        targetHRP.Position
                        - photoSpot.target
                    ).Magnitude

                if targetDistance <=
                    S.TargetMoveTolerance then

                    return true
                end
            end

            -- TARGET MOVED:
            -- recalculate immediately
            photoSpot =
                getBestPhotoPosition(
                    targetPlayer
                )

            if not photoSpot then
                return false
            end
        end

        if S.TeleportRetryDelay > 0 then
            task.wait(
                S.TeleportRetryDelay
            )
        end
    end

    return false
end

--==================================================
-- STABLE PHOTO TARGET
--==================================================

local function getStablePhotoTarget(player)
    if not player
        or not player.Parent then

        return nil
    end

    local targetHRP =
        getTargetRoot(player)

    if not targetHRP then
        return nil
    end

    if not HRP
        or not HRP.Parent then

        return nil
    end

    local targetPosition =
        targetHRP.Position

    local distance =
        (
            HRP.Position
            - targetPosition
        ).Magnitude

    if distance >
        S.PhotoTargetMaxDistance then

        return nil
    end

    return targetPosition
end

--==================================================
-- TAKE PHOTO
--==================================================

local function takePhoto(
    targetPosition,
    previousTask
)
    if not State.farming
        or not phoneScreenPush
        or not photoJobSubmit
        or not HRP
        or not HRP.Parent then

        return false
    end

    if not PhotoBuffer then
        PhotoBuffer =
            createPhotoBuffer()

        if not PhotoBuffer then
            return false
        end
    end

    if not targetPosition then
        return false
    end

    for attempt = 1,
        S.PhotoRetryCount do

        if not State.farming then
            return false
        end

        State.photoAttempts += 1

        -- RE-READ TARGET POSITION
        local currentTarget =
            targetPosition

        local distance =
            (
                HRP.Position
                - currentTarget
            ).Magnitude

        if distance >
            S.PhotoTargetMaxDistance then

            return false
        end

        -- HARD FACE TARGET
        local photoPosition =
            HRP.Position

        local photoCFrame =
            CFrame.lookAt(
                photoPosition,
                currentTarget
            )

        pcall(function()
            HRP.CFrame =
                photoCFrame
        end)

        if S.PhotoPositionWait > 0 then
            task.wait(
                S.PhotoPositionWait
            )
        end

        -- PHONE DATA
        local pushOK =
            pcall(
                phoneScreenPush.FireServer,
                phoneScreenPush,
                PhotoBuffer
            )

        if pushOK then
            local invokeOK,
                serverResult =
                pcall(
                    photoJobSubmit.InvokeServer,
                    photoJobSubmit,
                    "Submit",
                    photoCFrame
                )

            if invokeOK then
                if serverResult == true then
                    return true
                end

                if serverResult ~= false then
                    if waitForPhotoResult(
                        previousTask
                    ) then
                        return true
                    end
                end

                if waitForPhotoResult(
                    previousTask
                ) then
                    return true
                end
            end
        end

        if attempt <
            S.PhotoRetryCount then

            if S.PhotoRetryDelay > 0 then
                task.wait(
                    S.PhotoRetryDelay
                )
            else
                RunService.Heartbeat:Wait()
            end
        end
    end

    return false
end

--==================================================
-- PLAYER TASK
--==================================================

local function processPlayerTask(
    taskText
)
    local target =
        findPlayerTarget(
            taskText
        )

    if not target then
        stopPlayerView()
        return false
    end

    local player =
        target.player

    State.targetUsername =
        player.Name

    -- AUTO ;VIEW
    if S.AutoViewCommandEnabled then
        sendViewCommand(
            player.Name
        )

        if S.AutoViewCommandDelay > 0 then
            task.wait(
                S.AutoViewCommandDelay
            )
        end
    end

    if not State.farming then
        return false
    end

    --================================================
    -- TELEPORT
    --================================================

    local teleportSuccess =
        teleportToPlayer(
            player
        )

    if not teleportSuccess then
        setCollision(true)
        stopPlayerView()
        return false
    end

    if not State.farming then
        return false
    end

    --================================================
    -- TARGET VALIDATION
    --================================================

    local targetPosition =
        getStablePhotoTarget(
            player
        )

    if not targetPosition then
        setCollision(true)
        stopPlayerView()
        return false
    end

    --================================================
    -- TARGET MOVEMENT CHECK
    --================================================

    local targetHRP =
        getTargetRoot(
            player
        )

    if not targetHRP then
        setCollision(true)
        return false
    end

    local latestPosition =
        targetHRP.Position

    local targetShift =
        (
            latestPosition
            - targetPosition
        ).Magnitude

    if targetShift >
        S.TargetMoveTolerance then

        local reposition =
            teleportToPlayer(
                player
            )

        if not reposition then
            setCollision(true)
            return false
        end

        targetHRP =
            getTargetRoot(
                player
            )

        if not targetHRP then
            setCollision(true)
            return false
        end

        targetPosition =
            targetHRP.Position
    else
        targetPosition =
            latestPosition
    end

    --================================================
    -- PHOTO
    --================================================

    local success =
        takePhoto(
            targetPosition,
            taskText
        )

    setCollision(true)
    stopPlayerView()

    if success then
        State.lastTask = ""
        State.processing = false

        State.targetPlayer = ""
        State.targetUsername = ""

        if S.SuccessDelay > 0 then
            task.wait(
                S.SuccessDelay
            )
        end

        return true
    end

    return false
end

--==================================================
-- AREA TASK
--==================================================

local function processAreaTask(
    taskText
)
    stopPlayerView()

    local position =
        findLocation(
            taskText
        )

    if not position then
        return false
    end

    if not smoothTween(
        position
    ) then
        return false
    end

    if not State.farming then
        return false
    end

    -- FACE AREA / STABILIZE
    if HRP and HRP.Parent then
        HRP.CFrame =
            CFrame.new(position)
    end

    local success =
        takePhoto(
            position,
            taskText
        )

    setCollision(true)

    State.processing = false

    if success then
        State.lastTask = ""

        if S.SuccessDelay > 0 then
            task.wait(
                S.SuccessDelay
            )
        end

        return true
    end

    return false
end

--==================================================
-- PLAYER TASK CHECK
--==================================================

local function isPlayerPhotoTask(
    taskText
)
    local target =
        getPhotoTargetText(
            taskText
        )

    if not target then
        return false
    end

    if resolveArea(taskText) then
        return false
    end

    return
        getPlayerByText(target) ~= nil
        or findPlayerByInfo(target) ~= nil
end

--==================================================
-- RESTART INVALID TASK
--==================================================

local function restartUntilValidTask()
    if not State.farming
        or State.restarting then

        return false
    end

    State.restarting = true

    stopPlayerView()
    cancelTween()
    setCollision(true)

    for _ = 1, 20 do
        if not State.farming then
            break
        end

        stopCurrentJob()

        if S.RestartDelay > 0 then
            task.wait(
                S.RestartDelay
            )
        end

        if not State.farming then
            break
        end

        startNewJob()

        local taskText =
            waitForNewAssignment()

        if taskText then
            if isRejectedTask(
                taskText
            ) then

                State.restartCount += 1
                continue
            end

            if isPlayerPhotoTask(
                taskText
            ) then

                local target =
                    findPlayerTarget(
                        taskText
                    )

                if target then
                    State.lastTask = ""
                    State.restarting = false

                    return true
                end

            elseif resolveArea(
                taskText
            ) then

                State.lastTask = ""
                State.restarting = false

                return true
            end
        end

        State.restartCount += 1
    end

    State.restarting = false

    return false
end

--==================================================
-- PROCESS TASK
--==================================================

local function processTask()
    if not State.farming
        or State.processing
        or State.restarting then

        return
    end

    local taskText =
        getTaskText()

    if not taskText
        or taskText == "" then

        startNewJob()
        return
    end

    local lower =
        taskText:lower()

    -- WAITING
    if lower:find(
        "waiting for assignment",
        1,
        true
    ) then

        startNewJob()
        return
    end

    -- MUSIC ROOM
    if isRejectedTask(
        taskText
    ) then

        State.stopReason =
            "Music Room -> reroll"

        restartUntilValidTask()

        return
    end

    --================================================
    -- AREA
    --================================================

    if resolveArea(
        taskText
    ) then

        if State.lastTask ==
            taskText then

            return
        end

        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        local success =
            processAreaTask(
                taskText
            )

        State.processing = false

        if not success then
            State.stopReason =
                "Area photo failed"

            State.lastTask = ""

            if S.PhotoRetryDelay > 0 then
                task.wait(
                    S.PhotoRetryDelay
                )
            end

            restartUntilValidTask()
        end

        return
    end

    --================================================
    -- PLAYER
    --================================================

    if isPlayerPhotoTask(
        taskText
    ) then

        if State.lastTask ==
            taskText then

            return
        end

        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        local success =
            processPlayerTask(
                taskText
            )

        State.processing = false

        if not success then
            State.stopReason =
                "Player photo failed"

            State.lastTask = ""

            if S.PhotoRetryDelay > 0 then
                task.wait(
                    S.PhotoRetryDelay
                )
            end

            restartUntilValidTask()
        end

        return
    end

    --================================================
    -- INVALID
    --================================================

    State.stopReason =
        "Invalid task: "
        .. tostring(taskText)

    restartUntilValidTask()
end

--==================================================
-- FARM LOOP
--==================================================

local function farmLoop()
    if farmLoopRunning then
        return
    end

    farmLoopRunning = true

    while State.farming do
        pcall(
            processTask
        )

        if S.RefreshRate > 0 then
            task.wait(
                S.RefreshRate
            )
        else
            RunService.Heartbeat:Wait()
        end
    end

    setCollision(true)
    stopPlayerView()

    farmLoopRunning = false
end

--==================================================
-- START FARMING
--==================================================

startFarming = function()
    if State.farming then
        return
    end

    if not findRemotes() then
        State.stopReason =
            "PhotoJob remotes not found"

        updateGUI()
        return
    end

    State.farming = true
    State.processing = false
    State.tweening = false
    State.restarting = false

    State.lastTask = ""
    State.taskCount = 0
    State.restartCount = 0

    State.stopReason = ""

    State.targetPlayer = ""
    State.targetUsername = ""

    State.lastStartRequest = 0
    State.photoAttempts = 0
    State.teleportAttempts = 0

    State.lastTaskRead = ""

    stopPlayerView()
    setCollision(true)

    refreshAreaCache()

    if S.FlyEnabled then
        startFly()
    end

    updateGUI()

    task.spawn(
        farmLoop
    )
end

--==================================================
-- STOP FARMING
--==================================================

stopFarmingFromGUI = function()
    if not State.farming then
        stopPlayerView()
        stopFly()

        updateGUI()
        return
    end

    State.farming = false

    cancelTween()
    stopPlayerView()
    stopFly()
    stopCurrentJob()

    State.processing = false
    State.tweening = false
    State.restarting = false

    State.targetPlayer = ""
    State.targetUsername = ""

    State.lastViewCommand = ""

    State.stopReason =
        "Disabled from GUI"

    setCollision(true)

    updateGUI()
end

