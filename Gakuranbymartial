--==================================================
-- PHOTO PREFIXES
--==================================================

local PHOTO_PREFIXES = {

    "get a photo of ",
    "take a photo of ",
    "take photo of ",
    "a photo of ",
    "photo of ",
    "photograph of ",
    "photograph ",
    "get a picture of ",
    "take a picture of ",
    "take picture of ",
    "picture of ",
}

local function getPhotoTargetText(taskText)

    if not taskText then
        return nil
    end

    local text =
        tostring(taskText)

    local lower =
        text:lower()

    for _, prefix in ipairs(
        PHOTO_PREFIXES
    ) do

        if lower:sub(
            1,
            #prefix
        ) == prefix then

            local target =
                text:sub(
                    #prefix + 1
                )

            target =
                normalizePlayerName(
                    target
                )

            if target ~= "" then
                return target
            end
        end
    end

    return nil
end

--==================================================
-- INFO MATCH
--==================================================

local function infoMatchesTarget(
    infoText,
    targetText,
    player
)

    if not infoText
        or not targetText then

        return false
    end

    local info =
        tostring(infoText):lower()

    local target =
        tostring(targetText):lower()

    if info == target then
        return true
    end

    if info:find(
        target,
        1,
        true
    ) then

        return true
    end

    if player then

        local username =
            player.Name:lower()

        local displayName =
            player.DisplayName:lower()

        if info:find(
            username,
            1,
            true
        ) then

            return true
        end

        if info:find(
            displayName,
            1,
            true
        ) then

            return true
        end
    end

    return false
end

--==================================================
-- GET PLAYER BY TEXT
--==================================================

local function getPlayerByText(targetText)

    if not targetText then
        return nil
    end

    local target =
        normalizePlayerName(
            targetText
        )

    if target == "" then
        return nil
    end

    local lowerTarget =
        target:lower()

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
            and player.Name:lower()
                == lowerTarget then

            return player
        end
    end

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
            and player.DisplayName:lower()
                == lowerTarget then

            return player
        end
    end

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            if player.Name:lower():find(
                lowerTarget,
                1,
                true
            )

            or player.DisplayName:lower():find(
                lowerTarget,
                1,
                true
            ) then

                return player
            end
        end
    end

    return nil
end

--==================================================
-- GET MODEL FROM INFO
--==================================================

local function getModelFromInfo(info)

    if not info then
        return nil
    end

    local current =
        info.Parent

    while current do

        if current:IsA("Model") then
            return current
        end

        current =
            current.Parent
    end

    return nil
end

--==================================================
-- REAL PLAYER FROM MODEL
--==================================================

local function getRealPlayerFromModel(model)

    if not model then
        return nil
    end

    local player =
        Players:GetPlayerFromCharacter(
            model
        )

    if player then
        return player
    end

    local modelName =
        tostring(model.Name):lower()

    for _, candidate in ipairs(
        Players:GetPlayers()
    ) do

        if candidate ~= LocalPlayer
            and candidate.Name:lower()
                == modelName then

            return candidate
        end
    end

    return nil
end

--==================================================
-- FIND PLAYER BY INFO
--==================================================

local function findPlayerByInfo(
    targetText
)

    if not targetText then
        return nil, nil, nil
    end

    local target =
        normalizePlayerName(
            targetText
        )

    if target == "" then
        return nil, nil, nil
    end

    --==================================================
    -- CHARACTER INFO
    --==================================================

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            local character =
                player.Character

            if character then

                local info =
                    character:FindFirstChild(
                        "Info",
                        true
                    )

                if info
                    and info:IsA("TextLabel")
                    and infoMatchesTarget(
                        info.Text,
                        target,
                        player
                    ) then

                    local playerHRP =
                        character:FindFirstChild(
                            "HumanoidRootPart"
                        )

                    if playerHRP then

                        return
                            player,
                            character,
                            playerHRP.Position
                    end
                end
            end
        end
    end

    --==================================================
    -- WORKSPACE INFO
    --==================================================

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do

        if object:IsA("TextLabel")
            and object.Name == "Info" then

            local infoText =
                tostring(
                    object.Text or ""
                )

            if infoText ~= "" then

                local model =
                    getModelFromInfo(
                        object
                    )

                if model then

                    local player =
                        getRealPlayerFromModel(
                            model
                        )

                    if player
                        and player ~= LocalPlayer
                        and infoMatchesTarget(
                            infoText,
                            target,
                            player
                        ) then

                        local playerHRP =
                            model:FindFirstChild(
                                "HumanoidRootPart"
                            )

                        if playerHRP then

                            return
                                player,
                                model,
                                playerHRP.Position
                        end
                    end
                end
            end
        end
    end

    --==================================================
    -- DIRECT PLAYER SEARCH
    --==================================================

    local directPlayer =
        getPlayerByText(
            target
        )

    if directPlayer then

        local character =
            directPlayer.Character

        if character then

            local playerHRP =
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if playerHRP then

                return
                    directPlayer,
                    character,
                    playerHRP.Position
            end
        end
    end

    return nil, nil, nil
end

--==================================================
-- FIND PLAYER TARGET
--==================================================

local function findPlayerTarget(
    taskText
)

    local requestedName =
        getPhotoTargetText(
            taskText
        )

    if not requestedName then
        return nil
    end

    State.targetPlayer =
        requestedName

    for attempt = 1,
        S.PlayerSearchAttempts do

        if not State.farming then
            return nil
        end

        local currentTask =
            getTaskText()

        if currentTask
            and currentTask ~= ""
            and currentTask ~= taskText then

            return nil
        end

        local player,
            character,
            position =
            findPlayerByInfo(
                requestedName
            )

        if player then

            character =
                player.Character

            if character then

                local playerHRP =
                    character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if playerHRP then

                    State.targetUsername =
                        player.Name

                    return {

                        player = player,

                        character =
                            character,

                        position =
                            playerHRP.Position,

                        username =
                            player.Name,

                        displayName =
                            player.DisplayName,
                    }
                end
            end
        end

        task.wait(
            S.PlayerSearchDelay
        )
    end

    return nil
end

--==================================================
-- RESOLVE AREA
--==================================================

local function resolveArea(taskText)

    local normalized =
        normalizeText(
            taskText
        )

    if normalized == "" then
        return nil
    end

    for _, entry in ipairs(
        AREA_TASKS
    ) do

        local canonical =
            entry.canonical:lower()

        if normalized == canonical then
            return entry.canonical
        end

        if normalized:find(
            canonical,
            1,
            true
        ) then

            return entry.canonical
        end

        for _, alias in ipairs(
            entry.aliases
        ) do

            alias =
                alias:lower()

            if normalized == alias then
                return entry.canonical
            end

            if normalized:find(
                alias,
                1,
                true
            ) then

                return entry.canonical
            end
        end
    end

    return nil
end

--==================================================
-- WHITELIST
--==================================================

local function isWhitelistedTask(
    taskText
)

    if not taskText then
        return false
    end

    local target =
        getPhotoTargetText(
            taskText
        )

    if target then

        local player =
            getPlayerByText(
                target
            )

        if player then
            return true
        end

        local found =
            findPlayerByInfo(
                target
            )

        if found then
            return true
        end
    end

    return
        resolveArea(taskText)
        ~= nil
end

--==================================================
-- PLAYER PHOTO TASK
--==================================================

local function isPlayerPhotoTask(
    taskText
)

    if not taskText then
        return false
    end

    if resolveArea(taskText) then
        return false
    end

    local target =
        getPhotoTargetText(
            taskText
        )

    if not target then
        return false
    end

    local player =
        getPlayerByText(
            target
        )

    if player then
        return true
    end

    local found =
        findPlayerByInfo(
            target
        )

    return found ~= nil
end

--==================================================
-- MUSIC ROOM
--==================================================

local function isRejectedTask(
    taskText
)

    if not taskText then
        return false
    end

    return
        resolveArea(taskText)
        == "Music Room"
end

