local function getModelFromInfo(info)

    if not info then
        return nil
    end

    local current =
        info.Parent

    while current do

        if current:IsA("Model") then
            return current
        end

        current =
            current.Parent
    end

    return nil
end

--==================================================
-- REAL PLAYER FROM MODEL
--==================================================

local function getRealPlayerFromModel(model)

    if not model then
        return nil
    end

    local player =
        Players:GetPlayerFromCharacter(
            model
        )

    if player then
        return player
    end

    local modelName =
        tostring(
            model.Name
        ):lower()

    for _, candidate in ipairs(
        Players:GetPlayers()
    ) do

        if candidate ~= LocalPlayer
            and
            candidate.Name:lower()
                == modelName then

            return candidate
        end
    end

    return nil
end

--==================================================
-- FIND PLAYER BY INFO
--==================================================

local function findPlayerByInfo(targetText)

    if not targetText then
        return nil, nil, nil
    end

    local target =
        normalizePlayerName(
            targetText
        )

    if target == "" then
        return nil, nil, nil
    end

    -- PASS 1
    -- CHARACTER

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            local character =
                player.Character

            if character then

                local info =
                    character:FindFirstChild(
                        "Info",
                        true
                    )

                if info
                    and
                    info:IsA("TextLabel")
                    and
                    infoMatchesTarget(
                        info.Text,
                        target,
                        player
                    ) then

                    local playerHRP =
                        character:FindFirstChild(
                            "HumanoidRootPart"
                        )

                    if playerHRP then

                        return
                            player,
                            character,
                            playerHRP.Position
                    end
                end
            end
        end
    end

    -- PASS 2
    -- WORKSPACE

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do

        if object:IsA("TextLabel")
            and
            object.Name == "Info" then

            local infoText =
                tostring(
                    object.Text or ""
                )

            if infoText ~= "" then

                local model =
                    getModelFromInfo(
                        object
                    )

                if model then

                    local player =
                        getRealPlayerFromModel(
                            model
                        )

                    if player
                        and
                        player ~= LocalPlayer
                        and
                        infoMatchesTarget(
                            infoText,
                            target,
                            player
                        ) then

                        local playerHRP =
                            model:FindFirstChild(
                                "HumanoidRootPart"
                            )

                        if playerHRP then

                            return
                                player,
                                model,
                                playerHRP.Position
                        end
                    end
                end
            end
        end
    end

    -- PASS 3
    -- PLAYER LIST

    local directPlayer =
        getPlayerByText(
            target
        )

    if directPlayer then

        local character =
            directPlayer.Character

        if character then

            local playerHRP =
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if playerHRP then

                return
                    directPlayer,
                    character,
                    playerHRP.Position
            end
        end
    end

    return nil, nil, nil
end

--==================================================
-- FIND PLAYER BODY
--==================================================

local function findPlayerBody(targetText)

    if not targetText then
        return nil
    end

    local requestedName =
        normalizePlayerName(
            targetText
        )

    if requestedName == "" then
        return nil
    end

    --==================================================
    -- FIRST: PLAYER LIST
    --==================================================

    local player =
        getPlayerByText(
            requestedName
        )

    if player then

        local character =
            player.Character

        if character then

            local humanoid =
                character:FindFirstChildOfClass(
                    "Humanoid"
                )

            local targetHRP =
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if humanoid
                and
                targetHRP
                and
                humanoid.Health > 0 then

                return {

                    player = player,

                    character = character,

                    humanoid = humanoid,

                    hrp = targetHRP,

                    username =
                        player.Name,

                    displayName =
                        player.DisplayName,
                }
            end
        end
    end

    --==================================================
    -- SECOND: INFO
    --==================================================

    local foundPlayer,
        foundCharacter =
        findPlayerByInfo(
            requestedName
        )

    if foundPlayer
        and
        foundCharacter then

        local humanoid =
            foundCharacter:FindFirstChildOfClass(
                "Humanoid"
            )

        local targetHRP =
            foundCharacter:FindFirstChild(
                "HumanoidRootPart"
            )

        if humanoid
            and
            targetHRP
            and
            humanoid.Health > 0 then

            return {

                player = foundPlayer,

                character =
                    foundCharacter,

                humanoid = humanoid,

                hrp = targetHRP,

                username =
                    foundPlayer.Name,

                displayName =
                    foundPlayer.DisplayName,
            }
        end
    end

    return nil
end

--==================================================
-- FIND PLAYER TARGET
--==================================================

local function findPlayerTarget(taskText)

    local requestedName =
        getPhotoTargetText(
            taskText
        )

    if not requestedName then
        return nil
    end

    State.targetPlayer =
        requestedName

    --==================================================
    -- SEARCH BODY
    --==================================================

    for attempt = 1,
        S.PlayerSearchAttempts do

        if not State.farming then
            return nil
        end

        -- Task berubah?
        local currentTask =
            getTaskText()

        if currentTask
            and
            currentTask ~= ""
            and
            currentTask ~= taskText then

            return nil
        end

        local target =
            findPlayerBody(
                requestedName
            )

        if target then

            State.targetUsername =
                target.username

            return target
        end

        task.wait(
            S.PlayerSearchDelay
        )
    end

    --==================================================
    -- BODY TIDAK DITEMUKAN
    --==================================================

    return nil
end

--==================================================
-- RESOLVE AREA
--==================================================

local function resolveArea(taskText)

    local normalized =
        normalizeText(
            taskText
        )

    if normalized == "" then
        return nil
    end

    for _, entry in ipairs(
        AREA_TASKS
    ) do

        local canonical =
            entry.canonical:lower()

        if normalized ==
            canonical then

            return entry.canonical
        end

        if normalized:find(
            canonical,
            1,
            true
        ) then

            return entry.canonical
        end

        for _, alias in ipairs(
            entry.aliases
        ) do

            alias =
                alias:lower()

            if normalized ==
                alias then

                return entry.canonical
            end

            if normalized:find(
                alias,
                1,
                true
            ) then

                return entry.canonical
            end
        end
    end

    return nil
end

--==================================================
-- PLAYER PHOTO TASK
--==================================================

local function isPlayerPhotoTask(taskText)

    if not taskText then
        return false
    end

    if resolveArea(taskText) then
        return false
    end

    local target =
        getPhotoTargetText(
            taskText
        )

    if not target then
        return false
    end

    return true
end

--==================================================
-- WHITELIST
--==================================================

local function isWhitelistedTask(taskText)

    if not taskText then
        return false
    end

    if isPlayerPhotoTask(
        taskText
    ) then

        return true
    end

    return resolveArea(
        taskText
    ) ~= nil
end

--==================================================
-- MUSIC
--==================================================

local function isRejectedTask(taskText)

    if not taskText then
        return false
    end

    return
        resolveArea(
            taskText
        )
        == "Music Room"
end

--==================================================
-- STOP JOB
--==================================================

local function stopCurrentJob()

    if not photoJobSubmit then
        return false
    end

    local success =
        pcall(
            function()

                photoJobSubmit:InvokeServer(
                    "Stop"
                )
            end
        )

    return success
end

--==================================================
-- START JOB
--==================================================

local function startNewJob()

    if not photoJobSubmit then
        return false
    end

    if not State.farming then
        return false
    end

    local success =
        pcall(
            function()

                photoJobSubmit:InvokeServer(
                    "Start"
                )
            end
        )

    return success
end

--==================================================
-- WAIT NEW ASSIGNMENT
--==================================================

local function waitForNewAssignment()

    local deadline =
        os.clock() + 5

    while
        State.farming
        and
        os.clock() < deadline do

        local taskText =
            getTaskText()

        if taskText
            and
            taskText ~= "" then

            local lower =
                taskText:lower()

            if not lower:find(
                "waiting for assignment",
                1,
                true
            ) then

                return taskText
            end
        end

        task.wait(
            S.AssignmentWait
        )
    end

    return nil
end

--==================================================
-- PLAYER NOT FOUND
--
-- STOP -> START -> NEW TASK
--==================================================

local function rerollWhenPlayerNotFound()

    if not State.farming then
        return false
    end

    if State.restarting then
        return false
    end

    State.restarting = true

    State.processing = false
    State.tweening = false

    State.stopReason =
        "Player body not found -> STOP -> START"

    State.targetPlayer = ""
    State.targetUsername = ""

    cancelTween()
    setCollision(true)

    --==================================================
    -- STOP CURRENT JOB
    --==================================================

    stopCurrentJob()

    State.restartCount += 1

    task.wait(
        S.RestartDelay
    )

    if not State.farming then

        State.restarting = false

        return false
    end

    --==================================================
    -- START NEW JOB
    --==================================================

    startNewJob()

    task.wait(
        S.StartDelay
    )

    if not State.farming then

        State.restarting = false

        return false
    end

    --==================================================
    -- WAIT NEW ASSIGNMENT
    --==================================================

    local newTask =
        waitForNewAssignment()

    if not State.farming then

        State.restarting = false

        return false
    end

    if not newTask then

        State.restarting = false

        return false
    end

    State.lastTask = ""

    State.targetPlayer = ""
    State.targetUsername = ""

    State.restarting = false

    return true
end

--==================================================
-- RESTART INVALID TASK
--==================================================

local function restartUntilValidTask()

    if not State.farming then
        return false
    end

    if State.restarting then
        return false
    end

    State.restarting = true

    State.processing = false
    State.tweening = false

    State.targetPlayer = ""
    State.targetUsername = ""

    cancelTween()
    setCollision(true)

    while State.farming do

        local taskText =
            getTaskText()

        if taskText
            and
            taskText ~= "" then

            local lower =
                taskText:lower()

            if not lower:find(
                "waiting for assignment",
                1,
                true
            ) then

                -- PLAYER

                if isPlayerPhotoTask(
                    taskText
                ) then

                    local target =
                        findPlayerTarget(
                            taskText
                        )

                    if target then

                        State.lastTask = ""

                        State.restarting =
                            false

                        return true
                    end

                -- AREA

                elseif isWhitelistedTask(
                    taskText
                )
                and
                not isRejectedTask(
                    taskText
                ) then

                    State.lastTask = ""

                    State.restarting =
                        false

                    return true
                end
            end
        end

        -- STOP

        stopCurrentJob()

        State.restartCount += 1

        task.wait(
            S.RestartDelay
        )

        if not State.farming then
            break
        end

        -- START

        startNewJob()

        task.wait(
            S.StartDelay
        )

        -- WAIT

        local newTask =
            waitForNewAssignment()

        if not newTask then
            continue
        end

        -- MUSIC

        if isRejectedTask(
            newTask
        ) then

            continue
        end

        -- PLAYER

        if isPlayerPhotoTask(
            newTask
        ) then

            local target =
                findPlayerTarget(
                    newTask
                )

            if target then

                State.lastTask = ""

                State.restarting =
                    false

                return true
            end

            -- BODY NOT FOUND
            -- LOOP STOP -> START

            continue

        elseif isWhitelistedTask(
            newTask
        ) then

            State.lastTask = ""

            State.restarting =
                false

            return true
        end
    end

    State.restarting = false

    return false
end

--==================================================
-- FIND AREA LOCATION
--==================================================

local function findLocation(taskText)

    local area =
        resolveArea(
            taskText
        )

    if not area then
        return nil
    end

    local searchTerms = {}

    table.insert(
        searchTerms,
        area:lower()
    )

    table.insert(
        searchTerms,
        normalizeText(
            taskText
        )
    )

    if area ==
        "GAKUMART" then

        table.insert(
            searchTerms,
            "gakumart"
        )

        table.insert(
            searchTerms,
            "gaku mart"
        )
    end

    if area ==
        "Rooftop" then

        table.insert(
            searchTerms,
            "rooftop"
        )

        table.insert(
            searchTerms,
            "roof"
        )
    end

    local bestPart
    local bestScore = 0

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            local objectName =
                object.Name:lower()

            for _, term in ipairs(
                searchTerms
            ) do

                if term ~= ""
                    and
                    objectName:find(
                        term,
                        1,
                        true
                    ) then

                    local score =
                        #term

                    if score >
                        bestScore then

                        bestScore =
                            score

                        bestPart =
                            object
                    end
                end
            end

            local landmark =
                object:FindFirstChild(
                    "PhotoJobLandmark"
                )

            if landmark
                and
                landmark:IsA(
                    "StringValue"
                ) then

                local value =
                    landmark.Value:lower()

                for _, term in ipairs(
                    searchTerms
                ) do

                    if term ~= ""
                        and
                        value:find(
                            term,
                            1,
                            true
                        ) then

                        local score =
                            #term + 100

                        if score >
                            bestScore then

                            bestScore =
                                score

                            bestPart =
                                object
                        end
                    end
                end
            end
        end
    end

    if bestPart then
        return bestPart.Position
    end

    return nil
end

--==================================================
-- AREA TWEEN
--==================================================

local function smoothTween(
    targetPosition
)

    if not HRP then
        return false
    end

    if not State.farming then
        return false
    end

    cancelTween()

    local startPosition =
        HRP.Position

    local distance =
        (
            targetPosition
            - startPosition
        ).Magnitude

    if distance <=
        S.MaxDistance then

        HRP.CFrame =
            CFrame.new(
                targetPosition
            )

        setCollision(true)

        return true
    end

    setCollision(false)

    State.tweening = true

    local duration =
        math.clamp(
            distance / S.TweenSpeed,
            S.MinDuration,
            S.MaxDuration
        )

    currentTween =
        TweenService:Create(

            HRP,

            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),

            {
                CFrame =
                    CFrame.new(
                        targetPosition
                    )
            }
        )

    currentTween:Play()

    local completed = false

    local connection =
        currentTween.Completed:Connect(
            function()

                completed = true
            end
        )

    while not completed do

        if not State.farming then

            connection:Disconnect()

            cancelTween()
            setCollision(true)

            return false
        end

        task.wait()
    end

    connection:Disconnect()

    currentTween = nil
    State.tweening = false

    setCollision(true)

    return true
end

--==================================================
-- FAST PHOTO
--==================================================

local function takePhoto(
    targetPosition
)

    if not State.farming then
        return false
    end

    if not phoneScreenPush
        or
        not photoJobSubmit
        or
        not HRP then

        return false
    end

    local bufferData =
        buffer.create(7)

    buffer.writeu8(
        bufferData,
        0,
        1
    )

    buffer.writeu8(
        bufferData,
        1,
        4
    )

    buffer.writeu8(
        bufferData,
        2,
        0
    )

    buffer.writeu8(
        bufferData,
        3,
        1
    )

    buffer.writeu8(
        bufferData,
        4,
        1
    )

    buffer.writeu8(
        bufferData,
        5,
        42
    )

    buffer.writeu8(
        bufferData,
        6,
        24
    )

    local pushSuccess =
        pcall(
            phoneScreenPush.FireServer,
            phoneScreenPush,
            bufferData
        )

    if not pushSuccess then
        return false
    end

    if not State.farming then
        return false
    end

    local lookAt =
        targetPosition
        or
        (
            HRP.Position
            +
            HRP.CFrame.LookVector
            * 10
        )

    local submitSuccess =
        pcall(
            photoJobSubmit.InvokeServer,
            photoJobSubmit,
            "Submit",
            CFrame.lookAt(
                HRP.Position,
                lookAt
            )
        )

    return submitSuccess
end

--==================================================
-- PROCESS PLAYER TASK
--==================================================

local function processPlayerTask(
    taskText
)

    if not State.farming then
        return false
    end

    --==================================================
    -- FIND BODY
    --==================================================

    local target =
        findPlayerTarget(
            taskText
        )

    --==================================================
    -- BODY NOT FOUND
    --
    -- STOP JOB
    -- START JOB
    -- NEW TASK
    --==================================================

    if not target then

        rerollWhenPlayerNotFound()

        return false
    end

    local realPlayer =
        target.player

    State.targetUsername =
        realPlayer.Name

    --==================================================
    -- TELEPORT + PHOTO LOOP
    --==================================================

    while State.farming do

        --==================================================
        -- CHECK TASK
        --==================================================

        local currentTask =
            getTaskText()

        if currentTask
            and
            currentTask ~= ""
            and
            currentTask ~= taskText then

            State.processing = false
            State.lastTask = ""

            return false
        end

        --==================================================
        -- GET CURRENT CHARACTER
        --==================================================

        local character =
            realPlayer.Character

        --==================================================
        -- CHARACTER MISSING
        --==================================================

        if not character then

            local newTarget =
                findPlayerTarget(
                    taskText
                )

            if newTarget then

                realPlayer =
                    newTarget.player

                State.targetUsername =
                    realPlayer.Name

                continue
            end

            -- BODY TIDAK ADA
            -- STOP -> START

            rerollWhenPlayerNotFound()

            return false
        end

        --==================================================
        -- GET HUMANOID
        --==================================================

        local humanoid =
            character:FindFirstChildOfClass(
                "Humanoid"
            )

        --==================================================
        -- GET HRP
        --==================================================

        local targetHRP =
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        --==================================================
        -- BODY BELUM SIAP / MATI
        --==================================================

        if not humanoid
            or
            not targetHRP
            or
            humanoid.Health <= 0 then

            task.wait(
                S.PlayerSearchDelay
            )

            local newTarget =
                findPlayerTarget(
                    taskText
                )

            if newTarget then

                realPlayer =
                    newTarget.player

                State.targetUsername =
                    realPlayer.Name

                continue
            end

            -- BODY TETAP TIDAK ADA
            -- STOP -> START

            rerollWhenPlayerNotFound()

            return false
        end

        --==================================================
        -- TARGET POSITION
        --==================================================

        local targetPosition =
            targetHRP.Position

        --==================================================
        -- TELEPORT DIRECTION
        --==================================================

        local direction =
            HRP.Position
            - targetPosition

        if direction.Magnitude <
            0.1 then

            direction =
                -targetHRP.CFrame.LookVector

        else

            direction =
                direction.Unit
        end

        --==================================================
        -- PLAYER DISTANCE
        --==================================================

        local distance =
            math.max(
                0,
                tonumber(
                    S.PlayerDistance
                ) or 3
            )

        local teleportPosition =
            targetPosition
            +
            direction * distance

        --==================================================
        -- TELEPORT
        --==================================================

        setCollision(false)

        HRP.CFrame =
            CFrame.lookAt(
                teleportPosition,
                targetPosition
            )

        --==================================================
        -- VERIFY DISTANCE
        --==================================================

        local currentDistance =
            (
                HRP.Position
                - targetHRP.Position
            ).Magnitude

        --==================================================
        -- TAKE PHOTO
        --==================================================

        if currentDistance <=
            S.PhotoRange then

            local success =
                takePhoto(
                    targetHRP.Position
                )

            if success then

                setCollision(true)

                State.tweening = false
                State.processing = false

                State.lastTask = ""

                State.targetPlayer =
                    ""

                State.targetUsername =
                    ""

                task.wait(
                    S.SuccessDelay
                )

                return true
            end
        end

        --==================================================
        -- FOTO BELUM BERHASIL
        -- TELEPORT LAGI
        --==================================================

        task.wait(
            S.PlayerTeleportDelay
        )
    end

    setCollision(true)

    return false
end

--==================================================
-- PROCESS AREA
--==================================================

local function processAreaTask(
    taskText
)

    local area =
        resolveArea(
            taskText
        )

    if not area then
        return false
    end

    local position =
        findLocation(
            taskText
        )

    if not position then

        State.stopReason =
            "Location not found: "
            .. tostring(area)

        State.processing = false
        State.lastTask = ""

        return false
    end

    local moved =
        smoothTween(
            position
        )

    if not moved then

        State.processing = false

        return false
    end

    if not State.farming then

        State.processing = false

        return false
    end

    task.wait(0.05)

    takePhoto(
        position
    )

    setCollision(true)

    State.tweening = false
    State.processing = false

    task.wait(
        S.SuccessDelay
    )

    State.lastTask = ""

    return true
end

--==================================================
-- PROCESS TASK
--==================================================

local function processTask()

    if not State.farming then
        return
    end

    if State.processing
        or
        State.restarting then

        return
    end

    local taskText =
        getTaskText()

    if not taskText
        or
        taskText == "" then

        return
    end

    local lower =
        taskText:lower()

    if lower:find(
        "waiting for assignment",
        1,
        true
    ) then

        return
    end

    --==================================================
    -- MUSIC ROOM
    --==================================================

    if isRejectedTask(
        taskText
    ) then

        State.stopReason =
            "Music Room rejected"

        restartUntilValidTask()

        return
    end

    --==================================================
    -- AREA
    --==================================================

    local area =
        resolveArea(
            taskText
        )

    if area then

        if taskText ==
            State.lastTask then

            return
        end

        State.processing = true
        State.lastTask =
            taskText

        State.taskCount += 1

        processAreaTask(
            taskText
        )

        return
    end

    --==================================================
    -- PLAYER
    --==================================================

    if isPlayerPhotoTask(
        taskText
    ) then

        if taskText ==
            State.lastTask then

            return
        end

        State.processing = true
        State.lastTask =
            taskText

        State.taskCount += 1

        processPlayerTask(
            taskText
        )

        State.processing = false

        return
    end

    --==================================================
    -- INVALID
    --==================================================

    State.stopReason =
        "Invalid task: "
        .. tostring(
            taskText
        )

    restartUntilValidTask()
end

--==================================================
-- FARM LOOP
--==================================================

local function farmLoop()

    if farmLoopRunning then
        return
    end

    farmLoopRunning = true

    while State.farming do

        pcall(
            function()
                processTask()
            end
        )

        task.wait(
            S.RefreshRate
        )
    end

    setCollision(true)

    farmLoopRunning = false
end

