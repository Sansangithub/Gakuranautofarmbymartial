                CameraState.targetPlayer

            local character =
                player.Character

            if character then

                local humanoid =
                    character:FindFirstChildOfClass(
                        "Humanoid"
                    )

                if humanoid
                    and Camera then

                    Camera.CameraType =
                        Enum.CameraType.Custom

                    Camera.CameraSubject =
                        humanoid
                end
            end
        end
    end
)

