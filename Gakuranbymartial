local function setPlayerDistance(value)

    value = tonumber(value)

    if not value then
        return
    end

    value = math.clamp(
        value,
        MIN_PLAYER_DISTANCE,
        MAX_PLAYER_DISTANCE
    )

    value =
        math.floor(
            value * 10 + 0.5
        ) / 10

    S.PlayerDistance = value

    if DistanceLabel then

        DistanceLabel.Text =
            "Distance: "
            .. string.format(
                "%.1f",
                S.PlayerDistance
            )
    end
end

local function changePlayerDistance(amount)

    setPlayerDistance(
        S.PlayerDistance + amount
    )
end

