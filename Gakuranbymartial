local function setChatStatus(text, success)
    if not ChatStatus then return end
    ChatStatus.Text = text or ""

    if success == true then
        ChatStatus.TextColor3 = Color3.fromRGB(80, 255, 120)
    elseif success == false then
        ChatStatus.TextColor3 = Color3.fromRGB(255, 90, 90)
    else
        ChatStatus.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end

local function sendChatMessage(message)
    if not message then return false end
    message = tostring(message):match("^%s*(.-)%s*$")
    if message == "" or State.chatSending then
        return false
    end

    State.chatSending = true
    State.lastChatMessage = message
    local sent = false

    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local textChannels = TextChatService:FindFirstChild("TextChannels")
        if textChannels then
            local general = textChannels:FindFirstChild("RBXGeneral")
            if general and general:IsA("TextChannel") then
                local ok = pcall(function()
                    general:SendAsync(message)
                end)
                if ok then sent = true end
            end

            if not sent then
                for _, channel in ipairs(textChannels:GetChildren()) do
                    if channel:IsA("TextChannel") and channel ~= general then
                        local ok = pcall(function()
                            channel:SendAsync(message)
                        end)
                        if ok then
                            sent = true
                            break
                        end
                    end
                end
            end
        end
    end

    if not sent then
        local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if chatEvents then
            local sayMessage = chatEvents:FindFirstChild("SayMessageRequest")
            if sayMessage then
                local ok = pcall(function()
                    sayMessage:FireServer(message, "All")
                end)
                if ok then sent = true end
            end
        end
    end

    State.chatSending = false

    if sent then
        setChatStatus("CHAT SENT: " .. message, true)
    else
        setChatStatus("CHAT FAILED", false)
    end

    return sent
end

local function sendViewCommand(playerName)
    if not S.AutoViewCommandEnabled then return false end
    playerName = normalizePlayerName(playerName)
    if playerName == "" then return false end

    local normalized = playerName:lower()
    if State.lastViewTarget == normalized then
        return true
    end

    local command = ";view " .. playerName
    local success = sendChatMessage(command)
    if success then
        State.lastViewTarget = normalized
        State.lastViewCommand = command
    end

    return success
end

