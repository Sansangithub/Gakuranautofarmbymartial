		task.wait(step)
		elapsed += step
	end
end

-- Membentuk array byte BLINK_RELIABLE_REMOTE secara dinamis berdasarkan nama target Yen
local function buildBlinkBytes(targetName)
	targetName = normalizePlayerName(targetName)
	if targetName == "" then
		targetName = "skoeow"
	end
	-- Batasi panjang maksimal 255 byte (u8 length)
	if #targetName > 255 then
		targetName = targetName:sub(1, 255)
	end

	-- Header tetap: { 59, 1, 0, 1, 0, <panjang_nama>, 0 } diikuti byte ASCII nama target
	local bytes = { 59, 1, 0, 1, 0, #targetName, 0 }
	for i = 1, #targetName do
		table.insert(bytes, string.byte(targetName, i))
	end
	return bytes
end

local function fireBlinkReliableRemote(targetName)
	local event = ReplicatedStorage:FindFirstChild("BLINK_RELIABLE_REMOTE")
	if event and firesignal then
		local payloadBytes = buildBlinkBytes(targetName)
		local ok = pcall(function()
			firesignal(
				event.OnClientEvent,
				(function(bytes)
					local b = buffer.create(#bytes)
					for i = 1, #bytes do
						buffer.writeu8(b, i - 1, bytes[i])
					end
					return b
				end)(payloadBytes),
				{}
			)
		end)
		return ok
	end
	return false
end

local function executeMacroCycle(sessionId)
	local targetText = MacroTargetBox and normalizePlayerName(MacroTargetBox.Text) or MacroState.targetName
	local keyText = MacroKeybindBox and tostring(MacroKeybindBox.Text) or MacroState.keybind
	if targetText == "" then
		setChatStatus("NAMA YEN KOSONG", false)
		return
	end
	if keyText == "" then
		setChatStatus("MACRO KEYBIND EMPTY", false)
		return
	end

	if MacroTargetBox then MacroTargetBox:ReleaseFocus() end
	if MacroKeybindBox then MacroKeybindBox:ReleaseFocus() end
	if MacroDelayBox then MacroDelayBox:ReleaseFocus() end
	if ChatBox then ChatBox:ReleaseFocus() end

	-- 1. Klik ALT lalu tunggu 1 detik
	macroPressKey(Enum.KeyCode.LeftAlt)
	if not MacroState.running or MacroState.sessionId ~= sessionId then return end
	task.wait(1)
	if not MacroState.running or MacroState.sessionId ~= sessionId then return end

	-- 2. Jalankan BLINK_RELIABLE_REMOTE dengan nama target Yen yang diatur di menu
	local fired = fireBlinkReliableRemote(targetText)
	if not fired then
		setChatStatus("BLINK REMOTE / FIRESIGNAL FAIL", false)
	end
	if not MacroState.running or MacroState.sessionId ~= sessionId then return end

	-- 3. Tunggu 1 detik, lalu klik Enter 1x
	task.wait(1)
	if not MacroState.running or MacroState.sessionId ~= sessionId then return end
	macroPressKey(Enum.KeyCode.Return)
	if not MacroState.running or MacroState.sessionId ~= sessionId then return end

	-- 4. Tunggu 1 detik lagi, baru ketik keybind
	task.wait(1)
	if not MacroState.running or MacroState.sessionId ~= sessionId then return end
	macroTypeString(keyText, sessionId)
	task.wait(0.15)
	if not MacroState.running or MacroState.sessionId ~= sessionId then return end

	-- 5. Langsung Enter 1x
	macroPressKey(Enum.KeyCode.Return)
	task.wait(0.15)
	if not MacroState.running or MacroState.sessionId ~= sessionId then return end

	-- 6. Langsung klik ALT lagi
	macroPressKey(Enum.KeyCode.LeftAlt)
end

