--==================================================
-- HELPERS
--==================================================

local function trim(value)
    return tostring(value or ""):match("^%s*(.-)%s*$")
end

local function normalize(value)
    value = trim(value):lower()

    for _, prefix in ipairs(PHOTO_PREFIXES) do
        if value:sub(1, #prefix) == prefix then
            value = value:sub(#prefix + 1)
            break
        end
    end

    value = value:gsub("[%.%,!%?:;]+$", "")
    value = value:gsub("^the ", "")

    return trim(value)
end

local function getTaskText()
    local gui = PlayerGui:FindFirstChild("PhotoJobGui")
    if not gui then
        return nil
    end

    local card = gui:FindFirstChild("Card", true)
    if not card then
        return nil
    end

    local taskLabel = card:FindFirstChild("Task", true)
    if not taskLabel then
        return nil
    end

    if taskLabel:IsA("TextLabel")
        or taskLabel:IsA("TextButton") then
        return trim(taskLabel.Text)
    end

    return nil
end

local function getPhotoTargetText(taskText)
    if not taskText then
        return nil
    end

    local lower = taskText:lower()

    for _, prefix in ipairs(PHOTO_PREFIXES) do
        if lower:sub(1, #prefix) == prefix then
            local target = trim(taskText:sub(#prefix + 1))
            target = target:gsub("[%.%,!%?:;]+$", "")

            if target ~= "" then
                return target
            end
        end
    end

    return nil
end

--==================================================
-- AREA DETECTION
--==================================================

local function resolveArea(taskText)
    if not taskText then
        return nil
    end

    local normalized = normalize(taskText)

    for _, entry in ipairs(AREA_TASKS) do
        if normalized == entry.name:lower() then
            return entry.name
        end

        for _, alias in ipairs(entry.aliases) do
            alias = alias:lower()

            if normalized == alias then
                return entry.name
            end

            if normalized:find(alias, 1, true) then
                return entry.name
            end
        end
    end

    return nil
end

--==================================================
-- PLAYER SEARCH
--==================================================

local function findPlayer(targetName)
    if not targetName then
        return nil
    end

    local target = trim(targetName):lower()

    if target == "" then
        return nil
    end

    -- Exact username
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if player.Name:lower() == target then
                return player
            end
        end
    end

    -- Exact display name
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if player.DisplayName:lower() == target then
                return player
            end
        end
    end

    -- Partial match only when unambiguous
    local matches = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local username = player.Name:lower()
            local display = player.DisplayName:lower()

            if username:find(target, 1, true)
                or display:find(target, 1, true) then
                table.insert(matches, player)
            end
        end
    end

    if #matches == 1 then
        return matches[1]
    end

    return nil
end

local function findPlayerWithRetry(targetName)
    for attempt = 1, Settings.PlayerSearchAttempts do
        if not State.enabled then
            return nil
        end

        local player = findPlayer(targetName)

        if player then
            local character = player.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")

            if hrp then
                return player
            end
        end

        if attempt < Settings.PlayerSearchAttempts then
            task.wait(Settings.PlayerSearchDelay)
        end
    end

    return nil
end

--==================================================
-- CAMERA
--==================================================

local function getCamera()
    return Workspace.CurrentCamera
end

local function stopView()
    local camera = getCamera()

    if camera then
        camera.CameraType =
            CameraState.previousType or Enum.CameraType.Custom

        if CameraState.previousSubject
            and CameraState.previousSubject.Parent then
            camera.CameraSubject = CameraState.previousSubject
        else
            local character = LocalPlayer.Character
            local humanoid = character
                and character:FindFirstChildOfClass("Humanoid")

            if humanoid then
                camera.CameraSubject = humanoid
            end
        end
    end

    CameraState.active = false
    CameraState.target = nil
    CameraState.previousType = nil
    CameraState.previousSubject = nil

    State.cameraActive = false
end

local function startView(player)
    if not player then
        return false
    end

    local character = player.Character
    if not character then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return false
    end

    local camera = getCamera()
    if not camera then
        return false
    end

    if not CameraState.active then
        CameraState.previousType = camera.CameraType
        CameraState.previousSubject = camera.CameraSubject
    end

    CameraState.active = true
    CameraState.target = player

    camera.CameraType = Enum.CameraType.Custom
    camera.CameraSubject = humanoid

    State.cameraActive = true

    return true
end

--==================================================
-- TASK CLASSIFICATION
--==================================================

local function classifyTask(taskText)
    if not taskText or taskText == "" then
        return "Waiting", nil, nil
    end

    local lower = taskText:lower()

    if lower:find("waiting for assignment", 1, true) then
        return "Waiting", nil, nil
    end

    local area = resolveArea(taskText)

    if area then
        return "Area", area, nil
    end

    local playerName = getPhotoTargetText(taskText)

    if playerName then
        return "Player", playerName, nil
    end

    return "Unknown", nil, nil
end

--==================================================
-- GUI UPDATE
--==================================================

local function updateGUI()
    if not ScreenGui then
        return
    end

    if StatusLabel then
        if State.enabled then
            StatusLabel.Text = "STATUS: MONITORING"
            StatusLabel.TextColor3 = Color3.fromRGB(80, 230, 120)
        else
            StatusLabel.Text = "STATUS: STOPPED"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
        end
    end

    if ToggleButton then
        ToggleButton.Text = State.enabled
            and "MONITOR: ON"
            or "MONITOR: OFF"

        ToggleButton.BackgroundColor3 = State.enabled
            and Color3.fromRGB(40, 150, 80)
            or Color3.fromRGB(160, 50, 50)
    end

    if ViewButton then
        ViewButton.Text = State.cameraActive
            and "STOP VIEW"
            or "VIEW TARGET"
    end

    if TaskLabel then
        TaskLabel.Text = "TASK: " ..
            (State.currentTask ~= "" and State.currentTask or "None")
    end

    if TypeLabel then
        TypeLabel.Text = "TYPE: " .. State.taskType
    end

    if TargetLabel then
        local target = State.targetName

        if State.targetPlayer then
            target = State.targetPlayer.DisplayName
                .. " (@" .. State.targetPlayer.Name .. ")"
        end

        TargetLabel.Text = "TARGET: " ..
            (target ~= "" and target or "None")
    end
end

--==================================================
-- PROCESS TASK
--==================================================

local function processTask()
    local taskText = getTaskText()

    if not taskText then
        State.currentTask = ""
        State.taskType = "Waiting"
        State.targetName = ""
        State.targetPlayer = nil
        updateGUI()
        return
    end

    if taskText == State.currentTask then
        return
    end

    State.currentTask = taskText
    State.taskCount += 1

    local taskType, target = classifyTask(taskText)

    State.taskType = taskType
    State.targetName = ""
    State.targetPlayer = nil

    if taskType == "Player" then
        State.targetName = target or ""

        local player = findPlayerWithRetry(target)

        if player then
            State.targetPlayer = player
            State.lastError = ""
        else
            State.lastError = "Player not found or ambiguous"
        end

    elseif taskType == "Area" then
        State.targetName = target or ""
        State.lastError = ""

    elseif taskType == "Waiting" then
        State.lastError = ""

    else
        State.lastError = "Unknown task format"
    end

    updateGUI()
end

--==================================================
-- MONITOR LOOP
--==================================================

local function monitorLoop()
    if State.running then
        return
    end

    State.running = true

    while State.enabled do
        local success, err = pcall(processTask)

        if not success then
            State.lastError = tostring(err)
            warn("[PhotoJob Monitor]", err)
            updateGUI()
        end

        task.wait(Settings.RefreshRate)
    end

    State.running = false
end

--==================================================
-- START / STOP
--==================================================

local function startMonitor()
    if State.enabled then
        return
    end

    State.enabled = true
    State.lastError = ""

    updateGUI()

    task.spawn(monitorLoop)
end

local function stopMonitor()
    State.enabled = false

    stopView()

    State.currentTask = ""
    State.taskType = "Stopped"
    State.targetName = ""
    State.targetPlayer = nil

    updateGUI()
end

--==================================================
-- GUI CREATION
--==================================================

local function createLabel(parent, name, text, position, size)
    local label = Instance.new("TextLabel")

    label.Name = name
    label.Size = size
    label.Position = position
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(230, 230, 230)
    label.TextSize = 12
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.Parent = parent

    return label
end

local function createButton(parent, name, text, position, size, color)
    local button = Instance.new("TextButton")

    button.Name = name
    button.Size = size
    button.Position = position
    button.BackgroundColor3 = color
    button.BorderSizePixel = 0
    button.Text = text
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 11
    button.Font = Enum.Font.GothamBold
    button.AutoButtonColor = true
    button.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = button

    return button
end

local function createGUI()
    local old = PlayerGui:FindFirstChild("PhotoFarmMonitor")

    if old then
        old:Destroy()
    end

    ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "PhotoFarmMonitor"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.Parent = PlayerGui

    MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.fromOffset(310, 220)
    MainFrame.Position = UDim2.new(0.5, -155, 0, 100)
    MainFrame.BackgroundColor3 = Color3.fromRGB(23, 23, 29)
    MainFrame.BorderSizePixel = 0
    MainFrame.Parent = ScreenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = MainFrame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(65, 65, 80)
    stroke.Thickness = 1
    stroke.Parent = MainFrame

    local title = createLabel(
        MainFrame,
        "Title",
        "PHOTO JOB MONITOR",
        UDim2.fromOffset(12, 7),
        UDim2.new(1, -24, 0, 25)
    )

    title.Font = Enum.Font.GothamBold
    title.TextSize = 15

    StatusLabel = createLabel(
        MainFrame,
        "Status",
        "STATUS: STOPPED",
        UDim2.fromOffset(12, 37),
        UDim2.new(1, -24, 0, 20)
    )

    StatusLabel.Font = Enum.Font.GothamBold

    TaskLabel = createLabel(
        MainFrame,
        "Task",
        "TASK: None",
        UDim2.fromOffset(12, 65),
        UDim2.new(1, -24, 0, 35)
    )

    TypeLabel = createLabel(
        MainFrame,
        "Type",
        "TYPE: Unknown",
        UDim2.fromOffset(12, 102),
        UDim2.new(1, -24, 0, 20)
    )

    TargetLabel = createLabel(
        MainFrame,
        "Target",
        "TARGET: None",
        UDim2.fromOffset(12, 125),
        UDim2.new(1, -24, 0, 30)
    )

    ToggleButton = createButton(
        MainFrame,
        "Toggle",
        "MONITOR: OFF",
        UDim2.fromOffset(12, 165),
        UDim2.fromOffset(135, 35),
        Color3.fromRGB(160, 50, 50)
    )

    ViewButton = createButton(
        MainFrame,
        "View",
        "VIEW TARGET",
        UDim2.fromOffset(160, 165),
        UDim2.fromOffset(138, 35),
        Color3.fromRGB(50, 100, 170)
    )

    RefreshButton = createButton(
        MainFrame,
        "Refresh",
        "REFRESH TASK",
        UDim2.fromOffset(12, 205),
        UDim2.fromOffset(286, 30),
        Color3.fromRGB(65, 75, 95)
    )

    -- DRAGGING
    local dragging = false
    local dragStart
    local startPosition

    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = MainFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position - dragStart

        MainFrame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end)

    -- BUTTONS
    ToggleButton.Activated:Connect(function()
        if State.enabled then
            stopMonitor()
        else
            startMonitor()
        end

        updateGUI()
    end)

    ViewButton.Activated:Connect(function()
        if CameraState.active then
            stopView()
        elseif State.targetPlayer then
            startView(State.targetPlayer)
        end

        updateGUI()
    end)

    RefreshButton.Activated:Connect(function()
        State.currentTask = ""
        processTask()
        updateGUI()
    end)
end

--==================================================
-- PLAYER EVENTS
--==================================================

Players.PlayerRemoving:Connect(function(player)
    if State.targetPlayer == player then
        State.targetPlayer = nil
        State.lastError = "Target player left"
        stopView()
        updateGUI()
    end
end)

Players.PlayerAdded:Connect(function()
    if State.enabled then
        task.delay(0.5, function()
            if State.enabled then
                State.currentTask = ""
                processTask()
            end
        end)
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    stopView()
end)

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    if not CameraState.active then
        return
    end

    local camera = getCamera()
    local player = CameraState.target

    if not camera or not player then
        stopView()
        return
    end

    local character = player.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = humanoid
    end
end)

--==================================================
-- GLOBAL API
--==================================================

_G.StartPhotoMonitor = startMonitor
_G.StopPhotoMonitor = stopMonitor

_G.GetPhotoMonitorStatus = function()
    return {
        enabled = State.enabled,
        running = State.running,
        currentTask = State.currentTask,
        taskType = State.taskType,
        targetName = State.targetName,
        targetPlayer = State.targetPlayer
            and State.targetPlayer.Name or nil,
        taskCount = State.taskCount,
        cameraActive = State.cameraActive,
        lastError = State.lastError
    }
end

_G.ViewPhotoTarget = function()
    if State.targetPlayer then
        return startView(State.targetPlayer)
    end

    return false
end

_G.StopPhotoTargetView = stopView

--==================================================
-- INITIALIZE
--==================================================

createGUI()
updateGUI()

if Settings.AutoStart then
    task.delay(1, startMonitor)
end

print("[PhotoJob Monitor] Loaded successfully.")
