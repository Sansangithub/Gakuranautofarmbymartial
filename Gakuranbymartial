        local character = player.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid and Camera then
                Camera.CameraType = Enum.CameraType.Custom
                Camera.CameraSubject = humanoid
            end
        end
    end
end)

createGUI()
updateGUI()

task.spawn(function()
    local attempts = 0
    while not findRemotes() and attempts < 30 do
        attempts += 1
        task.wait(1)
    end

    if not phoneScreenPush or not photoJobSubmit then
        State.stopReason = "PhotoJob remotes not found"
        State.farming = false
        stopPlayerView()
        updateGUI()
        return
    end

    if S.Enabled and S.AutoStart then
        startFarming()
    else
        State.farming = false
        stopPlayerView()
        updateGUI()
    end
end)

--==================================================
-- GLOBAL API (_G)
--==================================================

_G.StartFarming = function()
    startFarming()
end

_G.StopFarming = function()
    stopFarmingFromGUI()
end

_G.SetPlayerView = function(enabled)
    S.PlayerViewEnabled = enabled == true
    if not S.PlayerViewEnabled then
        stopPlayerView()
    end
    return S.PlayerViewEnabled
end

_G.GetPlayerView = function()
    return S.PlayerViewEnabled
end

_G.SetPlayerViewDuration = function(seconds)
    seconds = tonumber(seconds)
    if not seconds then return false end
    S.PlayerViewDuration = math.max(0, seconds)
    return true
end

_G.GetPlayerViewDuration = function()
    return S.PlayerViewDuration
end

_G.SetAutoView = function(enabled)
    S.AutoViewCommandEnabled = enabled == true
    updateGUI()
    return S.AutoViewCommandEnabled
end

_G.GetAutoView = function()
    return S.AutoViewCommandEnabled
end

_G.GetLastViewTarget = function()
    return State.lastViewTarget
end

_G.ClearViewMemory = function()
    State.lastViewTarget = ""
    State.lastViewCommand = ""
    return true
end

_G.SendViewCommand = function(playerName)
    playerName = normalizePlayerName(playerName)
    if playerName == "" then return false end

    local command = ";view " .. playerName
    local success = sendChatMessage(command)
    if success then
        State.lastViewTarget = playerName:lower()
        State.lastViewCommand = command
    end
    return success
end

_G.SendChat = function(message)
    return sendChatMessage(message)
end

_G.ViewPlayer = function(playerName)
    local player = getPlayerByText(playerName)
    if not player then return false end
    return startPlayerView(player)
end

_G.UnviewPlayer = function()
    stopPlayerView()
end

_G.GetStatus = function()
    return {
        farming = State.farming,
        sessionId = State.sessionId,
        farmLoopRunning = State.farmLoopRunning,
        processing = State.processing,
        restarting = State.restarting,
        playerView = CameraState.active,
        playerViewEnabled = S.PlayerViewEnabled,
        playerViewDuration = S.PlayerViewDuration,
        autoView = S.AutoViewCommandEnabled,
        lastViewTarget = State.lastViewTarget,
        lastViewCommand = State.lastViewCommand,
        lastChatMessage = State.lastChatMessage,
        lastTask = State.lastTask,
        taskCount = State.taskCount,
        restartCount = State.restartCount,
        photoAttempts = State.photoAttempts,
