local PhotoBuffer

local function createPhotoBuffer()

    local ok, result =
        pcall(
            function()

                local data =
                    buffer.create(7)

                buffer.writeu8(
                    data, 0, 1
                )

                buffer.writeu8(
                    data, 1, 4
                )

                buffer.writeu8(
                    data, 2, 0
                )

                buffer.writeu8(
                    data, 3, 1
                )

                buffer.writeu8(
                    data, 4, 1
                )

                buffer.writeu8(
                    data, 5, 42
                )

                buffer.writeu8(
                    data, 6, 24
                )

                return data
            end
        )

    if ok then
        return result
    end

    return nil
end

PhotoBuffer =
    createPhotoBuffer()

--==================================================
-- BEST PHOTO POSITION
--==================================================

local function getBestPhotoPosition(
    player
)

    local targetHRP =
        getTargetRoot(
            player
        )

    if not targetHRP then
        return nil
    end

    local targetPosition =
        targetHRP.Position

    local look =
        targetHRP.CFrame.LookVector

    local right =
        targetHRP.CFrame.RightVector

    local distance =
        S.PlayerPhotoDistance

    local height =
        S.PlayerPhotoHeight

    local candidates = {

        targetPosition
            - look * distance
            + Vector3.new(
                0,
                height,
                0
            ),

        targetPosition
            + look * distance
            + Vector3.new(
                0,
                height,
                0
            ),

        targetPosition
            - right * distance
            + Vector3.new(
                0,
                height,
                0
            ),

        targetPosition
            + right * distance
            + Vector3.new(
                0,
                height,
                0
            )
    }

    local best
    local bestDistance =
        math.huge

    for _, position in ipairs(
        candidates
    ) do

        local d =
            (
                position
                - targetPosition
            ).Magnitude

        if d <=
            S.PhotoTargetMaxDistance
            and d < bestDistance then

            bestDistance =
                d

            best = {
                position = position,
                target = targetPosition
            }
        end
    end

    return best
end

--==================================================
-- DIRECT TELEPORT
--==================================================

local function fastTeleportToPosition(
    position,
    targetPosition
)

    if not Character
        or not Character.Parent
        or not HRP
        or not HRP.Parent
        or not State.farming then

        return false
    end

    local destination =
        CFrame.lookAt(
            position,
            targetPosition
        )

    State.teleportAttempts += 1

    setCollision(false)

    pcall(
        function()

            Character:PivotTo(
                destination
            )

        end
    )

    if HRP
        and HRP.Parent then

        pcall(
            function()

                HRP.CFrame =
                    destination

            end
        )

        HRP.AssemblyLinearVelocity =
            Vector3.zero

        HRP.AssemblyAngularVelocity =
            Vector3.zero
    end

    if HRP
        and HRP.Parent then

        local distance =
            (
                HRP.Position
                - position
            ).Magnitude

        if distance <=
            S.PhotoPositionTolerance then

            return true
        end
    end

    for _ = 1,
        math.max(
            0,
            S.FastTeleportAttempts - 1
        ) do

        if not State.farming then
            break
        end

        State.teleportAttempts += 1

        pcall(
            function()

                Character:PivotTo(
                    destination
                )

            end
        )

        if HRP
            and HRP.Parent then

            pcall(
                function()

                    HRP.CFrame =
                        destination

                end
            )

            HRP.AssemblyLinearVelocity =
                Vector3.zero

            HRP.AssemblyAngularVelocity =
                Vector3.zero

            local distance =
                (
                    HRP.Position
                    - position
                ).Magnitude

            if distance <=
                S.PhotoPositionTolerance then

                return true
            end
        end
    end

    return false
end

