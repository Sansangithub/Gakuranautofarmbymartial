--==================================================
-- CHARACTER
--==================================================

local function bindCharacter(character)

    Character = character

    HRP = character:WaitForChild(
        "HumanoidRootPart",
        10
    )

    Humanoid = character:WaitForChild(
        "Humanoid",
        10
    )

    if not HRP then
        return
    end

    for _, object in ipairs(
        character:GetDescendants()
    ) do

        if object:IsA("BasePart") then
            object.CanCollide = true
        end

    end
end

--==================================================
-- REMOTE FINDER
--==================================================

local function findRemotes()

    Remotes =
        ReplicatedStorage:FindFirstChild(
            "Remotes"
        )

    if not Remotes then
        return false
    end

    phoneScreenPush =
        Remotes:FindFirstChild(
            "PhoneScreenPush"
        )

    photoJobSubmit =
        Remotes:FindFirstChild(
            "PhotoJobSubmit"
        )

    if not phoneScreenPush then
        return false
    end

    if not photoJobSubmit then
        return false
    end

    return true
end

--==================================================
-- COLLISION
--==================================================

local function setCollision(enabled)

    if not Character then
        return
    end

    for _, object in ipairs(
        Character:GetDescendants()
    ) do

        if object:IsA("BasePart") then
            object.CanCollide = enabled
        end

    end
end

--==================================================
-- CANCEL TWEEN
--==================================================

local function cancelTween()

    if currentTween then

        pcall(function()
            currentTween:Cancel()
        end)

        currentTween = nil
    end

    State.tweening = false
end

--==================================================
-- STOP FARMING
--==================================================

local function stopFarming(reason)

    State.farming = false
    State.processing = false
    State.tweening = false
    State.restarting = false

    State.stopReason =
        tostring(
            reason or "Stopped"
        )

    cancelTween()

    setCollision(true)
end

--==================================================
-- NORMALIZE TEXT
--==================================================

local function normalizeText(text)

    if not text then
        return ""
    end

    text = tostring(text)
    text = text:lower()

    local prefixes = {
        "get a photo of ",
        "take a photo of ",
        "take photo of ",
        "a photo of ",
        "photo of ",
        "photograph of ",
        "photograph ",
        "take a picture of ",
        "take picture of ",
        "picture of ",
    }

    for _, prefix in ipairs(prefixes) do

        if text:sub(
            1,
            #prefix
        ) == prefix then

            text =
                text:sub(
                    #prefix + 1
                )

            break
        end
    end

    if text:sub(1, 4) == "the " then
        text = text:sub(5)
    end

    text =
        text:match(
            "^%s*(.-)%s*$"
        )

    return text
end

--==================================================
-- RESOLVE AREA
--==================================================

local function resolveArea(taskText)

    local normalized =
        normalizeText(taskText)

    if normalized == "" then
        return nil
    end

    -- Alias matching
    for _, entry in ipairs(
        AREA_TASKS
    ) do

        for _, alias in ipairs(
            entry.aliases
        ) do

            if normalized == alias then
                return entry.canonical
            end

            if normalized:find(
                alias,
                1,
                true
            ) then

                return entry.canonical
            end
        end
    end

    -- Canonical matching
    for _, entry in ipairs(
        AREA_TASKS
    ) do

        local canonical =
            entry.canonical:lower()

        if normalized == canonical then
            return entry.canonical
        end

        if normalized:find(
            canonical,
            1,
            true
        ) then

            return entry.canonical
        end
    end

    return nil
end

--==================================================
-- CHECK WHITELIST
--==================================================

local function isWhitelistedTask(taskText)

    if not taskText then
        return false
    end

    return resolveArea(taskText) ~= nil
end

--==================================================
-- REJECTED TASK
-- MUSIC ROOM ALWAYS REROLL
--==================================================

local function isRejectedTask(taskText)

    if not taskText then
        return false
    end

    local normalized =
        normalizeText(taskText)

    if normalized == "music room" then
        return true
    end

    if normalized:find(
        "music room",
        1,
        true
    ) then

        return true
    end

    return false
end

--==================================================
-- GET TASK TEXT
--==================================================

local function getTaskText()

    local PlayerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    if not PlayerGui then
        return nil
    end

    local PhotoJobGui =
        PlayerGui:FindFirstChild(
            "PhotoJobGui"
        )

    if not PhotoJobGui then
        return nil
    end

    local Card =
        PhotoJobGui:FindFirstChild(
            "Card"
        )

    if not Card then
        return nil
    end

    local Task =
        Card:FindFirstChild(
            "Task"
        )

    if not Task then
        return nil
    end

    if not Task:IsA("TextLabel")
        and not Task:IsA("TextButton") then

        return nil
    end

    return Task.Text
end

