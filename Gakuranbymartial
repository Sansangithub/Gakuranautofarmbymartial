--==================================================
-- TASK TEXT
--==================================================

local function getTask()

    local gui =
        LP:FindFirstChild(
            "PlayerGui"
        )

    if not gui then
        return nil
    end

    local photoGui =
        gui:FindFirstChild(
            "PhotoJobGui"
        )

    if not photoGui then
        return nil
    end

    local card =
        photoGui:FindFirstChild(
            "Card"
        )

    if not card then
        return nil
    end

    local label =
        card:FindFirstChild(
            "Task"
        )

    if not label then
        return nil
    end

    return label.Text
end

--==================================================
-- NORMALIZE
--==================================================

local function clean(text)

    if not text then
        return ""
    end

    return tostring(text)
        :lower()
        :gsub("^%s+", "")
        :gsub("%s+$", "")
end

--==================================================
-- PLAYER NAME FROM TASK
--==================================================

local PREFIXES = {
    "get a photo of ",
    "take a photo of ",
    "take photo of ",
    "photo of ",
    "photograph of ",
    "get a picture of ",
    "take a picture of ",
    "take picture of ",
    "picture of "
}

local function getTargetName(task)

    if not task then
        return nil
    end

    local lower =
        clean(task)

    for _, prefix in ipairs(PREFIXES) do

        if lower:sub(
            1,
            #prefix
        ) == prefix then

            return task:sub(
                #prefix + 1
            ):match("^%s*(.-)%s*$")
        end
    end

    return nil
end

--==================================================
-- FIND PLAYER
--==================================================

local function findPlayer(name)

    if not name then
        return nil
    end

    local wanted =
        clean(name)

    -- EXACT USERNAME
    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LP
            and clean(player.Name)
                == wanted then

            return player
        end
    end

    -- EXACT DISPLAY
    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LP
            and clean(player.DisplayName)
                == wanted then

            return player
        end
    end

    -- PARTIAL
    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LP then

            if clean(player.Name):find(
                wanted,
                1,
                true
            )
            or clean(player.DisplayName):find(
                wanted,
                1,
                true
            ) then

                return player
            end
        end
    end

    return nil
end

--==================================================
-- TARGET ROOT
--==================================================

local function getTargetRoot(player)

    if not player then
        return nil
    end

    local char =
        player.Character

    if not char then
        return nil
    end

    local hum =
        char:FindFirstChildOfClass(
            "Humanoid"
        )

    local root =
        char:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root
        or not hum
        or hum.Health <= 0 then

        return nil
    end

    return root
end

--==================================================
-- AUTO VIEW
--==================================================

local function sendChat(message)

    if not message then
        return false
    end

    if TextChatService.ChatVersion ==
        Enum.ChatVersion.TextChatService then

        local channels =
            TextChatService:FindFirstChild(
                "TextChannels"
            )

        if channels then

            local general =
                channels:FindFirstChild(
                    "RBXGeneral"
                )

            if general then

                return pcall(function()

                    general:SendAsync(
                        message
                    )

                end)
            end
        end
    end

    return false
end

local function autoView(player)

    if not CFG.AUTO_VIEW then
        return
    end

    if not player then
        return
    end

    local key =
        clean(player.Name)

    if LastViewTarget == key then
        return
    end

    if sendChat(
        ";view " .. player.Name
    ) then

        LastViewTarget = key

    end
end

--==================================================
-- BEST PHOTO POSITION
--==================================================

local function getPhotoPosition(
    targetRoot
)

    if not targetRoot then
        return nil
    end

    local targetPos =
        targetRoot.Position

    local look =
        targetRoot.CFrame.LookVector

    local right =
        targetRoot.CFrame.RightVector

    local d =
        CFG.PHOTO_DISTANCE

    local h =
        CFG.PHOTO_HEIGHT

    -- Front / Back / Sides
    local positions = {

        targetPos
            - look * d
            + Vector3.new(0, h, 0),

        targetPos
            + look * d
            + Vector3.new(0, h, 0),

        targetPos
            - right * d
            + Vector3.new(0, h, 0),

        targetPos
            + right * d
            + Vector3.new(0, h, 0)
    }

    -- ULTRA FAST:
    -- normally position pertama langsung dipakai
    return positions[1]
end

--==================================================
-- FAST TELEPORT
--==================================================

local function fastTeleport(
    position,
    targetPosition
)

    if not Root
        or not Root.Parent
        or not Character then

        return false
    end

    local cf =
        CFrame.lookAt(
            position,
            targetPosition
        )

    for attempt = 1,
        CFG.TELEPORT_RETRIES do

        if not Farming then
            return false
        end

        TeleportAttempts += 1

        pcall(function()

            Character:PivotTo(cf)

        end)

        pcall(function()

            Root.CFrame = cf

            Root.AssemblyLinearVelocity =
                Vector3.zero

            Root.AssemblyAngularVelocity =
                Vector3.zero

        end)

        -- Tidak memakai delay panjang.
        RunService.Heartbeat:Wait()

        if Root
            and Root.Parent then

            local distance =
                (
                    Root.Position
                    - position
                ).Magnitude

            if distance <=
                CFG.TELEPORT_TOLERANCE then

                return true
            end
        end
    end

    return false
end

--==================================================
-- TELEPORT TO PLAYER
--==================================================

local function teleportToPlayer(
    player
)

    local targetRoot =
        getTargetRoot(player)

    if not targetRoot then
        return false
    end

    local position =
        getPhotoPosition(
            targetRoot
        )

    if not position then
        return false
    end

    local targetPosition =
        targetRoot.Position

    return fastTeleport(
        position,
        targetPosition
    )
end

--==================================================
-- PHOTO POSITION CHECK
--==================================================

local function validPhotoPosition(
    player
)

    if not Root
        or not Root.Parent then

        return nil
    end

    local targetRoot =
        getTargetRoot(player)

    if not targetRoot then
        return nil
    end

    local targetPosition =
        targetRoot.Position

    local distance =
        (
            Root.Position
            - targetPosition
        ).Magnitude

    if distance >
        CFG.MAX_PHOTO_DISTANCE then

        return nil
    end

    local direction =
        targetPosition
        - Root.Position

    if direction.Magnitude <=
        0.05 then

        return nil
    end

    return targetPosition
end

--==================================================
-- TAKE PHOTO
--==================================================

local function takePhoto(
    player,
    previousTask
)

    if not Farming
        or not JobRemote
        or not PhoneRemote
        or not PhotoBuffer then

        return false
    end

    for attempt = 1,
        CFG.PHOTO_RETRIES do

        if not Farming then
            return false
        end

        local targetPosition =
            validPhotoPosition(
                player
            )

        if not targetPosition then

            -- Target bergerak / posisi gagal:
            -- langsung reposition.
            if not teleportToPlayer(
                player
            ) then

                return false
            end

            targetPosition =
                validPhotoPosition(
                    player
                )
        end

        if not targetPosition then
            return false
        end

        -- Arahkan karakter tepat ke target.
        local cf =
            CFrame.lookAt(
                Root.Position,
                targetPosition
            )

        pcall(function()
            Root.CFrame = cf
        end)

        PhotoAttempts += 1

        local pushed =
            pcall(function()

                PhoneRemote:FireServer(
                    PhotoBuffer
                )

            end)

        if pushed then

            local submitted =
                pcall(function()

                    JobRemote:InvokeServer(
                        "Submit",
                        cf
                    )

                end)

            if submitted then

                -- Cek apakah task berubah.
                local deadline =
                    os.clock() + 0.12

                while Farming
                    and os.clock() <
                        deadline do

                    local current =
                        getTask()

                    if current
                        and current ~= previousTask then

                        return true
                    end

                    RunService.Heartbeat:Wait()
                end

                -- Beberapa game tidak langsung
                -- mengganti text task.
                if attempt <
                    CFG.PHOTO_RETRIES then

                    task.wait(
                        CFG.PHOTO_RETRY_DELAY
                    )
                else

                    return true
                end
            end
        end
    end

    return false
end

--==================================================
-- AREA WHITELIST
--==================================================

local AREAS = {
    "Rooftop",
    "Courtyard",
    "Cafeteria",
    "Basketball Court",
    "Dojo Room",
    "Music Room",
    "Parking Lot",
    "Nishikata High Entrance",
    "Infirmary",
    "Study Room",
    "Lounge",
    "GAKUMART",
    "Nishikata District"
}

local function getArea(task)

    local lower =
        clean(task)

    for _, area in ipairs(AREAS) do

        if lower:find(
            clean(area),
            1,
            true
        ) then

            return area
        end
    end

    return nil
end

--==================================================
-- FIND AREA
--==================================================

local function findAreaPosition(
    area
)

    local wanted =
        clean(area)

    local best
    local bestScore = 0

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            local name =
                clean(object.Name)

            if name:find(
                wanted,
                1,
                true
            ) then

                local score =
                    #wanted

                if score > bestScore then

                    bestScore = score
                    best = object

                end
            end

            local landmark =
                object:FindFirstChild(
                    "PhotoJobLandmark"
                )

            if landmark
                and landmark:IsA("StringValue") then

                local value =
                    clean(landmark.Value)

                if value:find(
                    wanted,
                    1,
                    true
                ) then

                    best = object
                    bestScore =
                        #wanted + 100

                end
            end
        end
    end

    if best then
        return best.Position
    end

    return nil
end

--==================================================
-- AREA PHOTO
--==================================================

local function processArea(
    taskText
)

    local area =
        getArea(taskText)

    if not area then
        return false
    end

    -- MUSIC ROOM = REROLL
    if clean(area) ==
        "music room" then

        return false
    end

    local position =
        findAreaPosition(area)

    if not position then
        return false
    end

    if not Root then
        return false
    end

    local distance =
        (
            Root.Position
            - position
        ).Magnitude

    -- Direct movement for short distance.
    -- For long distance use direct PivotTo.
    if distance > 3 then

        pcall(function()

            Character:PivotTo(
                CFrame.new(position)
            )

        end)

    else

        Root.CFrame =
            CFrame.new(position)

    end

    RunService.Heartbeat:Wait()

    return takePhoto(
        nil,
        taskText
    )
end

--==================================================
-- RESTART JOB
--==================================================

local function restartJob()

    if not JobRemote then
        return
    end

    pcall(function()
        JobRemote:InvokeServer(
            "Stop"
        )
    end)

    RunService.Heartbeat:Wait()

    if Farming then

        pcall(function()
            JobRemote:InvokeServer(
                "Start"
            )
        end)
    end
end

--==================================================
-- PLAYER PROCESS
--==================================================

local function processPlayer(
    taskText
)

    local targetName =
        getTargetName(
            taskText
        )

    if not targetName then
        return false
    end

    local player =
        findPlayer(
            targetName
        )

    if not player then
        return false
    end

    autoView(player)

    -- Target bisa bergerak.
    -- Teleport dihitung tepat sebelum foto.
    local targetRoot =
        getTargetRoot(player)

    if not targetRoot then
        return false
    end

    if not teleportToPlayer(
        player
    ) then

        return false
    end

    if not Farming then
        return false
    end

    -- Pastikan target belum pindah jauh.
    local freshRoot =
        getTargetRoot(player)

    if not freshRoot then
        return false
    end

    local targetPosition =
        freshRoot.Position

    local distance =
        (
            Root.Position
            - targetPosition
        ).Magnitude

    if distance >
        CFG.TARGET_MOVE_TOLERANCE then

        if not teleportToPlayer(
            player
        ) then

            return false
        end
    end

    return takePhoto(
        player,
        taskText
    )
end

--==================================================
-- MAIN PROCESS
--==================================================

local function process()

    if not Farming
        or Processing then

        return
    end

    local taskText =
        getTask()

    if not taskText
        or taskText == "" then

        return
    end

    local lower =
        clean(taskText)

    if lower:find(
        "waiting for assignment",
        1,
        true
    ) then

        pcall(function()

            JobRemote:InvokeServer(
                "Start"
            )

        end)

        return
    end

    -- MUSIC ROOM
    if lower:find(
        "music room",
        1,
        true
    ) then

        restartJob()
        return
    end

    -- PLAYER
    if getTargetName(
        taskText
    ) then

        local target =
            findPlayer(
                getTargetName(
                    taskText
                )
            )

        if target then

            Processing = true

            local success =
                processPlayer(
                    taskText
                )

            Processing = false

            if success then

                LastTask = ""

            else

                LastTask = ""

                restartJob()
            end

            return
        end
    end

    -- AREA
    if getArea(
        taskText
    ) then

        if LastTask ==
            taskText then

            return
        end

        LastTask = taskText
        Processing = true

        local success =
            processArea(
                taskText
            )

        Processing = false

        if not success then

            LastTask = ""
            restartJob()

        end

        return
    end

    -- UNKNOWN TASK
    restartJob()
end

--==================================================
-- START
--==================================================

local function start()

    if Farming then
        return
    end

    if not findRemotes() then
        warn(
            "[PHOTO FARM] Remotes not found"
        )
        return
    end

    Farming = true
    Processing = false
    LastTask = ""

    task.spawn(function()

        while Farming do

            pcall(
                process
            )

            task.wait(
                CFG.LOOP_DELAY
            )
        end

    end)

    print(
        "[PHOTO FARM] ULTRA-FAST ON"
    )
end

--==================================================
-- STOP
--==================================================

local function stop()

    Farming = false
    Processing = false

    if JobRemote then

        pcall(function()

            JobRemote:InvokeServer(
                "Stop"
            )

        end)
    end

    print(
        "[PHOTO FARM] OFF"
    )
end

--==================================================
-- GLOBAL API
--==================================================

_G.StartFarming = start

_G.StopFarming = stop

_G.SetAutoView = function(value)

    CFG.AUTO_VIEW =
        value == true

end

_G.GetAutoView = function()

    return CFG.AUTO_VIEW

end

_G.ClearViewMemory = function()

    LastViewTarget = ""

end

_G.PhotoFarmStatus = function()

    print("========== PHOTO FARM ==========")
    print("Farming:", Farming)
    print("Processing:", Processing)
    print("Last Task:", LastTask)
    print("Last View:", LastViewTarget)
    print("Photo Attempts:", PhotoAttempts)
    print("Teleport Attempts:", TeleportAttempts)
    print("================================")

end

