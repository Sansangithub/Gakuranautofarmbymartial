local function zeroVelocity()
	if HRP and HRP.Parent then
		HRP.AssemblyLinearVelocity = Vector3.zero
		HRP.AssemblyAngularVelocity = Vector3.zero
	end
end

local function cancelTween()
	if currentTween then
		pcall(function() currentTween:Cancel() end)
		currentTween = nil
	end
	State.tweening = false
end

local function placeCharacterAt(targetCFrame)
	if not Character or not Character.Parent or not HRP or not HRP.Parent then return false end
	if Humanoid and Humanoid.SeatPart then Humanoid.Sit = false end
	zeroVelocity()
	local ok = pcall(function()
		Character:PivotTo(targetCFrame)
		HRP.CFrame = targetCFrame
	end)
	zeroVelocity()
	RunService.Heartbeat:Wait()
	zeroVelocity()
	return ok
end

local function smoothTween(position)
	if not HRP or not HRP.Parent or not State.farming then return false end
	local distance = (position - HRP.Position).Magnitude
	if distance <= S.MaxDistance then
		placeCharacterAt(CFrame.new(position))
		return true
	end
	cancelTween()
	State.tweening = true
	local duration = math.clamp(distance / S.TweenSpeed, S.MinDuration, S.MaxDuration)
	currentTween = TweenService:Create(
		HRP,
		TweenInfo.new(duration, Enum.EasingStyle.Linear),
		{ CFrame = CFrame.new(position) }
	)
	currentTween:Play()
	local finished = false
	local connection = currentTween.Completed:Connect(function()
		finished = true
	end)
	while State.farming and not finished do
		task.wait()
	end
	connection:Disconnect()
	currentTween = nil
	State.tweening = false
	zeroVelocity()
	return State.farming
end

