--==================================================
-- PLAYER TARGET
--==================================================

local PHOTO_PREFIXES = {

    "get a photo of ",
    "take a photo of ",
    "take photo of ",
    "a photo of ",
    "photo of ",
    "photograph of ",
    "photograph ",
    "get a picture of ",
    "take a picture of ",
    "take picture of ",
    "picture of "
}

local function getPhotoTargetText(
    taskText
)

    if not taskText then
        return nil
    end

    local original =
        tostring(taskText)

    local lower =
        original:lower()

    for _, prefix in ipairs(
        PHOTO_PREFIXES
    ) do

        if lower:sub(
            1,
            #prefix
        ) == prefix then

            local target =
                original:sub(
                    #prefix + 1
                )

            target =
                normalizePlayerName(
                    target
                )

            if target ~= "" then
                return target
            end
        end
    end

    return nil
end

--==================================================
-- PLAYER LOOKUP
--==================================================

local function getPlayerByText(
    targetText
)

    if not targetText then
        return nil
    end

    local target =
        normalizePlayerName(
            targetText
        )

    local lower =
        target:lower()

    if lower == "" then
        return nil
    end

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
            and player.Name:lower() ==
                lower then

            return player
        end
    end

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
            and player.DisplayName:lower() ==
                lower then

            return player
        end
    end

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            if player.Name:lower():find(
                lower,
                1,
                true
            )
            or player.DisplayName:lower():find(
                lower,
                1,
                true
            ) then

                return player
            end
        end
    end

    return nil
end

