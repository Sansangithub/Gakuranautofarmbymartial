local function normalizePlayerName(text)

    if not text then
        return ""
    end

    text =
        tostring(text)

    text =
        text:match(
            "^%s*(.-)%s*$"
        )

    text =
        text:gsub(
            "[%.,!?:;]+$",
            ""
        )

    return text
end

