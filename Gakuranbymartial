--==================================================
-- INITIALIZATION
--==================================================

task.spawn(function()

    local attempts = 0

    -- Find remotes
    while not findRemotes()
        and attempts < 30 do

        attempts += 1

        task.wait(1)
    end

    if not phoneScreenPush
        or not photoJobSubmit then

        stopFarming(
            "PhotoJob remotes not found"
        )

        return
    end

    -- First job
    startNewJob()

    task.wait(
        S.StartDelay
    )

    -- Auto start
    if S.Enabled
        and S.AutoStart then

        State.farming = true
        State.processing = false
        State.restarting = false

        State.lastTask = ""
        State.taskCount = 0
        State.restartCount = 0
        State.stopReason = ""

        task.spawn(
            farmLoop
        )
    end
end)

--==================================================
-- GLOBAL START
--==================================================

_G.StartFarming = function()

    if State.farming then
        return
    end

    if not findRemotes() then

        State.stopReason =
            "PhotoJob remotes not found"

        return
    end

    State.farming = true
    State.processing = false
    State.tweening = false
    State.restarting = false

    State.lastTask = ""
    State.taskCount = 0
    State.restartCount = 0
    State.stopReason = ""

    setCollision(true)

    startNewJob()

    task.spawn(
        farmLoop
    )
end

