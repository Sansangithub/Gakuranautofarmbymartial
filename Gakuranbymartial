--==================================================
-- AUTO ;VIEW COMMAND
--==================================================

local function sendViewCommand(
    playerName
)

    if not S.AutoViewCommandEnabled then
        return false
    end

    if not playerName then
        return false
    end

    playerName =
        normalizePlayerName(
            playerName
        )

    if playerName == "" then
        return false
    end

    local command =
        ";view " .. playerName

    --==================================================
    -- PREVENT SAME COMMAND SPAM
    --==================================================

    if State.lastViewCommand ==
        command then

        return true
    end

    State.lastViewCommand =
        command

    --==================================================
    -- TEXT CHAT SERVICE
    --==================================================

    if TextChatService.ChatVersion ==
        Enum.ChatVersion.TextChatService then

        local textChannels =
            TextChatService:FindFirstChild(
                "TextChannels"
            )

        if not textChannels then
            State.lastViewCommand = ""
            return false
        end

        local general =
            textChannels:FindFirstChild(
                "RBXGeneral"
            )

        if not general then
            State.lastViewCommand = ""
            return false
        end

        local success =
            pcall(
                function()

                    general:SendAsync(
                        command
                    )
                end
            )

        if not success then
            State.lastViewCommand = ""
        end

        return success
    end

    --==================================================
    -- LEGACY CHAT
    --==================================================

    local chatEvents =
        ReplicatedStorage:
        FindFirstChild(
            "DefaultChatSystemChatEvents"
        )

    if chatEvents then

        local sayMessage =
            chatEvents:
            FindFirstChild(
                "SayMessageRequest"
            )

        if sayMessage then

            local success =
                pcall(
                    function()

                        sayMessage:
                        FireServer(
                            command,
                            "All"
                        )
                    end
                )

            if not success then
                State.lastViewCommand = ""
            end

            return success
        end
    end

    State.lastViewCommand = ""

    return false
end

