                    if landmarkValue:find(term, 1, true) then
                        local score = 1000 + #term
                        if landmarkValue == term then score += 10000 end
                        if area == "Music Room" and landmarkValue:find("music room", 1, true) then
                            score += 5000
                        end
                        if score > bestScore then
                            bestScore = score
                            bestPosition = position
                        end
                    end
                end
            end
        end
    end

    return bestPosition
end

--==================================================
-- JOB & SESSION CONTROL
--==================================================

local function stopCurrentJob()
    if not photoJobSubmit then return false end
    return pcall(function()
        photoJobSubmit:InvokeServer("Stop")
    end)
end

local function startNewJob()
    if not State.farming or not photoJobSubmit then return false end

    local now = os.clock()
    if now - State.lastStartRequest < S.StartCooldown then
        return false
    end

    State.lastStartRequest = now
    return pcall(function()
        photoJobSubmit:InvokeServer("Start")
    end)
end

local function isCurrentSession(sessionId)
    return State.farming and State.sessionId == sessionId
end

local function forceStartNewJob(sessionId)
    if not isCurrentSession(sessionId) then return false end

    State.lastStartRequest = 0
    pcall(function()
        if photoJobSubmit then
            photoJobSubmit:InvokeServer("Stop")
        end
    end)

    if not isCurrentSession(sessionId) then return false end
    task.wait(0.01)
    if not isCurrentSession(sessionId) then return false end

    State.lastStartRequest = os.clock()
    return pcall(function()
        photoJobSubmit:InvokeServer("Start")
    end)
end

local function restartJobAfterAreaPhotoFailure(sessionId, failedTask)
    if not isCurrentSession(sessionId) or State.restarting then
        return false
    end

    State.restarting = true
    State.processing = false
    State.lastTask = ""
    stopPlayerView()
    zeroVelocity()

    State.lastStartRequest = 0
    pcall(function()
        if photoJobSubmit then
            photoJobSubmit:InvokeServer("Stop")
        end
    end)

    task.wait(S.RestartDelay)

    if not isCurrentSession(sessionId) then
        State.restarting = false
        return false
    end

    State.lastStartRequest = 0
    local started = pcall(function()
        photoJobSubmit:InvokeServer("Start")
    end)

    if not started then
        State.restarting = false
        return false
    end

    local deadline = os.clock() + 2
    while isCurrentSession(sessionId) and os.clock() < deadline do
        local newTask = getTaskText()
        if newTask and newTask ~= "" then
            local lower = newTask:lower()
            if not lower:find("waiting for assignment", 1, true) and newTask ~= failedTask then
                State.lastTask = ""
                State.currentPhotoFailure = 0
                State.restarting = false
                return true
            end
        end
        task.wait(S.AssignmentWait)
    end

    State.restarting = false
    return false
end

local function waitForNewAssignment()
    local deadline = os.clock() + 2
    while State.farming and os.clock() < deadline do
        local text = getTaskText()
        if text and text ~= "" then
            if not text:lower():find("waiting for assignment", 1, true) then
                return text
            end
        end
        task.wait(S.AssignmentWait)
    end
    return nil
end

local function waitForPhotoResult(previousTask)
    local timeout = math.max(0.03, tonumber(S.PhotoConfirmTimeout) or 0.10)
    local deadline = os.clock() + timeout

    while State.farming and os.clock() < deadline do
        local currentTask = getTaskText()
        if currentTask and currentTask ~= "" and currentTask ~= previousTask then
            return true
        end
        task.wait(0.005)
    end

    return false
end

--==================================================
-- PHOTO BUFFER & CAPTURE
--==================================================

local PhotoBuffer

local function createPhotoBuffer()
    local ok, result = pcall(function()
        local data = buffer.create(7)
        buffer.writeu8(data, 0, 1)
        buffer.writeu8(data, 1, 4)
        buffer.writeu8(data, 2, 0)
        buffer.writeu8(data, 3, 1)
        buffer.writeu8(data, 4, 1)
        buffer.writeu8(data, 5, 42)
        buffer.writeu8(data, 6, 24)
        return data
    end)

    if ok then return result end
    return nil
end

PhotoBuffer = createPhotoBuffer()

local function takePhoto(targetPosition, previousTask)
    if not State.farming or not phoneScreenPush or not photoJobSubmit then
        return false
    end

    if not HRP or not HRP.Parent then
        return false
    end

    if not PhotoBuffer then
        PhotoBuffer = createPhotoBuffer()
        if not PhotoBuffer then return false end
    end

    local lookAt = targetPosition
    if not lookAt then
        lookAt = HRP.Position + HRP.CFrame.LookVector * 10
    end

    for attempt = 1, S.PhotoRetryCount do
        if not State.farming then return false end
        State.photoAttempts += 1

        local pushOK = pcall(phoneScreenPush.FireServer, phoneScreenPush, PhotoBuffer)
        if pushOK then
            if not HRP or not HRP.Parent then return false end

            local photoPosition = HRP.Position
            local lookDirection = lookAt - photoPosition
            local photoCFrame = lookDirection.Magnitude > 0.05
                and CFrame.lookAt(photoPosition, lookAt)
                or HRP.CFrame

            local invokeOK, serverResult = pcall(
                photoJobSubmit.InvokeServer,
                photoJobSubmit,
                "Submit",
                photoCFrame
            )

            if invokeOK then
                if serverResult == true then
                    return true
                end
                if serverResult ~= false then
                    if waitForPhotoResult(previousTask) then
                        return true
                    end
                end
            end
        end

        if attempt < S.PhotoRetryCount then
            task.wait(S.PhotoRetryDelay)
        end
    end

    return false
end

--==================================================
-- TELEPORT TO PLAYER & AREA
--==================================================

local function teleportToPlayer(targetPlayer)
    if not State.farming or not HRP or not HRP.Parent then
        return false
    end
    if not targetPlayer or not targetPlayer.Parent then
        return false
    end

    zeroVelocity()

    local safeDistance = math.max(3.0, tonumber(S.PlayerSafeDistance) or 3.5)

    for _ = 1, S.TeleportRetryCount do
        if not State.farming then
            return false
        end

        State.teleportAttempts += 1

        local character = targetPlayer.Character
        local targetHRP = character and character:FindFirstChild("HumanoidRootPart")

        if targetHRP then
            local targetPosition = targetHRP.Position
            local flatLook = Vector3.new(targetHRP.CFrame.LookVector.X, 0, targetHRP.CFrame.LookVector.Z)
            if flatLook.Magnitude < 0.05 then
                flatLook = Vector3.new(0, 0, -1)
            else
                flatLook = flatLook.Unit
            end

            local destination = targetPosition - (flatLook * safeDistance) + Vector3.new(0, 0.5, 0)
            local destinationCFrame = CFrame.lookAt(destination, targetPosition)

            placeCharacterAt(destinationCFrame)

            if HRP and HRP.Parent then
                local destinationDistance = (HRP.Position - destination).Magnitude
                local actualDistance = (HRP.Position - targetPosition).Magnitude

                if destinationDistance <= S.TeleportDistanceTolerance and actualDistance >= 2.0 then
                    placeCharacterAt(CFrame.lookAt(HRP.Position, targetPosition))
                    return true
                end
            end
        end

        task.wait(S.TeleportRetryDelay)
    end

    zeroVelocity()
    return false
end

local function teleportToAreaExact(position, customTolerance, customRetries)
    if not State.farming or not position or not Character or not Character.Parent or not HRP or not HRP.Parent then
        return false
    end

    zeroVelocity()

    local attempts = math.max(1, tonumber(customRetries or S.AreaTeleportRetryCount) or 8)
    local tolerance = math.max(0.2, tonumber(customTolerance or S.AreaTeleportTolerance) or 1.25)

    local safeTargetPosition = position + Vector3.new(0, 0.5, 0)

    for attempt = 1, attempts do
        if not State.farming then
            return false
        end

        State.teleportAttempts += 1

        local targetCFrame = CFrame.new(safeTargetPosition)
        local moved = placeCharacterAt(targetCFrame)

        if moved and HRP and HRP.Parent then
            local distance = (HRP.Position - safeTargetPosition).Magnitude
            local rawDistance = (HRP.Position - position).Magnitude

            if distance <= tolerance or rawDistance <= (tolerance + 0.5) then
                placeCharacterAt(CFrame.new(position))
                return true
            end
        end

        if attempt < attempts then
            task.wait(S.AreaTeleportDelay)
        end
    end

    zeroVelocity()
    return false
end

--==================================================
-- TASK EXECUTION
--==================================================

local function processPlayerTask(taskText)
    local target = findPlayerTarget(taskText)
    if not target then
        stopPlayerView()
        return false
    end

    local player = target.player
    State.targetUsername = player.Name

    if S.AutoViewCommandEnabled then
        sendViewCommand(player.Name)
        if S.AutoViewCommandDelay > 0 then
            task.wait(S.AutoViewCommandDelay)
        end
    end

    if not State.farming then return false end

    local teleported = teleportToPlayer(player)
    if not teleported or not State.farming then
        return false
    end

    local character = player.Character
    local targetHRP = character and character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then
        return false
    end

    local success = takePhoto(targetHRP.Position, taskText)
    zeroVelocity()
    stopPlayerView()

    if success then
        State.lastTask = ""
        State.processing = false
        State.targetPlayer = ""
        State.targetUsername = ""
        State.currentPhotoFailure = 0
        task.wait(S.SuccessDelay)
        return true
    end

    State.currentPhotoFailure += 1
    return false
end

local function processAreaTask(taskText)
    stopPlayerView()

    local area = resolveArea(taskText)
    local position = findLocation(taskText)

    if not area or not position then
        return false
    end

    local isRooftop = area == "Rooftop"
    local tolerance = isRooftop
        and math.max(0.2, tonumber(S.RooftopTeleportTolerance) or 1.0)
        or math.max(0.2, tonumber(S.AreaTeleportTolerance) or 1.25)
    local retries = isRooftop
        and S.RooftopTeleportRetryCount
        or S.AreaTeleportRetryCount

    local teleportOK = teleportToAreaExact(position, tolerance, retries)
    if not teleportOK or not State.farming or not HRP or not HRP.Parent then
        return false
    end

    local verifiedPosition = position
    local originalPhotoRetryCount = S.PhotoRetryCount
    if isRooftop then
        S.PhotoRetryCount = math.max(1, tonumber(S.RooftopPhotoRetryCount) or 3)
    end

    local success = takePhoto(verifiedPosition, taskText)

    S.PhotoRetryCount = originalPhotoRetryCount
    zeroVelocity()

    if success then
        State.lastTask = ""
        State.processing = false
        State.currentPhotoFailure = 0
        task.wait(S.SuccessDelay)
        return true
    end

    State.currentPhotoFailure += 1
    return false
end

local function isPlayerPhotoTask(taskText)
    local target = getPhotoTargetText(taskText)
    if not target then return false end
    if resolveArea(taskText) then return false end

    return getPlayerByText(target) ~= nil or findPlayerByInfo(target) ~= nil
end

local function restartUntilValidTask(sessionId)
    if not isCurrentSession(sessionId) or State.restarting then
        return false
    end

    State.restarting = true
    stopPlayerView()

    for _ = 1, 20 do
        if not isCurrentSession(sessionId) then break end

        stopCurrentJob()
        task.wait(S.RestartDelay)

        if not isCurrentSession(sessionId) then break end

        startNewJob()
        local taskText = waitForNewAssignment()

        if taskText then
            if isPlayerPhotoTask(taskText) then
                local target = findPlayerTarget(taskText)
                if target then
                    State.lastTask = ""
                    State.restarting = false
                    return true
                end
            elseif resolveArea(taskText) then
                State.lastTask = ""
                State.restarting = false
                return true
            end
        end

        State.restartCount += 1
    end

    State.restarting = false
    return false
end

processTask = function()
    if not State.farming or State.processing or State.restarting then
        return
    end

    local taskText = getTaskText()

    if not taskText or taskText == "" then
        startNewJob()
        return
    end

    local lower = taskText:lower()
    if lower:find("waiting for assignment", 1, true) then
        startNewJob()
        return
    end

    if resolveArea(taskText) then
        if State.lastTask == taskText then return end

        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        local success = processAreaTask(taskText)
        State.processing = false

        if success then return end

        State.lastTask = ""
        restartJobAfterAreaPhotoFailure(State.sessionId, taskText)
        return
    end

    if isPlayerPhotoTask(taskText) then
        if State.lastTask == taskText then return end

        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        local success = processPlayerTask(taskText)
        State.processing = false

        if success then return end

        State.lastTask = ""
        task.wait(S.PhotoRetryDelay)
        return
    end

    State.stopReason = "Invalid task: " .. tostring(taskText)
    restartUntilValidTask(State.sessionId)
end

