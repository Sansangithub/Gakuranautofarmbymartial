--==================================================
-- PHOTO TARGET
--==================================================

local PHOTO_PREFIXES = {
    "get a photo of ",
    "take a photo of ",
    "take photo of ",
    "a photo of ",
    "photo of ",
    "photograph of ",
    "photograph ",
    "get a picture of ",
    "take a picture of ",
    "take picture of ",
    "picture of "
}

local function getPhotoTargetText(taskText)
    if not taskText then
        return nil
    end

    local original =
        tostring(taskText)

    local lower =
        original:lower()

    for _, prefix in ipairs(
        PHOTO_PREFIXES
    ) do
        if lower:sub(1, #prefix) == prefix then
            local target =
                original:sub(
                    #prefix + 1
                )

            target =
                normalizePlayerName(
                    target
                )

            if target ~= "" then
                return target
            end
        end
    end

    return nil
end

--==================================================
-- PLAYER LOOKUP
--==================================================

local function getPlayerByText(targetText)
    if not targetText then
        return nil
    end

    local target =
        normalizePlayerName(
            targetText
        )

    local lower =
        target:lower()

    if lower == "" then
        return nil
    end

    -- USERNAME EXACT
    for _, player in ipairs(
        Players:GetPlayers()
    ) do
        if player ~= LocalPlayer
            and player.Name:lower() == lower then

            return player
        end
    end

    -- DISPLAY EXACT
    for _, player in ipairs(
        Players:GetPlayers()
    ) do
        if player ~= LocalPlayer
            and player.DisplayName:lower() == lower then

            return player
        end
    end

    -- PARTIAL
    for _, player in ipairs(
        Players:GetPlayers()
    ) do
        if player ~= LocalPlayer then
            if player.Name:lower():find(
                lower,
                1,
                true
            )
            or player.DisplayName:lower():find(
                lower,
                1,
                true
            ) then

                return player
            end
        end
    end

    return nil
end

--==================================================
-- FIND PLAYER BY INFO
--==================================================

local function findPlayerByInfo(targetText)
    if not targetText then
        return nil
    end

    local target =
        normalizePlayerName(
            targetText
        ):lower()

    if target == "" then
        return nil
    end

    for _, player in ipairs(
        Players:GetPlayers()
    ) do
        if player ~= LocalPlayer then
            local character =
                player.Character

            if character then
                local info =
                    character:FindFirstChild(
                        "Info",
                        true
                    )

                if info
                    and info:IsA("TextLabel") then

                    local infoText =
                        tostring(
                            info.Text or ""
                        ):lower()

                    if infoText:find(
                        target,
                        1,
                        true
                    )
                    or infoText == player.Name:lower()
                    or infoText == player.DisplayName:lower() then

                        local targetHRP =
                            character:FindFirstChild(
                                "HumanoidRootPart"
                            )

                        if targetHRP then
                            return player
                        end
                    end
                end
            end
        end
    end

    return getPlayerByText(target)
end

local function findPlayerTarget(taskText)
    local requested =
        getPhotoTargetText(taskText)

    if not requested then
        return nil
    end

    State.targetPlayer =
        requested

    -- FAST PATH
    local direct =
        getPlayerByText(requested)

    if direct then
        local root =
            direct.Character
            and direct.Character:FindFirstChild(
                "HumanoidRootPart"
            )

        if root then
            State.targetUsername =
                direct.Name

            return {
                player = direct,
                character = direct.Character,
                hrp = root
            }
        end
    end

    -- INFO PATH
    for _ = 1,
        S.PlayerSearchAttempts do

        if not State.farming then
            return nil
        end

        local player =
            findPlayerByInfo(
                requested
            )

        if player then
            local character =
                player.Character

            if character then
                local targetHRP =
                    character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if targetHRP then
                    State.targetUsername =
                        player.Name

                    return {
                        player = player,
                        character = character,
                        hrp = targetHRP
                    }
                end
            end
        end

        if S.PlayerSearchDelay > 0 then
            task.wait(
                S.PlayerSearchDelay
            )
        else
            RunService.Heartbeat:Wait()
        end
    end

    return nil
end

--==================================================
-- AREA
--==================================================

local function resolveArea(taskText)
    local normalized =
        normalizeText(
            taskText
        )

    if normalized == "" then
        return nil
    end

    for _, entry in ipairs(
        AREA_TASKS
    ) do
        local canonical =
            entry.canonical:lower()

        if normalized == canonical
            or normalized:find(
                canonical,
                1,
                true
            ) then

            return entry.canonical
        end

        for _, alias in ipairs(
            entry.aliases
        ) do
            alias = alias:lower()

            if normalized == alias
                or normalized:find(
                    alias,
                    1,
                    true
                ) then

                return entry.canonical
            end
        end
    end

    return nil
end

local function isRejectedTask(taskText)
    return resolveArea(taskText) ==
        "Music Room"
end

--==================================================
-- AREA CACHE
--==================================================

local function refreshAreaCache()
    local now = os.clock()

    if now - State.lastAreaScan <
        S.AreaScanInterval then

        return
    end

    State.lastAreaScan = now

    local cache = {}

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do
        if object:IsA("BasePart") then
            local lower =
                object.Name:lower()

            for _, entry in ipairs(
                AREA_TASKS
            ) do
                if lower:find(
                    entry.canonical:lower(),
                    1,
                    true
                ) then

                    cache[entry.canonical] =
                        object.Position
                end

                for _, alias in ipairs(
                    entry.aliases
                ) do
                    if lower:find(
                        alias:lower(),
                        1,
                        true
                    ) then

                        cache[entry.canonical] =
                            object.Position
                    end
                end

                local landmark =
                    object:FindFirstChild(
                        "PhotoJobLandmark"
                    )

                if landmark
                    and landmark:IsA("StringValue") then

                    local value =
                        landmark.Value:lower()

                    if value:find(
                        entry.canonical:lower(),
                        1,
                        true
                    ) then

                        cache[entry.canonical] =
                            object.Position
                    end

                    for _, alias in ipairs(
                        entry.aliases
                    ) do
                        if value:find(
                            alias:lower(),
                            1,
                            true
                        ) then

                            cache[entry.canonical] =
                                object.Position
                        end
                    end
                end
            end
        end
    end

    State.cachedAreaPositions =
        cache
end

--==================================================
-- FIND AREA
--==================================================

local function findLocation(taskText)
    local area =
        resolveArea(taskText)

    if not area then
        return nil
    end

    refreshAreaCache()

    if State.cachedAreaPositions[area] then
        return State.cachedAreaPositions[area]
    end

    -- FALLBACK SCAN
    local terms = {
        area:lower(),
        normalizeText(taskText)
    }

    for _, entry in ipairs(
        AREA_TASKS
    ) do
        if entry.canonical == area then
            for _, alias in ipairs(
                entry.aliases
            ) do
                table.insert(
                    terms,
                    alias:lower()
                )
            end
        end
    end

    local best
    local bestScore = 0

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do
        if object:IsA("BasePart") then
            local name =
                object.Name:lower()

            for _, term in ipairs(terms) do
                if term ~= ""
                    and name:find(
                        term,
                        1,
                        true
                    ) then

                    local score =
                        #term

                    if score > bestScore then
                        bestScore = score
                        best = object
                    end
                end
            end
        end
    end

    if best then
        State.cachedAreaPositions[area] =
            best.Position

        return best.Position
    end

    return nil
end

