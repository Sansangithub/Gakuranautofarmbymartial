            dragging = true
            dragStart = input.Position
            startPosition = MainFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end)

    ToggleButton.Activated:Connect(function()
        if State.farming then
            S.AutoViewCommandEnabled = false
            stopFarmingFromGUI()
        else
            S.AutoViewCommandEnabled = true
            startFarming()
        end
        updateGUI()
    end)

    AutoViewButton.Activated:Connect(function()
        S.AutoViewCommandEnabled = not S.AutoViewCommandEnabled
        if S.AutoViewCommandEnabled then
            setChatStatus("AUTO ;VIEW ON", true)
        else
            setChatStatus("AUTO ;VIEW OFF", nil)
        end
        updateGUI()
    end)

    SendChatButton.Activated:Connect(function()
        local message = ChatBox.Text
        if message == "" then
            setChatStatus("CHAT EMPTY", false)
            return
        end
        if sendChatMessage(message) then
            ChatBox.Text = ""
        end
    end)

    ChatBox.FocusLost:Connect(function(enterPressed)
        if not enterPressed then return end
        local message = ChatBox.Text
        if message == "" then return end
        if sendChatMessage(message) then
            ChatBox.Text = ""
        end
    end)
end

updateGUI = function()
    if not ToggleButton or not StatusLabel then return end

    if State.farming then
        ToggleButton.Text = "FARM + VIEW ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(45, 170, 80)
        StatusLabel.Text = "FARMING"
        StatusLabel.TextColor3 = Color3.fromRGB(80, 255, 120)
    else
        ToggleButton.Text = "FARM + VIEW OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(170, 45, 45)
        StatusLabel.Text = "OFF"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    end

    if AutoViewButton then
        if S.AutoViewCommandEnabled then
            AutoViewButton.Text = "VIEW ON"
            AutoViewButton.BackgroundColor3 = Color3.fromRGB(45, 170, 80)
        else
            AutoViewButton.Text = "VIEW OFF"
            AutoViewButton.BackgroundColor3 = Color3.fromRGB(170, 45, 45)
        end
    end
end

