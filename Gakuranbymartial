--==================================================
-- WAIT NEW ASSIGNMENT
--==================================================

local function waitForNewAssignment()

    local deadline =
        os.clock() + 5

    while State.farming
        and os.clock() < deadline do

        local taskText =
            getTaskText()

        if taskText
            and taskText ~= "" then

            local lower =
                taskText:lower()

            if not lower:find(
                "waiting for assignment",
                1,
                true
            ) then

                return taskText
            end
        end

        task.wait(
            S.AssignmentWait
        )
    end

    return nil
end

--==================================================
-- RESTART JOB PLAYER NOT FOUND
--==================================================

local function restartJobPlayerNotFound()

    if not State.farming then
        return false
    end

    if State.restarting then
        return false
    end

    State.restarting = true
    State.processing = false
    State.tweening = false

    State.stopReason =
        "Player not found -> reroll"

    State.targetPlayer = ""
    State.targetUsername = ""

    stopSpectate()
    cancelTween()
    setCollision(true)

    -- STOP CURRENT JOB

    stopCurrentJob()

    State.restartCount += 1

    task.wait(
        S.RestartDelay
    )

    if not State.farming then

        State.restarting = false

        return false
    end

    -- START NEW JOB

    startNewJob()

    task.wait(
        S.StartDelay
    )

    if not State.farming then

        State.restarting = false

        return false
    end

    -- WAIT NEW TASK

    local newTask =
        waitForNewAssignment()

    if not State.farming then

        State.restarting = false

        return false
    end

    State.lastTask = ""
    State.restarting = false

    return newTask ~= nil
end

--==================================================
-- RESTART UNTIL VALID
--==================================================

local function restartUntilValidTask()

    if not State.farming then
        return false
    end

    if State.restarting then
        return false
    end

    State.restarting = true
    State.processing = false
    State.tweening = false

    State.targetPlayer = ""
    State.targetUsername = ""

    stopSpectate()
    cancelTween()
    setCollision(true)

    while State.farming do

        local taskText =
            getTaskText()

        if taskText
            and taskText ~= "" then

            local lower =
                taskText:lower()

            if not lower:find(
                "waiting for assignment",
                1,
                true
            ) then

                -- PLAYER

                if isPlayerPhotoTask(
                    taskText
                ) then

                    local target =
                        findPlayerTarget(
                            taskText
                        )

                    if target then

                        State.lastTask = ""
                        State.restarting = false

                        return true
                    end

                -- AREA

                elseif isWhitelistedTask(
                    taskText
                )
                and not isRejectedTask(
                    taskText
                ) then

                    State.lastTask = ""
                    State.restarting = false

                    return true
                end
            end
        end

        stopCurrentJob()

        State.restartCount += 1

        task.wait(
            S.RestartDelay
        )

        if not State.farming then
            break
        end

        startNewJob()

        task.wait(
            S.StartDelay
        )

        local newTask =
            waitForNewAssignment()

        if not newTask then
            continue
        end

        if isRejectedTask(
            newTask
        ) then

            continue
        end

        if isPlayerPhotoTask(
            newTask
        ) then

            local target =
                findPlayerTarget(
                    newTask
                )

            if target then

                State.lastTask = ""
                State.restarting = false

                return true
            end

            continue

        elseif isWhitelistedTask(
            newTask
        ) then

            State.lastTask = ""
            State.restarting = false

            return true
        end
    end

    State.restarting = false

    return false
end

--==================================================
-- FIND AREA LOCATION
--==================================================

local function findLocation(taskText)

    local area =
        resolveArea(
            taskText
        )

    if not area then
        return nil
    end

    local searchTerms = {}

    table.insert(
        searchTerms,
        area:lower()
    )

    table.insert(
        searchTerms,
        normalizeText(
            taskText
        )
    )

    if area == "GAKUMART" then

        table.insert(
            searchTerms,
            "gakumart"
        )

        table.insert(
            searchTerms,
            "gaku mart"
        )
    end

    if area == "Rooftop" then

        table.insert(
            searchTerms,
            "rooftop"
        )

        table.insert(
            searchTerms,
            "roof"
        )
    end

    local bestPart
    local bestScore = 0

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            local objectName =
                object.Name:lower()

            for _, term in ipairs(
                searchTerms
            ) do

                if term ~= ""
                    and objectName:find(
                        term,
                        1,
                        true
                    ) then

                    local score =
                        #term

                    if score > bestScore then

                        bestScore = score
                        bestPart = object
                    end
                end
            end

            local landmark =
                object:FindFirstChild(
                    "PhotoJobLandmark"
                )

            if landmark
                and landmark:IsA(
                    "StringValue"
                ) then

                local value =
                    landmark.Value:lower()

                for _, term in ipairs(
                    searchTerms
                ) do

                    if term ~= ""
                        and value:find(
                            term,
                            1,
                            true
                        ) then

                        local score =
                            #term + 100

                        if score > bestScore then

                            bestScore = score
                            bestPart = object
                        end
                    end
                end
            end
        end
    end

    if bestPart then
        return bestPart.Position
    end

    return nil
end

--==================================================
-- AREA TWEEN
--==================================================

local function smoothTween(
    targetPosition
)

    if not HRP then
        return false
    end

    if not State.farming then
        return false
    end

    cancelTween()

    local startPosition =
        HRP.Position

    local distance =
        (
            targetPosition
            - startPosition
        ).Magnitude

    if distance <= S.MaxDistance then

        HRP.CFrame =
            CFrame.new(
                targetPosition
            )

        setCollision(true)

        return true
    end

    setCollision(false)

    State.tweening = true

    local duration =
        math.clamp(
            distance / S.TweenSpeed,
            S.MinDuration,
            S.MaxDuration
        )

    currentTween =
        TweenService:Create(
            HRP,

            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),

            {
                CFrame =
                    CFrame.new(
                        targetPosition
                    )
            }
        )

    currentTween:Play()

    local completed = false

    local connection =
        currentTween.Completed:Connect(
            function()
                completed = true
            end
        )

    while not completed do

        if not State.farming then

            connection:Disconnect()

            cancelTween()
            setCollision(true)

            return false
        end

        task.wait()
    end

    connection:Disconnect()

    currentTween = nil
    State.tweening = false

    setCollision(true)

    return true
end

--==================================================
-- FAST PHOTO
--==================================================

local function takePhoto(
    targetPosition
)

    if not State.farming then
        return false
    end

    if not phoneScreenPush
        or not photoJobSubmit
        or not HRP then

        return false
    end

    local bufferData =
        buffer.create(7)

    buffer.writeu8(
        bufferData,
        0,
        1
    )

    buffer.writeu8(
        bufferData,
        1,
        4
    )

    buffer.writeu8(
        bufferData,
        2,
        0
    )

    buffer.writeu8(
        bufferData,
        3,
        1
    )

    buffer.writeu8(
        bufferData,
        4,
        1
    )

    buffer.writeu8(
        bufferData,
        5,
        42
    )

    buffer.writeu8(
        bufferData,
        6,
        24
    )

    local pushSuccess =
        pcall(
            phoneScreenPush.FireServer,
            phoneScreenPush,
            bufferData
        )

    if not pushSuccess then
        return false
    end

    if not State.farming then
        return false
    end

    local lookAt =
        targetPosition
        or (
            HRP.Position
            + HRP.CFrame.LookVector * 10
        )

    local submitSuccess =
        pcall(
            photoJobSubmit.InvokeServer,
            photoJobSubmit,
            "Submit",
            CFrame.lookAt(
                HRP.Position,
                lookAt
            )
        )

    return submitSuccess
end

--==================================================
-- PROCESS PLAYER TASK
--==================================================

local function processPlayerTask(
    taskText
)

    if not State.farming then
        return false
    end

    --==================================================
    -- FIND PLAYER
    --==================================================

    local target =
        findPlayerTarget(
            taskText
        )

    --==================================================
    -- PLAYER NOT FOUND
    -- STOP -> START -> NEW TASK
    --==================================================

    if not target then

        stopSpectate()

        restartJobPlayerNotFound()

        return false
    end

    local realPlayer =
        target.player

    State.targetUsername =
        realPlayer.Name

    --==================================================
    -- START SPECTATE
    --==================================================

    if S.SpectateEnabled then

        startSpectate(
            realPlayer
        )
    end

    --==================================================
    -- TELEPORT + PHOTO LOOP
    --==================================================

    while State.farming do

        -- REFRESH CHARACTER

        local character =
            realPlayer.Character

        if not character then

            task.wait(
                S.PlayerSearchDelay
            )

            local newTarget =
                findPlayerTarget(
                    taskText
                )

            if newTarget then

                realPlayer =
                    newTarget.player

                State.targetUsername =
                    realPlayer.Name

                -- SPECTATE CHARACTER BARU

                if S.SpectateEnabled then

                    startSpectate(
                        realPlayer
                    )
                end

            else

                stopSpectate()

                restartJobPlayerNotFound()

                return false
            end

            continue
        end

        local targetHRP =
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not targetHRP then

            task.wait(
                S.PlayerSearchDelay
            )

            continue
        end

        if not HRP
            or not HRP.Parent then

            stopSpectate()

            return false
        end

        --==================================================
        -- UPDATE SPECTATE
        --==================================================

        if S.SpectateEnabled
            and (
                not State.spectating
                or State.spectatePlayer
                    ~= realPlayer
            ) then

            startSpectate(
                realPlayer
            )
        end

        local targetPosition =
            targetHRP.Position

        local direction =
            HRP.Position
            - targetPosition

        if direction.Magnitude < 0.1 then

            direction =
                -targetHRP.CFrame.LookVector

        else

            direction =
                direction.Unit
        end

        local distance =
            math.max(
                0,
                tonumber(
                    S.PlayerDistance
                ) or 3
            )

        local teleportPosition =
            targetPosition
            + direction * distance

        --==================================================
        -- TELEPORT
        --==================================================

        setCollision(false)

        HRP.CFrame =
            CFrame.lookAt(
                teleportPosition,
                targetPosition
            )

        --==================================================
        -- VERIFY DISTANCE
        --==================================================

        local currentDistance =
            (
                HRP.Position
                - targetHRP.Position
            ).Magnitude

        if currentDistance <=
            S.PhotoRange then

            local success =
                takePhoto(
                    targetHRP.Position
                )

            if success then

                -- STOP SPECTATE
                stopSpectate()

                setCollision(true)

                State.tweening = false
                State.processing = false

                State.lastTask = ""
                State.targetPlayer = ""
                State.targetUsername = ""

                task.wait(
                    S.SuccessDelay
                )

                return true
            end
        end

        task.wait(
            S.PlayerTeleportDelay
        )
    end

    stopSpectate()

    setCollision(true)

    return false
end

--==================================================
-- PROCESS AREA
--==================================================

local function processAreaTask(
    taskText
)

    local area =
        resolveArea(
            taskText
        )

    if not area then
        return false
    end

    local position =
        findLocation(
            taskText
        )

    if not position then

        State.stopReason =
            "Location not found: "
            .. tostring(area)

        State.processing = false
        State.lastTask = ""

        return false
    end

    local moved =
        smoothTween(
            position
        )

    if not moved then

        State.processing = false

        return false
    end

    if not State.farming then

        State.processing = false

        return false
    end

    task.wait(0.05)

    takePhoto(
        position
    )

    setCollision(true)

    State.tweening = false
    State.processing = false

    task.wait(
        S.SuccessDelay
    )

    State.lastTask = ""

    return true
end

--==================================================
-- PROCESS TASK
--==================================================

local function processTask()

    if not State.farming then
        return
    end

    if State.processing
        or State.restarting then

        return
    end

    local taskText =
        getTaskText()

    if not taskText
        or taskText == "" then

        return
    end

    local lower =
        taskText:lower()

    if lower:find(
        "waiting for assignment",
        1,
        true
    ) then

        return
    end

    --==================================================
    -- MUSIC ROOM
    --==================================================

    if isRejectedTask(
        taskText
    ) then

        State.stopReason =
            "Music Room rejected"

        restartUntilValidTask()

        return
    end

    --==================================================
    -- AREA
    --==================================================

    local area =
        resolveArea(
            taskText
        )

    if area then

        if taskText ==
            State.lastTask then

            return
        end

        State.processing = true
        State.lastTask =
            taskText

        State.taskCount += 1

        processAreaTask(
            taskText
        )

        return
    end

    --==================================================
    -- PLAYER
    --==================================================

    if isPlayerPhotoTask(
        taskText
    ) then

        if taskText ==
            State.lastTask then

            return
        end

        State.processing = true
        State.lastTask =
            taskText

        State.taskCount += 1

        processPlayerTask(
            taskText
        )

        State.processing = false

        return
    end

    --==================================================
    -- INVALID
    --==================================================

    State.stopReason =
        "Invalid task: "
        .. tostring(taskText)

    restartUntilValidTask()
end

--==================================================
-- FARM LOOP
--==================================================

local function farmLoop()

    if farmLoopRunning then
        return
    end

    farmLoopRunning = true

    while State.farming do

        pcall(function()
            processTask()
        end)

        task.wait(
            S.RefreshRate
        )
    end

    stopSpectate()

    setCollision(true)

    farmLoopRunning = false
end

