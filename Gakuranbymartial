--==================================================
-- FIND PLAYER TARGET WITH LOOP
--==================================================

local function findPlayerTarget(
    taskText
)

    local requestedName =
        getTargetPlayerText(
            taskText
        )

    if not requestedName then
        return nil
    end

    State.targetPlayer =
        requestedName

    for attempt = 1,
        S.PlayerSearchAttempts do

        if not State.farming then
            return nil
        end

        local currentTask =
            getTaskText()

        if currentTask
            and currentTask ~= "" then

            if currentTask ~= taskText then
                return nil
            end
        end

        local player,
            character,
            position =
            findPlayerByInfo(
                requestedName
            )

        if player
            and character
            and position then

            State.targetUsername =
                player.Name

            return {
                player = player,
                character = character,
                position = position,
                username = player.Name,
                displayName = player.DisplayName,
            }
        end

        task.wait(
            S.PlayerSearchDelay
        )
    end

    return nil
end

--==================================================
-- PLAYER TASK CHECK
--==================================================

local function isPlayerPhotoTask(taskText)

    if not taskText then
        return false
    end

    local area =
        resolveArea(
            taskText
        )

    if area then
        return false
    end

    return isRealPlayerPhotoTask(
        taskText
    )
end

--==================================================
-- WHITELIST CHECK
--==================================================

local function isWhitelistedTask(
    taskText
)

    if not taskText then
        return false
    end

    if isPlayerPhotoTask(
        taskText
    ) then

        return true
    end

    return resolveArea(
        taskText
    ) ~= nil
end

--==================================================
-- REJECTED TASK
-- MUSIC ROOM
--==================================================

local function isRejectedTask(
    taskText
)

    if not taskText then
        return false
    end

    local area =
        resolveArea(
            taskText
        )

    if area ~= "Music Room" then
        return false
    end

    return true
end

