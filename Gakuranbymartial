--==================================================
-- PHOTO PREFIX
--==================================================

local PHOTO_PREFIXES = {

    "get a photo of ",
    "take a photo of ",
    "take photo of ",
    "a photo of ",
    "photo of ",
    "photograph of ",
    "photograph ",
    "get a picture of ",
    "take a picture of ",
    "take picture of ",
    "picture of ",
}

local function getPhotoTargetText(taskText)

    if not taskText then
        return nil
    end

    local text =
        tostring(taskText)

    local lower =
        text:lower()

    for _, prefix in ipairs(
        PHOTO_PREFIXES
    ) do

        if lower:sub(
            1,
            #prefix
        ) == prefix then

            local target =
                text:sub(
                    #prefix + 1
                )

            target =
                normalizePlayerName(
                    target
                )

            if target ~= "" then
                return target
            end
        end
    end

    return nil
end

--==================================================
-- INFO MATCH
--==================================================

local function infoMatchesTarget(
    infoText,
    targetText,
    player
)

    if not infoText
        or not targetText then

        return false
    end

    local info =
        tostring(
            infoText
        ):lower()

    local target =
        tostring(
            targetText
        ):lower()

    if info == target then
        return true
    end

    if info:find(
        target,
        1,
        true
    ) then

        return true
    end

    if player then

        local username =
            player.Name:lower()

        local displayName =
            player.DisplayName:lower()

        if info:find(
            username,
            1,
            true
        ) then

            return true
        end

        if info:find(
            displayName,
            1,
            true
        ) then

            return true
        end
    end

    return false
end

--==================================================
-- GET PLAYER BY TEXT
--==================================================

local function getPlayerByText(targetText)

    if not targetText then
        return nil
    end

    local target =
        normalizePlayerName(
            targetText
        )

    if target == "" then
        return nil
    end

    local lowerTarget =
        target:lower()

    -- EXACT USERNAME

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
            and
            player.Name:lower()
                == lowerTarget then

            return player
        end
    end

    -- EXACT DISPLAY NAME

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
            and
            player.DisplayName:lower()
                == lowerTarget then

            return player
        end
    end

    -- PARTIAL

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            if player.Name:lower():find(
                lowerTarget,
                1,
                true
            )
            or
            player.DisplayName:lower():find(
                lowerTarget,
                1,
                true
            ) then

                return player
            end
        end
    end

    return nil
end

