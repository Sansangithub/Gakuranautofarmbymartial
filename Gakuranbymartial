    local camera = getCamera()
    if camera then
        camera.CameraType = CameraState.previousCameraType or Enum.CameraType.Custom
        if CameraState.previousCameraSubject and CameraState.previousCameraSubject.Parent then
            camera.CameraSubject = CameraState.previousCameraSubject
