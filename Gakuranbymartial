local function waitForPhotoResult(
    previousTask
)

    if S.PhotoConfirmTimeout <= 0 then
        return false
    end

    local deadline =
        os.clock()
        + S.PhotoConfirmTimeout

    while State.farming
        and os.clock() < deadline do

        local current =
            getTaskText()

        if current
            and current ~= ""
            and current ~= previousTask then

            return true
        end

        RunService.Heartbeat:Wait()
    end

    return false
end

--==================================================
-- TAKE PHOTO
--==================================================

local function takePhoto(
    targetPosition,
    previousTask
)

    if not State.farming
        or not phoneScreenPush
        or not photoJobSubmit
        or not HRP
        or not HRP.Parent then

        return false
    end

    if not PhotoBuffer then

        PhotoBuffer =
            createPhotoBuffer()

        if not PhotoBuffer then
            return false
        end
    end

    for attempt = 1,
        S.PhotoRetryCount do

        if not State.farming then
            return false
        end

        -- UPDATE TARGET DISTANCE
        local distance =
            (
                HRP.Position
                - targetPosition
            ).Magnitude

        if distance >
            S.PhotoTargetMaxDistance then

            return false
        end

        -- FACE TARGET
        local photoCFrame =
            CFrame.lookAt(
                HRP.Position,
                targetPosition
            )

        pcall(
            function()

                HRP.CFrame =
                    photoCFrame

            end
        )

        State.photoAttempts += 1

        -- PUSH PHOTO
        local pushOK =
            pcall(
                phoneScreenPush.FireServer,
                phoneScreenPush,
                PhotoBuffer
            )

        if pushOK then

            local invokeOK,
                result =
                pcall(
                    photoJobSubmit.InvokeServer,
                    photoJobSubmit,
                    "Submit",
                    photoCFrame
                )

            if invokeOK then

                if result == true then
                    return true
                end

                if result ~= false then

                    if waitForPhotoResult(
                        previousTask
                    ) then

                        return true
                    end
                end

                if waitForPhotoResult(
                    previousTask
                ) then

                    return true
                end
            end
        end

        -- NO ARTIFICIAL RETRY DELAY
    end

    return false
end

--==================================================
-- PLAYER TASK
--==================================================

local function processPlayerTask(
    taskText
)

    local target =
        findPlayerTarget(
            taskText
        )

    if not target then

        stopPlayerView()

        return false
    end

    local player =
        target.player

    State.targetUsername =
        player.Name

    -- AUTO ;VIEW ONCE
    if S.AutoViewCommandEnabled then

        sendViewCommand(
            player.Name
        )
    end

    if not State.farming then
        return false
    end

    --==============================================
    -- FIRST DIRECT TELEPORT
    --==============================================

    local targetHRP =
        getTargetRoot(
            player
        )

    if not targetHRP then
        return false
    end

    local firstPosition =
        targetHRP.Position

    local photoSpot =
        getBestPhotoPosition(
            player
        )

    if not photoSpot then
        return false
    end

    local teleported =
        fastTeleportToPosition(
            photoSpot.position,
            photoSpot.target
        )

    if not teleported then
        return false
    end

    if not State.farming then
        return false
    end

    --==============================================
    -- READ MOVING PLAYER AGAIN
    --==============================================

    targetHRP =
        getTargetRoot(
            player
        )

    if not targetHRP then
        return false
    end

    local latestPosition =
        targetHRP.Position

    local moved =
        (
            latestPosition
            - firstPosition
        ).Magnitude

    --==============================================
    -- PLAYER MOVED
    --==============================================

    if moved > 0.05 then

        photoSpot =
            getBestPhotoPosition(
                player
            )

        if not photoSpot then
            return false
        end

        -- IMMEDIATE SECOND TELEPORT
        fastTeleportToPosition(
            photoSpot.position,
            photoSpot.target
        )

        targetHRP =
            getTargetRoot(
                player
            )

        if not targetHRP then
            return false
        end

        latestPosition =
            targetHRP.Position
    end

    --==============================================
    -- FINAL TARGET REFRESH
    --==============================================

    targetHRP =
        getTargetRoot(
            player
        )

    if not targetHRP then
        return false
    end

    latestPosition =
        targetHRP.Position

    --==============================================
    -- FINAL FACE
    --==============================================

    if HRP
        and HRP.Parent then

        pcall(
            function()

                HRP.CFrame =
                    CFrame.lookAt(
                        HRP.Position,
                        latestPosition
                    )

            end
        )
    end

    --==============================================
    -- PHOTO IMMEDIATELY
    --==============================================

    local success =
        takePhoto(
            latestPosition,
            taskText
        )

    setCollision(true)

    stopPlayerView()

    State.processing =
        false

    if success then

        State.lastTask =
            ""

        State.targetPlayer =
            ""

        State.targetUsername =
            ""

        return true
    end

    return false
end

--==================================================
-- AREA TASK
--==================================================

local function processAreaTask(
    taskText
)

    stopPlayerView()

    local position =
        findLocation(
            taskText
        )

    if not position then
        return false
    end

    if not smoothTween(
        position
    ) then

        return false
    end

    if not State.farming then
        return false
    end

    local success =
        takePhoto(
            position,
            taskText
        )

    setCollision(true)

    State.processing =
        false

    if success then

        State.lastTask =
            ""

        return true
    end

    return false
end

