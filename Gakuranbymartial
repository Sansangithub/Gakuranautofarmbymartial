--==================================================
-- WAIT NEW ASSIGNMENT
--==================================================

local function waitForNewAssignment()

    local deadline =
        os.clock() + 5

    while State.farming
        and os.clock() < deadline do

        local taskText =
            getTaskText()

        if taskText
            and taskText ~= "" then

            local lower =
                taskText:lower()

            if not lower:find(
                "waiting for assignment",
                1,
                true
            ) then

                return taskText
            end
        end

        task.wait(
            S.AssignmentWait
        )
    end

    return nil
end

--==================================================
-- RESTART PLAYER NOT FOUND
--==================================================

local function restartJobPlayerNotFound()

    if not State.farming then
        return false
    end

    if State.restarting then
        return false
    end

    State.restarting = true
    State.processing = false
    State.tweening = false

    State.stopReason =
        "Player not found -> reroll"

    State.targetPlayer = ""
    State.targetUsername = ""
    State.lastViewCommand = ""

    stopPlayerView()
    cancelTween()
    setCollision(true)

    stopCurrentJob()

    State.restartCount += 1

    task.wait(
        S.RestartDelay
    )

    if not State.farming then

        State.restarting = false

        return false
    end

    startNewJob()

    task.wait(
        S.StartDelay
    )

    if not State.farming then

        State.restarting = false

        return false
    end

    local newTask =
        waitForNewAssignment()

    if not State.farming then

        State.restarting = false

        return false
    end

    State.lastTask = ""
    State.restarting = false

    return newTask ~= nil
end

--==================================================
-- RESTART UNTIL VALID
--==================================================

local function restartUntilValidTask()

    if not State.farming then
        return false
    end

    if State.restarting then
        return false
    end

    State.restarting = true
    State.processing = false
    State.tweening = false

    State.targetPlayer = ""
    State.targetUsername = ""
    State.lastViewCommand = ""

    stopPlayerView()
    cancelTween()
    setCollision(true)

    while State.farming do

        local taskText =
            getTaskText()

        if taskText
            and taskText ~= "" then

            local lower =
                taskText:lower()

            if not lower:find(
                "waiting for assignment",
                1,
                true
            ) then

                if isPlayerPhotoTask(
                    taskText
                ) then

                    local target =
                        findPlayerTarget(
                            taskText
                        )

                    if target then

                        State.lastTask = ""
                        State.restarting = false

                        return true
                    end

                elseif isWhitelistedTask(
                    taskText
                )
                and not isRejectedTask(
                    taskText
                ) then

                    State.lastTask = ""
                    State.restarting = false

                    return true
                end
            end
        end

        stopCurrentJob()

        State.restartCount += 1

        task.wait(
            S.RestartDelay
        )

        if not State.farming then
            break
        end

        startNewJob()

        task.wait(
            S.StartDelay
        )

        local newTask =
            waitForNewAssignment()

        if not newTask then
            continue
        end

        if isRejectedTask(
            newTask
        ) then

            continue
        end

        if isPlayerPhotoTask(
            newTask
        ) then

            local target =
                findPlayerTarget(
                    newTask
                )

            if target then

                State.lastTask = ""
                State.restarting = false

                return true
            end

            continue

        elseif isWhitelistedTask(
            newTask
        ) then

            State.lastTask = ""
            State.restarting = false

            return true
        end
    end

    State.restarting = false

    return false
end

--==================================================
-- FIND AREA LOCATION
--==================================================

local function findLocation(taskText)

    local area =
        resolveArea(
            taskText
        )

    if not area then
        return nil
    end

    local searchTerms = {}

    table.insert(
        searchTerms,
        area:lower()
    )

    table.insert(
        searchTerms,
        normalizeText(
            taskText
        )
    )

    if area == "GAKUMART" then

        table.insert(
            searchTerms,
            "gakumart"
        )

        table.insert(
            searchTerms,
            "gaku mart"
        )
    end

    if area == "Rooftop" then

        table.insert(
            searchTerms,
            "rooftop"
        )

        table.insert(
            searchTerms,
            "roof"
        )
    end

    local bestPart
    local bestScore = 0

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            local objectName =
                object.Name:lower()

            for _, term in ipairs(
                searchTerms
            ) do

                if term ~= ""
                    and objectName:find(
                        term,
                        1,
                        true
                    ) then

                    local score =
                        #term

                    if score > bestScore then

                        bestScore = score
                        bestPart = object
                    end
                end
            end

            local landmark =
                object:FindFirstChild(
                    "PhotoJobLandmark"
                )

            if landmark
                and landmark:IsA(
                    "StringValue"
                ) then

                local value =
                    landmark.Value:lower()

                for _, term in ipairs(
                    searchTerms
                ) do

                    if term ~= ""
                        and value:find(
                            term,
                            1,
                            true
                        ) then

                        local score =
                            #term + 100

                        if score > bestScore then

                            bestScore = score
                            bestPart = object
                        end
                    end
                end
            end
        end
    end

    if bestPart then
        return bestPart.Position
    end

    return nil
end

--==================================================
-- AREA TWEEN
--==================================================

local function smoothTween(
    targetPosition
)

    if not HRP then
        return false
    end

    if not State.farming then
        return false
    end

    cancelTween()

    local startPosition =
        HRP.Position

    local distance =
        (
            targetPosition
            - startPosition
        ).Magnitude

    if distance <= S.MaxDistance then

        HRP.CFrame =
            CFrame.new(
                targetPosition
            )

        setCollision(true)

        return true
    end

    setCollision(false)

    State.tweening = true

    local duration =
        math.clamp(
            distance / S.TweenSpeed,
            S.MinDuration,
            S.MaxDuration
        )

    currentTween =
        TweenService:Create(

            HRP,

            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),

            {
                CFrame =
                    CFrame.new(
                        targetPosition
                    )
            }
        )

    currentTween:Play()

    local completed = false

    local connection =
        currentTween.Completed:Connect(
            function()

                completed = true
            end
        )

    while not completed do

        if not State.farming then

            connection:Disconnect()

            cancelTween()
            setCollision(true)

            return false
        end

        task.wait()
    end

    connection:Disconnect()

    currentTween = nil
    State.tweening = false

    setCollision(true)

    return true
end

--==================================================
-- FAST PHOTO
--==================================================

local function takePhoto(
    targetPosition
)

    if not State.farming then
        return false
    end

    if not phoneScreenPush
        or not photoJobSubmit
        or not HRP then

        return false
    end

    local bufferData =
        buffer.create(7)

    buffer.writeu8(
        bufferData,
        0,
        1
    )

    buffer.writeu8(
        bufferData,
        1,
        4
    )

    buffer.writeu8(
        bufferData,
        2,
        0
    )

    buffer.writeu8(
        bufferData,
        3,
        1
    )

    buffer.writeu8(
        bufferData,
        4,
        1
    )

    buffer.writeu8(
        bufferData,
        5,
        42
    )

    buffer.writeu8(
        bufferData,
        6,
        24
    )

    local pushSuccess =
        pcall(
            phoneScreenPush.FireServer,
            phoneScreenPush,
            bufferData
        )

    if not pushSuccess then
        return false
    end

    if not State.farming then
        return false
    end

    local lookAt =
        targetPosition
        or (
            HRP.Position
            + HRP.CFrame.LookVector * 10
        )

    local submitSuccess =
        pcall(
            photoJobSubmit.InvokeServer,
            photoJobSubmit,
            "Submit",
            CFrame.lookAt(
                HRP.Position,
                lookAt
            )
        )

    return submitSuccess
end

--==================================================
-- PLAYER TELEPORT POSITION
--==================================================

local function getPlayerTeleportCFrame(
    targetHRP
)

    if not targetHRP then
        return nil
    end

    local targetPosition =
        targetHRP.Position

    local targetLook =
        targetHRP.CFrame.LookVector

    local teleportPosition =
        targetPosition
        - targetLook * 2
        + Vector3.new(
            0,
            0.2,
            0
        )

    return CFrame.lookAt(
        teleportPosition,
        targetPosition
    )
end

--==================================================
-- PROCESS PLAYER TASK
--==================================================

local function processPlayerTask(
    taskText
)

    if not State.farming then
        return false
    end

    local target =
        findPlayerTarget(
            taskText
        )

    if not target then

        stopPlayerView()

        restartJobPlayerNotFound()

        return false
    end

    local realPlayer =
        target.player

    State.targetUsername =
        realPlayer.Name

    --==================================================
    -- AUTO ;VIEW
    --==================================================

    if S.AutoViewCommandEnabled then

        local viewName =
            target.username
            or target.displayName
            or realPlayer.Name

        sendViewCommand(
            viewName
        )

        task.wait(
            S.AutoViewCommandDelay
        )
    end

    --==================================================
    -- PLAYER VIEW / PHOTO LOOP
    --==================================================

    while State.farming do

        --==================================================
        -- REFRESH TARGET
        --==================================================

        local character =
            realPlayer.Character

        if not character then

            stopPlayerView()

            task.wait(
                S.PlayerSearchDelay
            )

            local newTarget =
                findPlayerTarget(
                    taskText
                )

            if newTarget then

                realPlayer =
                    newTarget.player

                State.targetUsername =
                    realPlayer.Name

                -- Re-send view command
                -- apabila target berubah.

                if S.AutoViewCommandEnabled then

                    State.lastViewCommand = ""

                    sendViewCommand(
                        newTarget.username
                        or newTarget.displayName
                        or realPlayer.Name
                    )

                    task.wait(
                        S.AutoViewCommandDelay
                    )
                end

                continue

            else

                restartJobPlayerNotFound()

                return false
            end
        end

        local targetHRP =
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        local targetHumanoid =
            character:FindFirstChildOfClass(
                "Humanoid"
            )

        if not targetHRP
            or not targetHumanoid then

            task.wait(
                S.PlayerSearchDelay
            )

            continue
        end

        if not HRP
            or not HRP.Parent then

            stopPlayerView()

            return false
        end

        --==================================================
        -- AUTO VIEW COMMAND
        --==================================================

        if S.AutoViewCommandEnabled then

            local viewName =
                realPlayer.Name

            local command =
                ";view " .. viewName

            if State.lastViewCommand
                ~= command then

                sendViewCommand(
                    viewName
                )

                task.wait(
                    S.AutoViewCommandDelay
                )
            end
        end

        --==================================================
        -- VIEW LIKE INFINITE YIELD
        --==================================================

        if S.PlayerViewEnabled then

            local viewStarted =
                startPlayerView(
                    realPlayer
                )

            if viewStarted then

                waitPlayerView()
            end
        end

        if not State.farming then
            break
        end

        --==================================================
        -- REFRESH TARGET AFTER VIEW
        --==================================================

        character =
            realPlayer.Character

        if not character then
            continue
        end

        targetHRP =
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not targetHRP then
            continue
        end

        --==================================================
        -- TELEPORT
        --==================================================

        local teleportCFrame =
            getPlayerTeleportCFrame(
                targetHRP
            )

        if teleportCFrame then

            setCollision(false)

            HRP.CFrame =
                teleportCFrame
        end

        --==================================================
        -- RE-ACTIVATE VIEW
        --==================================================

        if S.PlayerViewEnabled then

            startPlayerView(
                realPlayer
            )
        end

        --==================================================
        -- PHOTO
        --==================================================

        local success =
            takePhoto(
                targetHRP.Position
            )

        if success then

            --==================================================
            -- SUCCESS
            --==================================================

            setCollision(true)

            State.tweening = false
            State.processing = false

            State.lastTask = ""

            State.targetPlayer = ""
            State.targetUsername = ""

            -- Unview setelah foto berhasil.

            stopPlayerView()

            -- Allow command baru pada task berikutnya.

            State.lastViewCommand = ""

            task.wait(
                S.SuccessDelay
            )

            return true
        end

        --==================================================
        -- PHOTO FAILED
        --==================================================

        stopPlayerView()

        task.wait(
            S.PlayerTeleportDelay
        )
    end

    setCollision(true)

    stopPlayerView()

    return false
end

--==================================================
-- PROCESS AREA TASK
--==================================================

local function processAreaTask(
    taskText
)

    stopPlayerView()

    local area =
        resolveArea(
            taskText
        )

    if not area then
        return false
    end

    local position =
        findLocation(
            taskText
        )

    if not position then

        State.stopReason =
            "Location not found: "
            .. tostring(area)

        State.processing = false
        State.lastTask = ""

        return false
    end

    local moved =
        smoothTween(
            position
        )

    if not moved then

        State.processing = false

        return false
    end

    if not State.farming then

        State.processing = false

        return false
    end

    task.wait(0.05)

    takePhoto(
        position
    )

    setCollision(true)

    State.tweening = false
    State.processing = false

    task.wait(
        S.SuccessDelay
    )

    State.lastTask = ""

    State.lastViewCommand = ""

    return true
end

--==================================================
-- PROCESS TASK
--==================================================

local function processTask()

    if not State.farming then
        return
    end

    if State.processing
        or State.restarting then

        return
    end

    local taskText =
        getTaskText()

    if not taskText
        or taskText == "" then

        return
    end

    local lower =
        taskText:lower()

    if lower:find(
        "waiting for assignment",
        1,
        true
    ) then

        return
    end

    --==================================================
    -- MUSIC ROOM
    --==================================================

    if isRejectedTask(
        taskText
    ) then

        State.stopReason =
            "Music Room rejected"

        restartUntilValidTask()

        return
    end

    --==================================================
    -- AREA
    --==================================================

    local area =
        resolveArea(
            taskText
        )

    if area then

        if taskText ==
            State.lastTask then

            return
        end

        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        processAreaTask(
            taskText
        )

        return
    end

    --==================================================
    -- PLAYER
    --==================================================

    if isPlayerPhotoTask(
        taskText
    ) then

        if taskText ==
            State.lastTask then

            return
        end

        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        processPlayerTask(
            taskText
        )

        State.processing = false

        return
    end

    --==================================================
    -- INVALID
    --==================================================

    State.stopReason =
        "Invalid task: "
        .. tostring(taskText)

    restartUntilValidTask()
end

--==================================================
-- FARM LOOP
--==================================================

local function farmLoop()

    if farmLoopRunning then
        return
    end

    farmLoopRunning = true

    while State.farming do

        pcall(
            function()

                processTask()
            end
        )

        task.wait(
            S.RefreshRate
        )
    end

    setCollision(true)

    stopPlayerView()

    farmLoopRunning = false
end

--==================================================
-- START FARMING
--==================================================

startFarming = function()

    if State.farming then
        return
    end

    if not findRemotes() then

        State.stopReason =
            "PhotoJob remotes not found"

        updateGUI()

        return
    end

    State.farming = true
    State.processing = false
    State.tweening = false
    State.restarting = false

    State.lastTask = ""

    State.taskCount = 0
    State.restartCount = 0

    State.stopReason = ""

    State.targetPlayer = ""
    State.targetUsername = ""
    State.lastViewCommand = ""

    setCollision(true)

    --==================================================
    -- FLY
    --==================================================

    if S.FlyEnabled then
        startFly()
    end

    updateGUI()

    --==================================================
    -- START JOB
    --==================================================

    startNewJob()

    task.wait(
        S.StartDelay
    )

    if not State.farming then
        return
    end

    task.spawn(
        farmLoop
    )
end

--==================================================
-- STOP FARMING
--==================================================

stopFarmingFromGUI = function()

    if not State.farming then

        stopPlayerView()
        stopFly()

        updateGUI()

        return
    end

    cancelTween()

    --==================================================
    -- UNVIEW
    --==================================================

    stopPlayerView()

    --==================================================
    -- STOP FLY
    --==================================================

    stopFly()

    --==================================================
    -- STOP JOB
    --==================================================

    stopCurrentJob()

    State.farming = false
    State.processing = false
    State.tweening = false
    State.restarting = false

    State.targetPlayer = ""
    State.targetUsername = ""
    State.lastViewCommand = ""

    State.stopReason =
        "Disabled from GUI"

    setCollision(true)

    updateGUI()
end

