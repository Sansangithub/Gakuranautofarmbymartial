local function getPlayerByText(targetText)
    if not targetText then
        return nil
    end

    local target =
        normalizePlayerName(targetText):lower()

    if target == "" then
        return nil
    end

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
            and player.Name:lower() == target then

            return player
        end
    end

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer
            and player.DisplayName:lower() == target then

            return player
        end
    end

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            if player.Name:lower():find(
                target,
                1,
                true
            )
            or player.DisplayName:lower():find(
                target,
                1,
                true
            ) then

                return player
            end
        end
    end

    return nil
end

local function findPlayerByInfo(targetText)
    if not targetText then
        return nil
    end

    local target =
        normalizePlayerName(targetText):lower()

    if target == "" then
        return nil
    end

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            local character = player.Character

            if character then

                local info =
                    character:FindFirstChild(
                        "Info",
                        true
                    )

                if info and info:IsA("TextLabel") then

                    local infoText =
                        tostring(info.Text or ""):lower()

                    if infoText:find(
                        target,
                        1,
                        true
                    )
                    or infoText ==
                        player.Name:lower()
                    or infoText ==
                        player.DisplayName:lower() then

                        local root =
                            character:FindFirstChild(
                                "HumanoidRootPart"
                            )

                        if root then
                            return player
                        end
                    end
                end
            end
        end
    end

    return getPlayerByText(target)
end

local function findPlayerTarget(taskText)
    local requested =
        getPhotoTargetText(taskText)

    if not requested then
        return nil
    end

    State.targetPlayer = requested

    for _ = 1, S.PlayerSearchAttempts do

        if not State.farming then
            return nil
        end

        local player =
            findPlayerByInfo(requested)

        if player then

            local root =
                player.Character
                and player.Character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if root then

                State.targetUsername =
                    player.Name

                return {
                    player = player,
                    character = player.Character,
                    hrp = root
                }
            end
        end

        if S.PlayerSearchDelay > 0 then
            task.wait(S.PlayerSearchDelay)
        end
    end

    return nil
end

--==================================================
-- AREA
--==================================================

local function resolveArea(taskText)
    local normalized =
        normalizeText(taskText)

    if normalized == "" then
        return nil
    end

    for _, entry in ipairs(AREA_TASKS) do

        local canonical =
            entry.canonical:lower()

        if normalized == canonical
            or normalized:find(
                canonical,
                1,
                true
            ) then

            return entry.canonical
        end

        for _, alias in ipairs(entry.aliases) do

            alias = alias:lower()

            if normalized == alias
                or normalized:find(
                    alias,
                    1,
                    true
                ) then

                return entry.canonical
            end
        end
    end

    return nil
end

local function isRejectedTask(taskText)
    return resolveArea(taskText) == "Music Room"
end

local function findLocation(taskText)
    local area = resolveArea(taskText)

    if not area then
        return nil
    end

    local terms = {
        area:lower(),
        normalizeText(taskText)
    }

    for _, entry in ipairs(AREA_TASKS) do
        if entry.canonical == area then
            for _, alias in ipairs(entry.aliases) do
                table.insert(
                    terms,
                    alias:lower()
                )
            end
        end
    end

    local best
    local scoreBest = 0

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            local name =
                object.Name:lower()

            for _, term in ipairs(terms) do

                if term ~= ""
                    and name:find(
                        term,
                        1,
                        true
                    ) then

                    local score = #term

                    if score > scoreBest then
                        scoreBest = score
                        best = object
                    end
                end
            end

            local landmark =
                object:FindFirstChild(
                    "PhotoJobLandmark"
                )

            if landmark
                and landmark:IsA("StringValue") then

                local value =
                    landmark.Value:lower()

                for _, term in ipairs(terms) do

                    if term ~= ""
                        and value:find(
                            term,
                            1,
                            true
                        ) then

                        local score =
                            #term + 100

                        if score > scoreBest then
                            scoreBest = score
                            best = object
                        end
                    end
                end
            end
        end
    end

    return best and best.Position
end

