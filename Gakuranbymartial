--==================================================
-- RESTART AFTER TIMEOUT
--==================================================

local function restartJobAfterPhotoTimeout()

    if not State.farming then
        return false
    end

    State.stopReason =
        "Photo timeout: "
        .. tostring(
            S.PhotoTimeout
        )
        .. "s"

    State.processing = false
    State.tweening = false
    State.restarting = true

    State.targetPlayer = ""
    State.targetUsername = ""

    cancelTween()

    stopCurrentJob()

    State.restartCount += 1

    task.wait(
        S.RestartDelay
    )

    if not State.farming then

        State.restarting = false

        return false
    end

    startNewJob()

    task.wait(
        S.StartDelay
    )

    State.lastTask = ""

    State.restarting = false

    return true
end

--==================================================
-- RESTART UNTIL VALID
--==================================================

local function restartUntilValidTask()

    if not State.farming then
        return false
    end

    if State.restarting then
        return false
    end

    State.restarting = true
    State.processing = false
    State.tweening = false

    State.targetPlayer = ""
    State.targetUsername = ""

    cancelTween()
    setCollision(true)

    while State.farming do

        local taskText =
            getTaskText()

        if taskText
            and taskText ~= "" then

            local lower =
                taskText:lower()

            if not lower:find(
                "waiting for assignment",
                1,
                true
            ) then

                if isPlayerPhotoTask(
                    taskText
                ) then

                    local target =
                        findPlayerTarget(
                            taskText
                        )

                    if target then

                        State.lastTask = ""
                        State.restarting = false

                        return true
                    end

                elseif isWhitelistedTask(
                    taskText
                )
                and not isRejectedTask(
                    taskText
                ) then

                    State.lastTask = ""
                    State.restarting = false

                    return true
                end
            end
        end

        if not State.farming then
            break
        end

        stopCurrentJob()

        State.restartCount += 1

        task.wait(
            S.RestartDelay
        )

        if not State.farming then
            break
        end

        startNewJob()

        task.wait(
            S.StartDelay
        )

        for i = 1,
            S.MaxAttempts do

            if not State.farming then
                break
            end

            local newTask =
                getTaskText()

            if newTask
                and newTask ~= "" then

                local newLower =
                    newTask:lower()

                if not newLower:find(
                    "waiting for assignment",
                    1,
                    true
                ) then

                    if isPlayerPhotoTask(
                        newTask
                    ) then

                        local target =
                            findPlayerTarget(
                                newTask
                            )

                        if target then

                            State.lastTask = ""
                            State.restarting = false

                            return true
                        end

                        break
                    end

                    if isWhitelistedTask(
                        newTask
                    )
                    and not isRejectedTask(
                        newTask
                    ) then

                        State.lastTask = ""
                        State.restarting = false

                        return true
                    end

                    break
                end
            end

            task.wait(
                S.AssignmentWait
            )
        end
    end

    State.restarting = false

    return false
end

--==================================================
-- FIND AREA LOCATION
--==================================================

local function findLocation(taskText)

    local area =
        resolveArea(
            taskText
        )

    if not area then
        return nil
    end

    local searchTerms = {}

    table.insert(
        searchTerms,
        area:lower()
    )

    local normalized =
        normalizeText(
            taskText
        )

    table.insert(
        searchTerms,
        normalized
    )

    if area == "GAKUMART" then

        table.insert(
            searchTerms,
            "gakumart"
        )

        table.insert(
            searchTerms,
            "gaku mart"
        )
    end

    if area == "Rooftop" then

        table.insert(
            searchTerms,
            "rooftop"
        )

        table.insert(
            searchTerms,
            "roof"
        )
    end

    local bestPart = nil
    local bestScore = 0

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            local objectName =
                object.Name:lower()

            for _, term in ipairs(
                searchTerms
            ) do

                if term ~= ""
                    and objectName:find(
                        term,
                        1,
                        true
                    ) then

                    local score =
                        #term

                    if score > bestScore then

                        bestScore =
                            score

                        bestPart =
                            object

                    end
                end
            end

            local landmark =
                object:FindFirstChild(
                    "PhotoJobLandmark"
                )

            if landmark
                and landmark:IsA(
                    "StringValue"
                ) then

                local value =
                    landmark.Value:lower()

                for _, term in ipairs(
                    searchTerms
                ) do

                    if term ~= ""
                        and value:find(
                            term,
                            1,
                            true
                        ) then

                        local score =
                            #term + 100

                        if score > bestScore then

                            bestScore =
                                score

                            bestPart =
                                object

                        end
                    end
                end
            end
        end
    end

    if bestPart then
        return bestPart.Position
    end

    return nil
end

--==================================================
-- AREA TWEEN
--==================================================

local function smoothTween(targetPosition)

    if not HRP then
        return false
    end

    if not State.farming then
        return false
    end

    cancelTween()

    local startPosition =
        HRP.Position

    local distance =
        (
            targetPosition
            - startPosition
        ).Magnitude

    if distance <= S.MaxDistance then

        HRP.CFrame =
            CFrame.new(
                targetPosition
            )

        setCollision(true)

        return true
    end

    setCollision(false)

    State.tweening = true

    local duration =
        math.clamp(
            distance / S.TweenSpeed,
            S.MinDuration,
            S.MaxDuration
        )

    currentTween =
        TweenService:Create(
            HRP,

            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),

            {
                CFrame =
                    CFrame.new(
                        targetPosition
                    )
            }
        )

    currentTween:Play()

    local completed = false

    local connection =
        currentTween.Completed:Connect(
            function()
                completed = true
            end
        )

    while not completed do

        if not State.farming then

            connection:Disconnect()

            cancelTween()
            setCollision(true)

            return false
        end

        task.wait()
    end

    connection:Disconnect()

    currentTween = nil
    State.tweening = false

    setCollision(true)

    return true
end

--==================================================
-- TELEPORT PLAYER
--==================================================

local function teleportToPlayerOnce(target)

    if not State.farming then
        return false
    end

    if not target then
        return false
    end

    local player =
        target.player

    if not player then
        return false
    end

    local character =
        player.Character

    if not character then
        return false
    end

    local targetHRP =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not targetHRP then
        return false
    end

    if not HRP then
        return false
    end

    State.targetUsername =
        player.Name

    local targetPosition =
        targetHRP.Position

    local direction =
        HRP.Position
        - targetPosition

    if direction.Magnitude < 0.1 then

        direction =
            -targetHRP.CFrame.LookVector

    else

        direction =
            direction.Unit
    end

    local distance =
        math.max(
            0,
            tonumber(
                S.PlayerDistance
            ) or 3
        )

    local teleportPosition =
        targetPosition
        + direction * distance

    local newCFrame =
        CFrame.lookAt(
            teleportPosition,
            targetPosition
        )

    cancelTween()

    setCollision(false)

    HRP.CFrame =
        newCFrame

    setCollision(true)

    State.tweening = false

    return true
end

--==================================================
-- FAST PHOTO
--==================================================

local function takePhoto(targetPosition)

    if not State.farming then
        return false
    end

    if not phoneScreenPush
        or not photoJobSubmit
        or not HRP then

        return false
    end

    local bufferData =
        buffer.create(7)

    buffer.writeu8(
        bufferData,
        0,
        1
    )

    buffer.writeu8(
        bufferData,
        1,
        4
    )

    buffer.writeu8(
        bufferData,
        2,
        0
    )

    buffer.writeu8(
        bufferData,
        3,
        1
    )

    buffer.writeu8(
        bufferData,
        4,
        1
    )

    buffer.writeu8(
        bufferData,
        5,
        42
    )

    buffer.writeu8(
        bufferData,
        6,
        24
    )

    --==================================================
    -- PHONE PUSH
    --==================================================

    local pushSuccess =
        pcall(
            phoneScreenPush.FireServer,
            phoneScreenPush,
            bufferData
        )

    if not pushSuccess then
        return false
    end

    if not State.farming then
        return false
    end

    --==================================================
    -- SUBMIT IMMEDIATELY
    --==================================================

    local lookAt =
        targetPosition
        or (
            HRP.Position
            + HRP.CFrame.LookVector * 10
        )

    local submitSuccess =
        pcall(
            photoJobSubmit.InvokeServer,
            photoJobSubmit,
            "Submit",
            CFrame.lookAt(
                HRP.Position,
                lookAt
            )
        )

    return submitSuccess
end

--==================================================
-- PROCESS PLAYER TASK
-- TELEPORT REPEATEDLY UNTIL PHOTO
--==================================================

local function processPlayerTask(taskText)

    if not State.farming then
        return false
    end

    --==================================================
    -- FIND TARGET
    --==================================================

    local target =
        findPlayerTarget(
            taskText
        )

    if not target then

        restartJobAfterPhotoTimeout()

        return false
    end

    local realPlayer =
        target.player

    State.targetUsername =
        realPlayer.Name

    --==================================================
    -- START PHOTO TIMER
    --==================================================

    local photoStart =
        os.clock()

    --==================================================
    -- KEEP TELEPORTING + PHOTO
    --==================================================

    while State.farming do

        --==================================================
        -- TIMEOUT
        --==================================================

        if os.clock() - photoStart
            >= S.PhotoTimeout then

            restartJobAfterPhotoTimeout()

            return false
        end

        --==================================================
        -- GET CURRENT CHARACTER
        --==================================================

        local character =
            realPlayer.Character

        if not character then

            task.wait(
                S.PlayerSearchDelay
            )

            continue
        end

        local targetHRP =
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not targetHRP then

            task.wait(
                S.PlayerSearchDelay
            )

            continue
        end

        if not HRP
            or not HRP.Parent then

            return false
        end

        --==================================================
        -- GET CURRENT TARGET POSITION
        --==================================================

        local targetPosition =
            targetHRP.Position

        local direction =
            HRP.Position
            - targetPosition

        if direction.Magnitude < 0.1 then

            direction =
                -targetHRP.CFrame.LookVector

        else

            direction =
                direction.Unit
        end

        local distance =
            math.max(
                0,
                tonumber(
                    S.PlayerDistance
                ) or 3
            )

        local teleportPosition =
            targetPosition
            + direction * distance

        --==================================================
        -- TELEPORT
        --==================================================

        setCollision(false)

        HRP.CFrame =
            CFrame.lookAt(
                teleportPosition,
                targetPosition
            )

        --==================================================
        -- PHOTO RANGE
        --==================================================

        local currentDistance =
            (
                HRP.Position
                - targetHRP.Position
            ).Magnitude

        if currentDistance <=
            S.PhotoRange then

            --==================================================
            -- TAKE PHOTO
            --==================================================

            local success =
                takePhoto(
                    targetHRP.Position
                )

            if success then

                setCollision(true)

                State.tweening = false
                State.processing = false

                State.lastTask = ""
                State.targetPlayer = ""
                State.targetUsername = ""

                return true
            end
        end

        --==================================================
        -- PLAYER MAY HAVE MOVED
        -- LOOP AGAIN
        --==================================================

        task.wait(
            S.PlayerTeleportDelay
        )
    end

    setCollision(true)

    return false
end

--==================================================
-- PROCESS AREA
--==================================================

local function processAreaTask(taskText)

    local area =
        resolveArea(
            taskText
        )

    if not area then
        return false
    end

    local position =
        findLocation(
            taskText
        )

    if not position then

        State.stopReason =
            "Location not found: "
            .. tostring(area)

        State.processing = false
        State.lastTask = ""

        return false
    end

    local moved =
        smoothTween(
            position
        )

    if not moved then

        State.processing = false

        return false
    end

    if not State.farming then

        State.processing = false

        return false
    end

    task.wait(0.05)

    takePhoto(
        position
    )

    setCollision(true)

    State.tweening = false
    State.processing = false

    task.wait(0.3)

    State.lastTask = ""

    return true
end

--==================================================
-- PROCESS ONE TASK
--==================================================

local function processTask()

    if not State.farming then
        return
    end

    if State.processing
        or State.restarting then

        return
    end

    local taskText =
        getTaskText()

    if not taskText
        or taskText == "" then

        return
    end

    local lower =
        taskText:lower()

    if lower:find(
        "waiting for assignment",
        1,
        true
    ) then

        return
    end

    --==================================================
    -- MUSIC ROOM
    --==================================================

    if isRejectedTask(
        taskText
    ) then

        State.stopReason =
            "Music Room rejected"

        restartUntilValidTask()

        return
    end

    --==================================================
    -- AREA
    --==================================================

    local area =
        resolveArea(
            taskText
        )

    if area then

        if taskText ==
            State.lastTask then

            return
        end

        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        processAreaTask(
            taskText
        )

        return
    end

    --==================================================
    -- PLAYER
    --==================================================

    if isPlayerPhotoTask(
        taskText
    ) then

        if taskText ==
            State.lastTask then

            return
        end

        State.processing = true
        State.lastTask = taskText
        State.taskCount += 1

        processPlayerTask(
            taskText
        )

        State.processing = false

        return
    end

    --==================================================
    -- INVALID
    --==================================================

    State.stopReason =
        "Invalid task: "
        .. tostring(taskText)

    restartUntilValidTask()
end

--==================================================
-- FARM LOOP
--==================================================

local function farmLoop()

    if farmLoopRunning then
        return
    end

    farmLoopRunning = true

    while State.farming do

        pcall(function()
            processTask()
        end)

        task.wait(
            S.RefreshRate
        )
    end

    setCollision(true)

    farmLoopRunning = false
end

--==================================================
-- START FARMING
--==================================================

startFarming = function()

    if State.farming then
        return
    end

    if not findRemotes() then

        State.stopReason =
            "PhotoJob remotes not found"

        updateGUI()

        return
    end

    State.farming = true
    State.processing = false
    State.tweening = false
    State.restarting = false

    State.lastTask = ""
    State.taskCount = 0
    State.restartCount = 0
    State.stopReason = ""

    State.targetPlayer = ""
    State.targetUsername = ""

    setCollision(true)

    --==================================================
    -- FLY
    --==================================================

    if S.FlyEnabled then
        startFly()
    end

    updateGUI()

    --==================================================
    -- START JOB
    --==================================================

    startNewJob()

    task.wait(
        S.StartDelay
    )

    if not State.farming then
        return
    end

    task.spawn(
        farmLoop
    )
end

--==================================================
-- STOP FARMING
--==================================================

stopFarmingFromGUI = function()

    if not State.farming then

        stopFly()

        updateGUI()

        return
    end

    cancelTween()

    --==================================================
    -- STOP FLY
    --==================================================

    stopFly()

    --==================================================
    -- STOP JOB
    --==================================================

    stopCurrentJob()

    State.farming = false
    State.processing = false
    State.tweening = false
    State.restarting = false

    State.targetPlayer = ""
    State.targetUsername = ""

    State.stopReason =
        "Disabled from GUI"

    setCollision(true)

    updateGUI()
end

