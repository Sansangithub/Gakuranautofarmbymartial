--==================================================
-- RESTART UNTIL VALID
--==================================================

local function restartUntilValidTask()

    if not State.farming then
        return false
    end

    if State.restarting then
        return false
    end

    State.restarting = true
    State.processing = false
    State.tweening = false

    cancelTween()
    setCollision(true)

    while State.farming do

        --==========================================
        -- CHECK CURRENT TASK
        --==========================================

        local taskText =
            getTaskText()

        if taskText
            and taskText ~= "" then

            local lower =
                taskText:lower()

            if not lower:find(
                "waiting for assignment",
                1,
                true
            ) then

                if isWhitelistedTask(
                    taskText
                )
                and not isRejectedTask(
                    taskText
                ) then

                    State.lastTask = ""
                    State.restarting = false

                    return true
                end
            end
        end

        --==========================================
        -- STOP
        --==========================================

        stopCurrentJob()

        State.restartCount += 1

        task.wait(
            S.RestartDelay
        )

        if not State.farming then
            break
        end

        --==========================================
        -- START
        --==========================================

        startNewJob()

        task.wait(
            S.StartDelay
        )

        --==========================================
        -- CHECK ASSIGNMENT
        --==========================================

        for i = 1, S.MaxAttempts do

            if not State.farming then
                break
            end

            local newTask =
                getTaskText()

            if newTask
                and newTask ~= "" then

                local lower =
                    newTask:lower()

                if not lower:find(
                    "waiting for assignment",
                    1,
                    true
                ) then

                    --==================================
                    -- VALID + NOT MUSIC
                    --==================================

                    if isWhitelistedTask(
                        newTask
                    )
                    and not isRejectedTask(
                        newTask
                    ) then

                        State.lastTask = ""
                        State.restarting = false

                        return true
                    end

                    --==================================
                    -- INVALID / MUSIC
                    -- LOOP AGAIN
                    --==================================

                    break
                end
            end

            task.wait(
                S.AssignmentWait
            )
        end
    end

    State.restarting = false

    return false
end

--==================================================
-- FIND LOCATION
--==================================================

local function findLocation(taskText)

    local area =
        resolveArea(taskText)

    if not area then
        return nil
    end

    local searchTerms = {}

    table.insert(
        searchTerms,
        area:lower()
    )

    local normalized =
        normalizeText(taskText)

    table.insert(
        searchTerms,
        normalized
    )

    local bestPart = nil
    local bestScore = 0

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do

        if object:IsA("BasePart") then

            local objectName =
                object.Name:lower()

            for _, term in ipairs(
                searchTerms
            ) do

                if term ~= ""
                    and objectName:find(
                        term,
                        1,
                        true
                    ) then

                    local score =
                        #term

                    if score > bestScore then

                        bestScore = score
                        bestPart = object
                    end
                end
            end

            -- PhotoJobLandmark
            local landmark =
                object:FindFirstChild(
                    "PhotoJobLandmark"
                )

            if landmark
                and landmark:IsA(
                    "StringValue"
                ) then

                local value =
                    landmark.Value:lower()

                for _, term in ipairs(
                    searchTerms
                ) do

                    if term ~= ""
                        and value:find(
                            term,
                            1,
                            true
                        ) then

                        local score =
                            #term + 100

                        if score > bestScore then

                            bestScore = score
                            bestPart = object
                        end
                    end
                end
            end
        end
    end

    if bestPart then
        return bestPart.Position
    end

    return nil
end

--==================================================
-- FAST MOVE
--==================================================

local function smoothTween(targetPosition)

    if not HRP then
        return false
    end

    cancelTween()

    local startPosition =
        HRP.Position

    local distance =
        (
            targetPosition
            - startPosition
        ).Magnitude

    -- Very close = instant
    if distance <= S.MaxDistance then

        HRP.CFrame =
            CFrame.new(
                targetPosition
            )

        setCollision(true)

        return true
    end

    setCollision(false)

    State.tweening = true

    local duration =
        math.clamp(
            distance / S.TweenSpeed,
            S.MinDuration,
            S.MaxDuration
        )

    currentTween =
        TweenService:Create(
            HRP,

            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),

            {
                CFrame =
                    CFrame.new(
                        targetPosition
                    )
            }
        )

    currentTween:Play()

    local completed = false

    local connection

    connection =
        currentTween.Completed:Connect(
            function()
                completed = true
            end
        )

    while not completed do

        if not State.farming then

            connection:Disconnect()

            cancelTween()
            setCollision(true)

            return false
        end

        task.wait()
    end

    connection:Disconnect()

    currentTween = nil
    State.tweening = false

    setCollision(true)

    return true
end

--==================================================
-- TAKE PHOTO
--==================================================

local function takePhoto(targetPosition)

    if not phoneScreenPush
        or not photoJobSubmit
        or not HRP then

        return false
    end

    local bufferData =
        buffer.create(7)

    buffer.writeu8(
        bufferData,
        0,
        1
    )

    buffer.writeu8(
        bufferData,
        1,
        4
    )

    buffer.writeu8(
        bufferData,
        2,
        0
    )

    buffer.writeu8(
        bufferData,
        3,
        1
    )

    buffer.writeu8(
        bufferData,
        4,
        1
    )

    buffer.writeu8(
        bufferData,
        5,
        42
    )

    buffer.writeu8(
        bufferData,
        6,
        24
    )

    -- Phone
    local pushSuccess =
        pcall(
            phoneScreenPush.FireServer,
            phoneScreenPush,
            bufferData
        )

    if not pushSuccess then
        return false
    end

    task.wait(0.15)

    local lookAt =
        targetPosition
        or (
            HRP.Position
            + HRP.CFrame.LookVector
            * 10
        )

    -- Submit
    local submitSuccess =
        pcall(
            photoJobSubmit.InvokeServer,
            photoJobSubmit,
            "Submit",
            CFrame.new(
                HRP.Position,
                lookAt
            )
        )

    task.wait(0.15)

    return submitSuccess
end

--==================================================
-- PROCESS ONE TASK
--==================================================

local function processTask()

    if not State.farming then
        return
    end

    if State.processing
        or State.restarting then

        return
    end

    local taskText =
        getTaskText()

    -- No assignment
    if not taskText
        or taskText == "" then

        return
    end

    local lower =
        taskText:lower()

    -- Waiting
    if lower:find(
        "waiting for assignment",
        1,
        true
    ) then

        return
    end

    --==============================================
    -- MUSIC ROOM = IMMEDIATE REROLL
    --==============================================

    if isRejectedTask(taskText) then

        State.stopReason =
            "Music Room rejected: "
            .. tostring(taskText)

        restartUntilValidTask()

        return
    end

    --==============================================
    -- WHITELIST
    --==============================================

    local area =
        resolveArea(taskText)

    if not area then

        State.stopReason =
            "Invalid task: "
            .. tostring(taskText)

        restartUntilValidTask()

        return
    end

    --==============================================
    -- DUPLICATE CHECK
    --==============================================

    if taskText == State.lastTask then
        return
    end

    State.processing = true
    State.lastTask = taskText
    State.taskCount += 1

    --==============================================
    -- FIND LOCATION
    --==============================================

    local position =
        findLocation(taskText)

    if not position then

        State.processing = false
        State.lastTask = ""

        return
    end

    --==============================================
    -- MOVE
    --==============================================

    local moved =
        smoothTween(position)

    if not moved then

        State.processing = false

        return
    end

    if not State.farming then

        State.processing = false

        return
    end

    task.wait(0.2)

    --==============================================
    -- PHOTO
    --==============================================

    takePhoto(position)

    setCollision(true)

    State.tweening = false
    State.processing = false

    task.wait(0.5)

    State.lastTask = ""
end

--==================================================
-- FARM LOOP
--==================================================

local function farmLoop()

    while State.farming do

        pcall(function()
            processTask()
        end)

        task.wait(
            S.RefreshRate
        )
    end

    setCollision(true)
end

