-- REAL PLAYER
--==================================================

local function getRealPlayerFromModel(model)

    if not model then
        return nil
    end

    local player =
        Players:GetPlayerFromCharacter(
            model
        )

    if player then
        return player
    end

    local modelName =
        tostring(
            model.Name
        ):lower()

    for _, candidate in ipairs(
        Players:GetPlayers()
    ) do

        if candidate.Name:lower()
            == modelName then

            return candidate
        end

    end

    return nil
end

--==================================================
-- FIND PLAYER
--==================================================

local function findPlayerByInfo(targetText)

    if not targetText then
        return nil, nil, nil
    end

    local target =
        normalizePlayerName(
            targetText
        )

    if target == "" then
        return nil, nil, nil
    end

    local targetLower =
        target:lower()

    --==================================================
    -- PASS 1
    --==================================================

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            local character =
                player.Character

            if character then

                local info =
                    character:FindFirstChild(
                        "Info",
                        true
                    )

                if info
                    and info:IsA(
                        "TextLabel"
                    ) then

                    if infoMatchesTarget(
                        info.Text,
                        target,
                        player
                    ) then

                        local playerHRP =
                            character:FindFirstChild(
                                "HumanoidRootPart"
                            )

                        if playerHRP then

                            return player,
                                character,
                                playerHRP.Position

                        end
                    end
                end
            end
        end
    end

    --==================================================
    -- PASS 2
    --==================================================

    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do

        if object:IsA("TextLabel")
            and object.Name == "Info" then

            local infoText =
                tostring(
                    object.Text or ""
                )

            if infoText ~= "" then

                local model =
                    findModelFromInfo(
                        object
                    )

                if model then

                    local player =
                        getRealPlayerFromModel(
                            model
                        )

                    if player
                        and player ~= LocalPlayer then

                        if infoMatchesTarget(
                            infoText,
                            target,
                            player
                        ) then

                            local playerHRP =
                                model:FindFirstChild(
                                    "HumanoidRootPart"
                                )

                            if playerHRP then

                                return player,
                                    model,
                                    playerHRP.Position

                            end
                        end
                    end
                end
            end
        end
    end

    --==================================================
    -- PASS 3
    --==================================================

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            if player.Name:lower()
                == targetLower
                or player.DisplayName:lower()
                == targetLower then

                local character =
                    player.Character

                if character then

                    local playerHRP =
                        character:FindFirstChild(
                            "HumanoidRootPart"
                        )

                    if playerHRP then

                        return player,
                            character,
                            playerHRP.Position

                    end
                end
            end
        end
    end

    return nil, nil, nil
end

--==================================================
-- RESOLVE AREA
--==================================================

local function resolveArea(taskText)

    local normalized =
        normalizeText(
            taskText
        )

    if normalized == "" then
        return nil
    end

    for _, entry in ipairs(
        AREA_TASKS
    ) do

        local canonical =
            entry.canonical:lower()

        if normalized == canonical then
            return entry.canonical
        end

        if normalized:find(
            canonical,
            1,
            true
        ) then

            return entry.canonical
        end

        for _, alias in ipairs(
            entry.aliases
        ) do

            alias =
                alias:lower()

            if normalized == alias then
                return entry.canonical
            end

            if normalized:find(
                alias,
                1,
                true
            ) then

                return entry.canonical
            end
        end
    end

    return nil
end

