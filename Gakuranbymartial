--==================================================
-- PHOTO PREFIXES
--==================================================

local PHOTO_PREFIXES = {

    "get a photo of ",
    "take a photo of ",
    "take photo of ",
    "a photo of ",
    "photo of ",
    "photograph of ",
    "photograph ",
    "get a picture of ",
    "take a picture of ",
    "take picture of ",
    "picture of ",
}

local function getPhotoTargetText(taskText)

    if not taskText then
        return nil
    end

    local text =
        tostring(taskText)

    local lower =
        text:lower()

    for _, prefix in ipairs(
        PHOTO_PREFIXES
    ) do

        if lower:sub(
            1,
            #prefix
        ) == prefix then

            local target =
                text:sub(
                    #prefix + 1
                )

            target =
                normalizePlayerName(
                    target
                )

            if target ~= "" then
                return target
            end
        end
    end

    return nil
end

--==================================================
-- FIND MODEL FROM INFO
--==================================================

local function findModelFromInfo(info)

    if not info then
        return nil
    end

    local current =
        info.Parent

    while current do

        if current:IsA("Model") then
            return current
        end

        current =
            current.Parent
    end

    return nil
end

--==================================================
-- INFO MATCH
--==================================================

local function infoMatchesTarget(
    infoText,
    targetText,
    player
)

    if not infoText
        or not targetText then

        return false
    end

    local info =
        tostring(
            infoText
        ):lower()

    local target =
        tostring(
            targetText
        ):lower()

    if info == target then
        return true
    end

    if info:find(
        target,
        1,
        true
    ) then

        return true
    end

    if player then

        local username =
            player.Name:lower()

        local displayName =
            player.DisplayName:lower()

        if info:find(
            username,
            1,
            true
        ) then

            return true
        end

        if info:find(
            displayName,
            1,
            true
        ) then

            return true
        end
    end

    return false
end

