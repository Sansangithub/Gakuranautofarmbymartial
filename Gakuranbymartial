--==================================================

local function normalizePlayerName(text)
    if not text then
        return ""
    end

    text = tostring(text)
    text = text:match("^%s*(.-)%s*$")
    text = text:gsub("[%,!?:;]+$", "")

    return text
end

local function normalizeText(text)
    if not text then
        return ""
    end

    text = tostring(text):lower()

    local prefixes = {
        "get a photo of ",
        "take a photo of ",
        "take photo of ",
        "a photo of ",
        "photo of ",
        "photograph of ",
        "photograph ",
        "get a picture of ",
        "take a picture of ",
        "take picture of ",
        "picture of "
    }

    for _, prefix in ipairs(prefixes) do
        if text:sub(1, #prefix) == prefix then
            text = text:sub(#prefix + 1)
            break
        end
    end

    if text:sub(1, 4) == "the " then
        text = text:sub(5)
    end

    return text:match("^%s*(.-)%s*$")
end

--==================================================
-- CHAT
--==================================================

local function setChatStatus(text, success)
    if not ChatStatus then
        return
    end

    ChatStatus.Text = text or ""

    if success == true then
        ChatStatus.TextColor3 = Color3.fromRGB(80,255,120)
    elseif success == false then
        ChatStatus.TextColor3 = Color3.fromRGB(255,90,90)
    else
        ChatStatus.TextColor3 = Color3.fromRGB(200,200,200)
    end
end

local function sendChatMessage(message)
    if not message then
        return false
    end

    message = tostring(message):match("^%s*(.-)%s*$")

    if message == "" or State.chatSending then
        return false
    end

    State.chatSending = true
    State.lastChatMessage = message

    local sent = false

    if TextChatService.ChatVersion ==
        Enum.ChatVersion.TextChatService then

        local channels =
            TextChatService:FindFirstChild("TextChannels")

        if channels then
            local general =
                channels:FindFirstChild("RBXGeneral")

            if general and general:IsA("TextChannel") then
                local ok = pcall(function()
                    general:SendAsync(message)
                end)

                if ok then
                    sent = true
                end
            end
        end
    end

    if not sent then
        local chatEvents =
            ReplicatedStorage:FindFirstChild(
                "DefaultChatSystemChatEvents"
            )

        if chatEvents then
            local request =
                chatEvents:FindFirstChild(
                    "SayMessageRequest"
                )

            if request then
                local ok = pcall(function()
                    request:FireServer(
                        message,
                        "All"
                    )
                end)

                if ok then
                    sent = true
                end
            end
        end
    end

    State.chatSending = false

    if sent then
        setChatStatus(
            "CHAT SENT: " .. message,
            true
        )
    else
        setChatStatus(
            "CHAT FAILED",
            false
        )
    end

    return sent
end

