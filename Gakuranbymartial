						onePlayerServer = server
						break
					elseif playing == 2 and playing < maxPlayers and not twoPlayerServer then
						twoPlayerServer = server
					end
				end
			end

			if onePlayerServer then
				break
			end

			cursor = type(page.nextPageCursor) == "string" and page.nextPageCursor or ""
			if cursor == "" then
				break
			end
			task.wait(0.1)
		end

		local chosen = onePlayerServer or twoPlayerServer
		if chosen then
			local count = tonumber(chosen.playing) or 0
			setChatStatus("TELEPORT KE SERVER (" .. tostring(count) .. "P)...", true)
			local ok, err = pcall(function()
				TeleportService:TeleportToPlaceInstance(placeId, chosen.id, LocalPlayer)
			end)
			if not ok then
				setChatStatus("TELEPORT GAGAL: " .. tostring(err), false)
			end
		else
			setChatStatus("SERVER 1-2 PLAYER TIDAK DITEMUKAN", false)
		end

		HopState.searching = false
		if HopServerButton then
			HopServerButton.Text = "HOP 1-2P"
			HopServerButton.BackgroundColor3 = Color3.fromRGB(55, 120, 200)
		end
	end)
end

